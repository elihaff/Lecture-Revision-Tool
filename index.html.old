<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Medical Lecture Study Assistant | Notes & Anki Cards [v2.72]</title>
  <meta name="description" content="Generate concise study notes and Anki flashcards from your medical lecture slides">
  <link rel="icon" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><text y='.9em' font-size='90'>🧠</text></svg>">
  <script src="https://cdn.tailwindcss.com"></script>
  <script src="https://unpkg.com/react@18/umd/react.production.min.js"></script>
  <script src="https://unpkg.com/react-dom@18/umd/react-dom.production.min.js"></script>
  <script src="https://unpkg.com/@babel/standalone/babel.min.js"></script>
  <script src="https://unpkg.com/lucide@latest/dist/umd/lucide.min.js"></script>
  <script src="https://unpkg.com/docx@8.5.0/build/index.umd.js"></script>
  <script src="https://unpkg.com/file-saver@2.0.5/dist/FileSaver.min.js"></script>
  <script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/pdfmake@0.1.72/build/pdfmake.min.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/pdfmake@0.1.72/build/vfs_fonts.min.js"></script>
  <script src="https://cdnjs.cloudflare.com/ajax/libs/pdf.js/3.11.174/pdf.min.js"></script>
  <script src="custom-fonts.js"></script>
  <style>
    body { margin: 0; height: 100vh; }
    #root { height: 100%; }

    /* ContentEditable placeholder */
    [contenteditable][data-placeholder]:empty:before {
      content: attr(data-placeholder);
      color: #94a3b8;
      font-style: italic;
    }

    /* Style for contentEditable editor */
    [contenteditable] {
      outline: none;
    }

    [contenteditable] ul {
      margin-left: 20px;
      list-style-type: disc;
    }

    [contenteditable] ul ul {
      margin-left: 20px;
      list-style-type: circle;
    }

    [contenteditable] ul ul ul {
      list-style-type: square;
    }

    /* Style for notes display (not editing) */
    .notes-display ul {
      margin-left: 20px;
      list-style-type: disc;
      margin-top: 0.5em;
      margin-bottom: 0.5em;
    }

    .notes-display ul ul {
      margin-left: 20px;
      list-style-type: circle;
    }

    .notes-display ul ul ul {
      list-style-type: square;
    }

    .notes-display li {
      margin: 0.25em 0;
    }

    /* Drag and drop styles */
    .cursor-move {
      cursor: move !important;
      cursor: grab !important;
    }
    .cursor-move:active {
      cursor: grabbing !important;
    }

    /* Prevent text selection on drag handles only (fixes Safari) */
    .cursor-move[draggable="true"] {
      -webkit-user-select: none;
      -khtml-user-select: none;
      -moz-user-select: none;
      -ms-user-select: none;
      user-select: none;
    }

    /* Drop target indicator */
    .drop-target-indicator {
      position: relative;
    }
    .drop-target-indicator::before {
      content: '';
      position: absolute;
      top: -2px;
      left: 0;
      right: 0;
      height: 3px;
      background: #6366f1;
      border-radius: 2px;
      box-shadow: 0 0 8px rgba(99, 102, 241, 0.6);
    }
  </style>
</head>
<body>
  <div id="root"></div>
  <script type="text/babel">
    const { useState, useRef, useEffect, Component } = React;

    // Error boundary to catch rendering crashes
    class ErrorBoundary extends Component {
      constructor(props) {
        super(props);
        this.state = { hasError: false, error: null };
      }
      static getDerivedStateFromError(error) {
        return { hasError: true, error };
      }
      componentDidCatch(error, info) {
        console.error('React error:', error, info);
      }
      render() {
        if (this.state.hasError) {
          return (
            <div className="p-4 bg-red-900/30 border border-red-700 rounded-xl m-4">
              <h3 className="text-red-400 font-semibold mb-2">Something went wrong</h3>
              <p className="text-sm text-slate-300 mb-3">{this.state.error?.message || 'Unknown error'}</p>
              <button onClick={() => this.setState({ hasError: false, error: null })} className="px-3 py-1.5 bg-red-600 hover:bg-red-500 rounded-lg text-sm">Try Again</button>
            </div>
          );
        }
        return this.props.children;
      }
    }

    const Icon = ({ name, className }) => {
      const containerRef = useRef(null);
      useEffect(() => {
        if (containerRef.current) {
          // Create a fresh icon element each time
          containerRef.current.innerHTML = `<i data-lucide="${name}" class="${className || ''}"></i>`;
          lucide.createIcons({ nodes: [containerRef.current.firstChild] });
        }
      }, [name, className]);
      return <span ref={containerRef} style={{ display: 'inline-flex' }}></span>;
    };

    function App() {
      const [file, setFile] = useState(null);
      const [fileData, setFileData] = useState(null);
      const [processing, setProcessing] = useState(false);
      const [processingType, setProcessingType] = useState('');
      const [notes, setNotes] = useState(null);
      const [cards, setCards] = useState([]);
      const [activeTab, setActiveTab] = useState('upload');
      const [chatMessages, setChatMessages] = useState([{ role: 'assistant', content: "Hi! I'm your lecture study assistant. Upload your lecture slides (PDF) and I'll help you create:\n\n• Concise, exam-ready notes\n• Anki flashcards\n\n⚙️ First, add your Anthropic API key in Settings (click the gear icon)." }]);
      const [expandedCards, setExpandedCards] = useState({});
      const [copied, setCopied] = useState(false);
      const [lectureTag, setLectureTag] = useState('');
      const [moduleAbbrev, setModuleAbbrev] = useState('');
      const [importModuleAbbrev, setImportModuleAbbrev] = useState('');
      const [showCsvImportModal, setShowCsvImportModal] = useState(false);
      const [csvImportModule, setCsvImportModule] = useState('');
      const [csvImportLectureTitle, setCsvImportLectureTitle] = useState('');
      const [csvImportCustomTag, setCsvImportCustomTag] = useState('');
      const [pendingCsvFile, setPendingCsvFile] = useState(null);
      const [apiKey, setApiKey] = useState('');
      const modules = [
        { name: 'Cardiorespiratory', abbrev: 'CR2' },
        { name: 'Metabolism', abbrev: 'MET2' },
        { name: 'Human Development', abbrev: 'HD2' },
        { name: 'Brain & Behaviour', abbrev: 'BB2' },
        { name: 'Cancer', abbrev: 'CA2' },
        { name: 'Human Sciences & Public Health', abbrev: 'PH2' },
        { name: 'Locomotor', abbrev: 'LOC2' },
        { name: 'SSC2c', abbrev: 'SSC2c' }
      ];
      const [showSettings, setShowSettings] = useState(false);
      const [keyVisible, setKeyVisible] = useState(false);
      const [modifyRequest, setModifyRequest] = useState('');
      const [modifying, setModifying] = useState(false);
      const [userLearningObjectives, setUserLearningObjectives] = useState('');
      const [customInstructions, setCustomInstructions] = useState('');
      const [editingCard, setEditingCard] = useState(null); // {index, front, back}
      const [showAddCard, setShowAddCard] = useState(false);
      const [newCard, setNewCard] = useState({ front: '', back: '' });
      const [editingNote, setEditingNote] = useState(null); // {sectionIndex, pointIndex, value} or {type: 'section', sectionIndex, value} or {type: 'lo', index, value}
      const [draggedPoint, setDraggedPoint] = useState(null); // {sectionIndex, pointIndex}
      const [draggedSection, setDraggedSection] = useState(null); // sectionIndex
      const [dropTargetPoint, setDropTargetPoint] = useState(null); // {sectionIndex, pointIndex}
      const [dropTargetSection, setDropTargetSection] = useState(null); // sectionIndex
      const fileInputRef = useRef(null);
      const pdfImportInputRef = useRef(null);
      const csvImportInputRef = useRef(null);
      const textareaRef = useRef(null);
      const cardTextareaRef = useRef(null);
      const isFormattingRef = useRef(false); // Flag to prevent ref callback interference during formatting
      const [activeFormatting, setActiveFormatting] = useState({ superscript: false, subscript: false }); // Track active formatting modes
      const [pdfThumbnails, setPdfThumbnails] = useState([]); // Store PDF page thumbnails for image insertion
      const [thumbnailsLoading, setThumbnailsLoading] = useState(false); // Track thumbnail generation progress
      const [imagePickerOpen, setImagePickerOpen] = useState(null); // {sectionIndex, pointIndex} when open
      const [imageSearchQuery, setImageSearchQuery] = useState(''); // Search query for filtering slides
      const [pointImages, setPointImages] = useState({}); // Store images by "sectionIndex-pointIndex" key
      const [sectionImages, setSectionImages] = useState({}); // Store images by sectionIndex key
      const [imageReferences, setImageReferences] = useState({}); // Store references: { "sectionIndex-pointIndex": "primarySectionIndex-primaryPointIndex" }
      const [imagePickerTab, setImagePickerTab] = useState('slides'); // 'slides' | 'notes'
      const [slidePreviewIndex, setSlidePreviewIndex] = useState(null); // Index in filteredThumbnails for large preview mode
      const [expandedImages, setExpandedImages] = useState({}); // Track which images are expanded in editor view
      const [cropModalOpen, setCropModalOpen] = useState(null); // {sectionIndex, pointIndex, imageData, pageNum}
      const [cropArea, setCropArea] = useState(null); // {x, y, width, height} relative to image
      const [isDraggingCrop, setIsDraggingCrop] = useState(false);
      const [cropDragStart, setCropDragStart] = useState(null);
      const cropCanvasRef = useRef(null);
      const [annotations, setAnnotations] = useState([]); // [{type: 'circle'|'arrow'|'draw'|'text', points, color, text?}]
      const [currentTool, setCurrentTool] = useState('crop'); // 'crop' | 'draw' | 'circle' | 'arrow' | 'text'
      const [annotationColor, setAnnotationColor] = useState('#ef4444'); // red-500
      const [textFontSize, setTextFontSize] = useState(14); // Default font size for text annotations
      const [isDrawing, setIsDrawing] = useState(false);
      const [currentPath, setCurrentPath] = useState([]);
      const [textInput, setTextInput] = useState({ visible: false, x: 0, y: 0, value: '' });
      const [draggingTextIndex, setDraggingTextIndex] = useState(null);
      const [dragOffset, setDragOffset] = useState({ x: 0, y: 0 });
      const [hoveredTextIndex, setHoveredTextIndex] = useState(null);
      const [hoveredArrowIndex, setHoveredArrowIndex] = useState(null);
      const [resizingTextIndex, setResizingTextIndex] = useState(null); // Track which text is being resized
      const [resizeStartFontSize, setResizeStartFontSize] = useState(null); // Starting font size when resizing
      const [resizeStartY, setResizeStartY] = useState(null); // Starting Y position when resizing
      const textSubmittedRef = React.useRef(false); // Track if text was submitted via Enter

      // Image occlusion card states
      const [occlusionModalOpen, setOcclusionModalOpen] = useState(false);
      const [occlusionStep, setOcclusionStep] = useState('select'); // 'select' | 'detect' | 'edit' | 'generate'
      const [selectedOcclusionImage, setSelectedOcclusionImage] = useState(null);
      const [detectedLabels, setDetectedLabels] = useState([]); // [{id, x, y, width, height, text, enabled}]
      const [occlusionProcessing, setOcclusionProcessing] = useState(false);
      const [drawingOcclusionBox, setDrawingOcclusionBox] = useState(null); // {startX, startY}
      const [editingLabelId, setEditingLabelId] = useState(null);
      const [draggingLabel, setDraggingLabel] = useState(null); // {id, offsetX, offsetY}
      const [resizingLabel, setResizingLabel] = useState(null); // {id, handle: 'nw'|'ne'|'sw'|'se', startX, startY, origBox}

      // Occlusion card edit modal state
      const [editingOcclusionCard, setEditingOcclusionCard] = useState(null); // {index, originalImage, label, questionText, explanation}
      const [editOcclusionDragging, setEditOcclusionDragging] = useState(null);
      const [editOcclusionResizing, setEditOcclusionResizing] = useState(null);

      // Interpretation card modal state
      const [interpretationModalOpen, setInterpretationModalOpen] = useState(false);
      const [interpretationStep, setInterpretationStep] = useState('select'); // 'select' | 'generating' | 'confirm'
      const [selectedInterpretationImage, setSelectedInterpretationImage] = useState(null);
      const [interpretationCard, setInterpretationCard] = useState(null); // {question, answer, imageDataUrl}
      const [interpretationProcessing, setInterpretationProcessing] = useState(false);

      // Interpretation card edit modal state
      const [editingInterpretationCard, setEditingInterpretationCard] = useState(null); // {index, question, answer, imageDataUrl}

      // Initialize PDF.js worker
      if (typeof pdfjsLib !== 'undefined') {
        pdfjsLib.GlobalWorkerOptions.workerSrc = 'https://cdnjs.cloudflare.com/ajax/libs/pdf.js/3.11.174/pdf.worker.min.js';
      }

      useEffect(() => {
        const saved = localStorage.getItem('anthropic_api_key');
        if (saved) setApiKey(saved);
      }, []);

      // Keyboard navigation for slide preview in image picker
      useEffect(() => {
        if (!imagePickerOpen || imagePickerTab !== 'slides') return;

        const handleKeyDown = (e) => {
          // Don't handle if user is typing in search box
          if (e.target.tagName === 'INPUT') return;

          const totalSlides = pdfThumbnails.length;
          if (totalSlides === 0) return;

          if (e.key === 'ArrowLeft' || e.key === 'ArrowUp') {
            e.preventDefault();
            setSlidePreviewIndex(prev => {
              if (prev === null) return totalSlides - 1;
              return Math.max(0, prev - 1);
            });
          } else if (e.key === 'ArrowRight' || e.key === 'ArrowDown') {
            e.preventDefault();
            setSlidePreviewIndex(prev => {
              if (prev === null) return 0;
              return Math.min(totalSlides - 1, prev + 1);
            });
          }
        };

        window.addEventListener('keydown', handleKeyDown);
        return () => window.removeEventListener('keydown', handleKeyDown);
      }, [imagePickerOpen, imagePickerTab, pdfThumbnails.length]);

      // Debug: Log notes state changes
      useEffect(() => {
        if (notes) {
          console.log('\n===== NOTES STATE IN REACT =====');
          console.log('Title:', notes.title);
          console.log('Learning Objectives:', notes.learningObjectives?.length || 0);
          console.log('Sections:', notes.notes?.length || 0);
          if (notes.notes) {
            notes.notes.forEach((section, i) => {
              console.log(`  Section ${i + 1}: "${section.section}" (${section.points?.length || 0} points)`);
              if (section.points) {
                section.points.slice(0, 3).forEach((point, j) => {
                  console.log(`    Point ${j + 1}: "${point.substring(0, 80)}..."`);
                });
                if (section.points.length > 3) {
                  console.log(`    ... and ${section.points.length - 3} more points`);
                }
              }
            });
          }
          console.log('===== END NOTES STATE =====\n');
        }
      }, [notes]);

      const saveApiKey = (key) => { setApiKey(key); if (key) localStorage.setItem('anthropic_api_key', key); else localStorage.removeItem('anthropic_api_key'); };

      const readFile = async (file) => {
        const arrayBuffer = await file.arrayBuffer();
        const base64 = btoa(new Uint8Array(arrayBuffer).reduce((data, byte) => data + String.fromCharCode(byte), ''));
        return { type: 'pdf', data: base64 };
      };

      // Generate thumbnails from PDF pages for image insertion feature
      const generatePdfThumbnails = async (file) => {
        try {
          setThumbnailsLoading(true);
          const arrayBuffer = await file.arrayBuffer();
          const pdf = await pdfjsLib.getDocument({ data: arrayBuffer }).promise;
          const thumbnails = [];

          for (let pageNum = 1; pageNum <= pdf.numPages; pageNum++) {
            const page = await pdf.getPage(pageNum);

            // Get text content for search functionality
            const textContent = await page.getTextContent();
            const pageText = textContent.items.map(item => item.str).join(' ').toLowerCase();

            // Calculate text density (for sorting visual-heavy slides first)
            const textLength = pageText.replace(/\s/g, '').length;

            // Render page to canvas at thumbnail size (~200px width)
            const viewport = page.getViewport({ scale: 0.3 });
            const canvas = document.createElement('canvas');
            canvas.width = viewport.width;
            canvas.height = viewport.height;
            const ctx = canvas.getContext('2d');

            await page.render({ canvasContext: ctx, viewport: viewport }).promise;

            thumbnails.push({
              pageNum: pageNum,
              dataUrl: canvas.toDataURL('image/jpeg', 0.7),
              text: pageText,
              textDensity: textLength, // Lower = more visual content
              width: viewport.width,
              height: viewport.height
            });
          }

          setPdfThumbnails(thumbnails);
          console.log(`Generated ${thumbnails.length} PDF thumbnails`);
          return thumbnails;
        } catch (error) {
          console.error('Error generating PDF thumbnails:', error);
          return [];
        } finally {
          setThumbnailsLoading(false);
        }
      };

      // Helper functions for managing point images
      const getPointImageKey = (sectionIndex, pointIndex) => `${sectionIndex}-${pointIndex}`;

      const getPointImage = (sectionIndex, pointIndex) => {
        return pointImages[getPointImageKey(sectionIndex, pointIndex)] || null;
      };

      const setPointImage = (sectionIndex, pointIndex, imageData) => {
        setPointImages(prev => ({
          ...prev,
          [getPointImageKey(sectionIndex, pointIndex)]: imageData
        }));
      };

      const removePointImage = (sectionIndex, pointIndex) => {
        const primaryKey = getPointImageKey(sectionIndex, pointIndex);

        // Remove all references to this image
        setImageReferences(prev => {
          const newRefs = { ...prev };
          Object.keys(newRefs).forEach(key => {
            if (newRefs[key] === primaryKey) {
              delete newRefs[key];
            }
          });
          return newRefs;
        });

        // Remove the image itself
        setPointImages(prev => {
          const newImages = { ...prev };
          delete newImages[primaryKey];
          return newImages;
        });
      };

      // Helper functions for image references (multiple bullets referencing same image)
      const getImageReference = (sectionIndex, pointIndex) => {
        return imageReferences[getPointImageKey(sectionIndex, pointIndex)] || null;
      };

      const setImageReference = (sectionIndex, pointIndex, primaryKey) => {
        setImageReferences(prev => ({
          ...prev,
          [getPointImageKey(sectionIndex, pointIndex)]: primaryKey
        }));
      };

      const removeImageReference = (sectionIndex, pointIndex) => {
        setImageReferences(prev => {
          const newRefs = { ...prev };
          delete newRefs[getPointImageKey(sectionIndex, pointIndex)];
          return newRefs;
        });
      };

      // Get image for a point (either primary or referenced)
      const getPointImageOrRef = (sectionIndex, pointIndex) => {
        const direct = getPointImage(sectionIndex, pointIndex);
        if (direct) return { image: direct, isPrimary: true };

        const refKey = getImageReference(sectionIndex, pointIndex);
        if (refKey) {
          const [refSection, refPoint] = refKey.split('-').map(Number);
          const refImage = getPointImage(refSection, refPoint);
          if (refImage) return { image: refImage, isPrimary: false, refKey };
        }
        return null;
      };

      // Get all points that reference a given primary image
      const getReferencesToImage = (sectionIndex, pointIndex) => {
        const primaryKey = getPointImageKey(sectionIndex, pointIndex);
        return Object.entries(imageReferences)
          .filter(([_, refKey]) => refKey === primaryKey)
          .map(([pointKey]) => pointKey);
      };

      // Helper functions for section-level images
      const getSectionImage = (sectionIndex) => {
        return sectionImages[sectionIndex] || null;
      };

      const setSectionImage = (sectionIndex, imageData) => {
        setSectionImages(prev => ({
          ...prev,
          [sectionIndex]: imageData
        }));
      };

      const removeSectionImage = (sectionIndex) => {
        setSectionImages(prev => {
          const newImages = { ...prev };
          delete newImages[sectionIndex];
          return newImages;
        });
      };

      // Helper to get figure number for a point or section image
      // Figures are numbered top-to-bottom: section title image first, then point images in order
      const getFigureNumber = (targetSectionIndex, targetPointIndex = null, targetType = 'point') => {
        if (!notes || !notes.notes) return null;

        let figNum = 0;
        for (let sIdx = 0; sIdx < notes.notes.length; sIdx++) {
          const section = notes.notes[sIdx];

          // Section title image comes first (at the top of the section)
          if (getSectionImage(sIdx)) {
            figNum++;
            if (targetType === 'section' && sIdx === targetSectionIndex) {
              return figNum;
            }
          }

          // Then count point images in this section
          if (section.points) {
            for (let pIdx = 0; pIdx < section.points.length; pIdx++) {
              if (getPointImage(sIdx, pIdx)) {
                figNum++;
                if (targetType === 'point' && sIdx === targetSectionIndex && pIdx === targetPointIndex) {
                  return figNum;
                }
              }
            }
          }
        }
        return null;
      };

      // Extract keywords from text (remove common words, get significant terms)
      const extractKeywords = (text) => {
        if (!text) return [];
        // Remove HTML tags and clean text
        const cleanText = text.replace(/<[^>]*>/g, ' ').toLowerCase();
        // Split into words
        const words = cleanText.split(/[\s,.\-:;()\[\]{}'"?!]+/).filter(w => w.length > 2);
        // Remove very common words
        const stopWords = new Set(['the', 'and', 'for', 'are', 'but', 'not', 'you', 'all', 'can', 'has', 'her', 'was', 'one', 'our', 'out', 'his', 'have', 'from', 'they', 'been', 'have', 'many', 'some', 'them', 'these', 'would', 'other', 'into', 'more', 'also', 'than', 'very', 'just', 'which', 'what', 'when', 'where', 'with', 'this', 'that', 'will', 'each', 'about', 'how', 'their', 'there', 'then', 'your']);
        return words.filter(w => !stopWords.has(w) && w.length > 2);
      };

      // Calculate match score between card text and note text
      const calculateMatchScore = (cardKeywords, noteText) => {
        if (!noteText || cardKeywords.length === 0) return 0;
        const noteKeywords = new Set(extractKeywords(noteText));
        let matches = 0;
        for (const keyword of cardKeywords) {
          if (noteKeywords.has(keyword)) matches++;
        }
        // Return percentage of card keywords found in note
        return matches / cardKeywords.length;
      };

      // Get available images for a flashcard using text matching
      const getAvailableImagesForCard = (card) => {
        if (!notes?.notes) return [];

        // Extract keywords from both front and back of card
        const cardText = (card.front || '') + ' ' + (card.back || '');
        const cardKeywords = extractKeywords(cardText);
        if (cardKeywords.length === 0) return [];

        const matches = [];
        const minMatchScore = 0.15; // At least 15% of keywords must match

        // Check each section and its points
        notes.notes.forEach((section, sIdx) => {
          // Check section title
          const sectionScore = calculateMatchScore(cardKeywords, section.section || '');
          const sectionImg = getSectionImage(sIdx);

          if (sectionImg && sectionScore >= minMatchScore) {
            matches.push({
              type: 'section',
              sectionIndex: sIdx,
              pointIndex: null,
              image: sectionImg,
              score: sectionScore,
              label: `${section.section?.substring(0, 30) || 'Section ' + (sIdx + 1)}... (Slide ${sectionImg.pageNum})`
            });
          }

          // Check each point in the section
          if (section.points) {
            section.points.forEach((point, pIdx) => {
              const pointScore = calculateMatchScore(cardKeywords, point || '');
              const pointImg = getPointImage(sIdx, pIdx);

              if (pointImg && pointScore >= minMatchScore) {
                matches.push({
                  type: 'point',
                  sectionIndex: sIdx,
                  pointIndex: pIdx,
                  image: pointImg,
                  score: pointScore,
                  label: `${String(point).substring(0, 30)}... (Slide ${pointImg.pageNum})`
                });
              }
            });
          }
        });

        // Sort by match score (highest first) and return top matches
        return matches.sort((a, b) => b.score - a.score).slice(0, 5);
      };

      // Get all images from notes (for occlusion card generation)
      const getAllNotesImages = () => {
        const images = [];
        if (!notes?.notes) return images;

        notes.notes.forEach((section, sIdx) => {
          // Check section image
          const sectionImg = getSectionImage(sIdx);
          if (sectionImg) {
            images.push({
              type: 'section',
              sectionIndex: sIdx,
              pointIndex: null,
              image: sectionImg,
              label: section.section || `Section ${sIdx + 1}`
            });
          }

          // Check point images
          if (section.points) {
            section.points.forEach((point, pIdx) => {
              const pointImg = getPointImage(sIdx, pIdx);
              if (pointImg) {
                images.push({
                  type: 'point',
                  sectionIndex: sIdx,
                  pointIndex: pIdx,
                  image: pointImg,
                  label: String(point).substring(0, 50) + (point.length > 50 ? '...' : '')
                });
              }
            });
          }
        });

        return images;
      };

      // Generate occlusion cards from user-drawn labels
      const generateOcclusionCards = async () => {
        if (!selectedOcclusionImage || detectedLabels.length === 0) return;

        const enabledLabels = detectedLabels.filter(l => l.enabled);
        if (enabledLabels.length === 0) {
          alert('Please enable at least one label to generate cards.');
          return;
        }

        setOcclusionProcessing(true);

        try {
          // Get explanations for all labels using AI
          const base64Data = selectedOcclusionImage.image.dataUrl.split(',')[1];
          const mediaType = selectedOcclusionImage.image.dataUrl.split(';')[0].split(':')[1] || 'image/jpeg';

          const labelTexts = enabledLabels.map(l => l.text).join(', ');
          const response = await fetch('https://api.anthropic.com/v1/messages', {
            method: 'POST',
            headers: {
              'Content-Type': 'application/json',
              'x-api-key': apiKey,
              'anthropic-version': '2023-06-01',
              'anthropic-dangerous-direct-browser-access': 'true'
            },
            body: JSON.stringify({
              model: 'claude-sonnet-4-20250514',
              max_tokens: 4096,
              messages: [{
                role: 'user',
                content: [
                  {
                    type: 'image',
                    source: {
                      type: 'base64',
                      media_type: mediaType,
                      data: base64Data
                    }
                  },
                  {
                    type: 'text',
                    text: `For each of these labels from the diagram, provide a brief 1-line explanation/description (max 15 words each):

Labels: ${labelTexts}

Return ONLY a JSON object mapping label text to explanation, no other text:
{"Label 1": "Brief explanation", "Label 2": "Brief explanation"}`
                  }
                ]
              }]
            })
          });

          const data = await response.json();
          let explanations = {};
          if (response.ok) {
            const rawText = data.content?.[0]?.text || '';
            const jsonMatch = rawText.match(/\{[\s\S]*\}/);
            if (jsonMatch) {
              explanations = JSON.parse(jsonMatch[0]);
            }
          }

          // Generate cards - one per enabled label
          const newCards = [];
          const tagSource = lectureTag || notes?.title || 'Lecture';
          const lectureWords = tagSource.split(/[\s_\-\.]+/).filter(word => word.length > 0);
          const lectureName = lectureWords.map(word => word.charAt(0).toUpperCase() + word.slice(1)).join('');
          const moduleTag = moduleAbbrev ? `${moduleAbbrev}_${lectureName}` : lectureName;

          for (const label of enabledLabels) {
            // Create masked version of image
            const maskedDataUrl = await createMaskedImage(selectedOcclusionImage.image.dataUrl, label);

            // Get explanation for this label
            const explanation = explanations[label.text] || `Identify: ${label.text}`;

            newCards.push({
              front: `<img src="${maskedDataUrl}" style="max-width:400px;"><br><br>What is the masked structure?`,
              back: `<b>${label.text}</b><br><br>${explanation}<br><br><img src="${selectedOcclusionImage.image.dataUrl}" style="max-width:300px;">`,
              tags: `Day2 ${moduleTag} ImageOcclusion`,
              image: null,
              // Store occlusion metadata for editing
              occlusionData: {
                originalImage: selectedOcclusionImage.image.dataUrl,
                label: { x: label.x, y: label.y, width: label.width, height: label.height, text: label.text },
                questionText: 'What is the masked structure?',
                explanation: explanation
              }
            });
          }

          // Add new cards to existing cards
          setCards(prev => [...prev, ...newCards]);

          // Close modal and show success
          setOcclusionModalOpen(false);
          setOcclusionStep('select');
          setSelectedOcclusionImage(null);
          setDetectedLabels([]);

          setChatMessages(prev => [...prev, {
            role: 'assistant',
            content: `✅ Generated ${newCards.length} image occlusion cards!\n\nGo to the Cards tab to review and export.`
          }]);

        } catch (error) {
          console.error('Error generating occlusion cards:', error);
          alert('Failed to generate cards: ' + error.message);
        } finally {
          setOcclusionProcessing(false);
        }
      };

      // Generate interpretation card from selected image
      const generateInterpretationCard = async () => {
        if (!selectedInterpretationImage || !apiKey) return;

        setInterpretationProcessing(true);
        setInterpretationStep('generating');

        try {
          const base64Data = selectedInterpretationImage.image.dataUrl.split(',')[1];
          const mediaType = selectedInterpretationImage.image.dataUrl.split(';')[0].split(':')[1] || 'image/jpeg';

          // Get context from the notes that the image references
          let contextText = '';
          if (selectedInterpretationImage.type === 'section' && notes?.notes?.[selectedInterpretationImage.sectionIndex]) {
            const section = notes.notes[selectedInterpretationImage.sectionIndex];
            contextText = `Section: ${section.section}\nPoints:\n${(section.points || []).join('\n')}`;
          } else if (selectedInterpretationImage.type === 'point' && notes?.notes?.[selectedInterpretationImage.sectionIndex]) {
            const section = notes.notes[selectedInterpretationImage.sectionIndex];
            const point = section.points?.[selectedInterpretationImage.pointIndex] || '';
            contextText = `Section: ${section.section}\nRelated point: ${point}`;
          }

          const response = await fetch('https://api.anthropic.com/v1/messages', {
            method: 'POST',
            headers: {
              'Content-Type': 'application/json',
              'x-api-key': apiKey,
              'anthropic-version': '2023-06-01',
              'anthropic-dangerous-direct-browser-access': 'true'
            },
            body: JSON.stringify({
              model: 'claude-sonnet-4-20250514',
              max_tokens: 1024,
              messages: [{
                role: 'user',
                content: [
                  {
                    type: 'image',
                    source: {
                      type: 'base64',
                      media_type: mediaType,
                      data: base64Data
                    }
                  },
                  {
                    type: 'text',
                    text: `You are creating a medical flashcard for this clinical/diagnostic image.

Context from lecture notes:
${contextText}

Generate an interpretation question and answer for this image. The question should test the student's ability to interpret what they see. Examples of good questions:
- "What abnormality is shown?"
- "What is the diagnosis?"
- "What key features are visible?"
- "What does this image demonstrate?"
- "Identify the pathology shown"

The answer MUST be very concise in this exact format:
<b>Diagnosis/Pathology name</b>
Key features (only if necessary, keep brief)

Example answers:
- "<b>Left ventricular hypertrophy</b>"
- "<b>Pneumothorax</b><br>Absent lung markings on right side"
- "<b>Atrial fibrillation</b><br>Irregularly irregular rhythm, no P waves"

Return ONLY a JSON object with "question" and "answer" fields, no other text:
{"question": "Your question here?", "answer": "<b>Pathology</b><br>Key features if needed"}`
                  }
                ]
              }]
            })
          });

          const data = await response.json();
          if (!response.ok) {
            throw new Error(data.error?.message || 'Failed to generate card');
          }

          const rawText = data.content?.[0]?.text || '';
          const jsonMatch = rawText.match(/\{[\s\S]*\}/);
          if (jsonMatch) {
            const parsed = JSON.parse(jsonMatch[0]);
            setInterpretationCard({
              question: parsed.question || 'What does this image show?',
              answer: parsed.answer || 'Unable to generate answer',
              imageDataUrl: selectedInterpretationImage.image.dataUrl
            });
            setInterpretationStep('confirm');
          } else {
            throw new Error('Invalid response format');
          }

        } catch (error) {
          console.error('Error generating interpretation card:', error);
          alert('Failed to generate card: ' + error.message);
          setInterpretationStep('select');
        } finally {
          setInterpretationProcessing(false);
        }
      };

      // Add interpretation card to deck
      const addInterpretationCard = () => {
        if (!interpretationCard) return;

        const tagSource = lectureTag || notes?.title || 'Lecture';
        const lectureWords = tagSource.split(/[\s_\-\.]+/).filter(word => word.length > 0);
        const lectureName = lectureWords.map(word => word.charAt(0).toUpperCase() + word.slice(1)).join('');
        const moduleTag = moduleAbbrev ? `${moduleAbbrev}_${lectureName}` : lectureName;

        const newCard = {
          front: `<img src="${interpretationCard.imageDataUrl}" style="max-width:400px;"><br><br>${interpretationCard.question}`,
          back: interpretationCard.answer,
          tags: `Day2 ${moduleTag} Interpretation`,
          image: null,
          interpretationData: {
            imageDataUrl: interpretationCard.imageDataUrl,
            question: interpretationCard.question,
            answer: interpretationCard.answer
          }
        };

        setCards(prev => [...prev, newCard]);

        // Reset modal
        setInterpretationModalOpen(false);
        setInterpretationStep('select');
        setSelectedInterpretationImage(null);
        setInterpretationCard(null);

        setChatMessages(prev => [...prev, {
          role: 'assistant',
          content: `✅ Added interpretation card!\n\nGo to the Cards tab to review and export.`
        }]);
      };

      // Create a masked version of an image with one label covered
      const createMaskedImage = (imageDataUrl, labelToMask) => {
        return new Promise((resolve) => {
          const img = new Image();
          img.onload = () => {
            const canvas = document.createElement('canvas');
            canvas.width = img.width;
            canvas.height = img.height;
            const ctx = canvas.getContext('2d');

            // Draw original image
            ctx.drawImage(img, 0, 0);

            // Calculate actual pixel coordinates from percentages
            const x = (labelToMask.x / 100) * img.width;
            const y = (labelToMask.y / 100) * img.height;
            const width = (labelToMask.width / 100) * img.width;
            const height = (labelToMask.height / 100) * img.height;

            // Draw mask rectangle (red/pink color typical for occlusion)
            ctx.fillStyle = '#FF6B6B';
            ctx.fillRect(x, y, width, height);

            // Add a subtle border
            ctx.strokeStyle = '#CC0000';
            ctx.lineWidth = 2;
            ctx.strokeRect(x, y, width, height);

            // Add question mark in center of mask
            ctx.fillStyle = '#FFFFFF';
            ctx.font = `bold ${Math.min(width, height) * 0.6}px Arial`;
            ctx.textAlign = 'center';
            ctx.textBaseline = 'middle';
            ctx.fillText('?', x + width / 2, y + height / 2);

            resolve(canvas.toDataURL('image/jpeg', 0.9));
          };
          img.src = imageDataUrl;
        });
      };

      // Generate a higher resolution image from a PDF page for insertion
      const generateFullResImage = async (pageNum) => {
        if (!file) return null;
        try {
          const arrayBuffer = await file.arrayBuffer();
          const pdf = await pdfjsLib.getDocument({ data: arrayBuffer }).promise;
          const page = await pdf.getPage(pageNum);

          // Render at higher resolution for better quality (scale 1.5 = ~600px width)
          const viewport = page.getViewport({ scale: 1.5 });
          const canvas = document.createElement('canvas');
          canvas.width = viewport.width;
          canvas.height = viewport.height;
          const ctx = canvas.getContext('2d');

          await page.render({ canvasContext: ctx, viewport: viewport }).promise;

          return {
            dataUrl: canvas.toDataURL('image/jpeg', 0.85),
            pageNum: pageNum,
            width: viewport.width,
            height: viewport.height
          };
        } catch (error) {
          console.error('Error generating full-res image:', error);
          return null;
        }
      };

      // Apply crop to an image and return the cropped data URL
      const applyCrop = (imageData, cropArea) => {
        return new Promise((resolve) => {
          const img = new Image();
          img.onload = () => {
            const canvas = document.createElement('canvas');

            // Calculate crop dimensions relative to actual image size
            const scaleX = img.width / imageData.displayWidth;
            const scaleY = img.height / imageData.displayHeight;

            const cropX = cropArea.x * scaleX;
            const cropY = cropArea.y * scaleY;
            const cropWidth = cropArea.width * scaleX;
            const cropHeight = cropArea.height * scaleY;

            canvas.width = cropWidth;
            canvas.height = cropHeight;

            const ctx = canvas.getContext('2d');
            ctx.drawImage(img, cropX, cropY, cropWidth, cropHeight, 0, 0, cropWidth, cropHeight);

            resolve({
              dataUrl: canvas.toDataURL('image/jpeg', 0.85),
              pageNum: imageData.pageNum,
              width: cropWidth,
              height: cropHeight,
              cropped: true
            });
          };
          img.src = imageData.dataUrl;
        });
      };

      // Confirm crop and insert the image
      // Render annotations onto a canvas
      const renderAnnotationsToCanvas = (canvas, ctx, imageData, annotationsList) => {
        const scaleX = canvas.width / imageData.displayWidth;
        const scaleY = canvas.height / imageData.displayHeight;

        ctx.lineCap = 'round';
        ctx.lineJoin = 'round';

        for (const ann of annotationsList) {
          ctx.strokeStyle = ann.color;
          ctx.fillStyle = ann.color;
          ctx.lineWidth = 3 * Math.max(scaleX, scaleY);

          if (ann.type === 'draw') {
            ctx.beginPath();
            ann.points.forEach((p, i) => {
              const x = p.x * scaleX;
              const y = p.y * scaleY;
              if (i === 0) ctx.moveTo(x, y);
              else ctx.lineTo(x, y);
            });
            ctx.stroke();
          } else if (ann.type === 'circle') {
            ctx.beginPath();
            ctx.arc(ann.cx * scaleX, ann.cy * scaleY, ann.radius * Math.max(scaleX, scaleY), 0, 2 * Math.PI);
            ctx.stroke();
          } else if (ann.type === 'arrow') {
            const x1 = ann.x1 * scaleX;
            const y1 = ann.y1 * scaleY;
            const x2 = ann.x2 * scaleX;
            const y2 = ann.y2 * scaleY;
            const angle = Math.atan2(y2 - y1, x2 - x1);
            const headLen = 10 * Math.max(scaleX, scaleY);

            // Line (thinner)
            ctx.lineWidth = 2 * Math.max(scaleX, scaleY);
            ctx.beginPath();
            ctx.moveTo(x1, y1);
            ctx.lineTo(x2, y2);
            ctx.stroke();

            // Arrowhead
            ctx.beginPath();
            ctx.moveTo(x2, y2);
            ctx.lineTo(x2 - headLen * Math.cos(angle - Math.PI / 6), y2 - headLen * Math.sin(angle - Math.PI / 6));
            ctx.lineTo(x2 - headLen * Math.cos(angle + Math.PI / 6), y2 - headLen * Math.sin(angle + Math.PI / 6));
            ctx.closePath();
            ctx.fill();
          } else if (ann.type === 'text') {
            const fontSize = (ann.fontSize || 14) * Math.max(scaleX, scaleY);
            ctx.font = `500 ${fontSize}px sans-serif`;
            ctx.shadowColor = 'rgba(0,0,0,0.4)';
            ctx.shadowBlur = 1;
            ctx.shadowOffsetX = 1;
            ctx.shadowOffsetY = 1;
            ctx.fillText(ann.text, ann.x * scaleX, ann.y * scaleY);
            ctx.shadowColor = 'transparent';
          }
        }
      };

      const confirmCropAndInsert = async () => {
        if (!cropModalOpen) return;

        const { type, sectionIndex, pointIndex, imageData } = cropModalOpen;

        // Create a canvas to render the final image with annotations
        const img = new Image();
        img.src = imageData.dataUrl;

        await new Promise((resolve, reject) => {
          img.onload = () => {
            console.log('Image loaded:', { width: img.width, height: img.height, naturalWidth: img.naturalWidth, naturalHeight: img.naturalHeight });
            resolve();
          };
          img.onerror = reject;
        });

        const canvas = document.createElement('canvas');
        const ctx = canvas.getContext('2d');

        // Get actual image dimensions
        const imgWidth = img.naturalWidth || img.width;
        const imgHeight = img.naturalHeight || img.height;

        console.log('Image dimensions:', { imgWidth, imgHeight, imageDataWidth: imageData.width, imageDataHeight: imageData.height });
        console.log('Display dimensions:', { displayWidth: imageData.displayWidth, displayHeight: imageData.displayHeight });
        console.log('Crop area:', cropArea);

        // Determine if we need to crop (with tolerance for floating point comparison)
        const tolerance = 5;
        const needsCrop = cropArea && cropArea.width > 0 && cropArea.height > 0 && (
            cropArea.x > tolerance ||
            cropArea.y > tolerance ||
            cropArea.width < (imageData.displayWidth - tolerance) ||
            cropArea.height < (imageData.displayHeight - tolerance)
        );

        console.log('Need crop:', needsCrop);

        // Calculate scale factors
        const scaleX = imgWidth / imageData.displayWidth;
        const scaleY = imgHeight / imageData.displayHeight;

        if (needsCrop) {
          const cropX = Math.round(cropArea.x * scaleX);
          const cropY = Math.round(cropArea.y * scaleY);
          const cropWidth = Math.round(cropArea.width * scaleX);
          const cropHeight = Math.round(cropArea.height * scaleY);

          console.log('Applying crop:', { cropX, cropY, cropWidth, cropHeight, scaleX, scaleY });

          canvas.width = cropWidth;
          canvas.height = cropHeight;

          // Draw cropped portion of image
          ctx.drawImage(img, cropX, cropY, cropWidth, cropHeight, 0, 0, cropWidth, cropHeight);

          // Render annotations adjusted for crop offset
          const croppedAnnotations = annotations.map(ann => {
            if (ann.type === 'draw') {
              return { ...ann, points: ann.points.map(p => ({ x: p.x - cropArea.x, y: p.y - cropArea.y })) };
            } else if (ann.type === 'circle') {
              return { ...ann, cx: ann.cx - cropArea.x, cy: ann.cy - cropArea.y };
            } else if (ann.type === 'arrow') {
              return { ...ann, x1: ann.x1 - cropArea.x, y1: ann.y1 - cropArea.y, x2: ann.x2 - cropArea.x, y2: ann.y2 - cropArea.y };
            } else if (ann.type === 'text') {
              return { ...ann, x: ann.x - cropArea.x, y: ann.y - cropArea.y };
            }
            return ann;
          });

          // Adjust scale for cropped image
          const croppedImageData = { ...imageData, displayWidth: cropArea.width, displayHeight: cropArea.height };
          renderAnnotationsToCanvas(canvas, ctx, croppedImageData, croppedAnnotations);
        } else {
          // No crop, just render full image with annotations
          console.log('No crop needed, using full image');
          canvas.width = imgWidth;
          canvas.height = imgHeight;
          ctx.drawImage(img, 0, 0);
          renderAnnotationsToCanvas(canvas, ctx, imageData, annotations);
        }

        const finalImage = {
          dataUrl: canvas.toDataURL('image/jpeg', 0.85),
          pageNum: imageData.pageNum,
          width: canvas.width,
          height: canvas.height,
          cropped: needsCrop,
          annotated: annotations.length > 0
        };

        // Insert image at point or section level based on type
        if (type === 'section') {
          setSectionImage(sectionIndex, finalImage);
        } else {
          setPointImage(sectionIndex, pointIndex, finalImage);
        }

        setCropModalOpen(null);
        setCropArea(null);
        setAnnotations([]);
        setCurrentTool('crop');
      };

      // Convert markdown-style formatting to HTML for display
      const markdownToHTML = (text) => {
        if (!text) return '';
        let html = String(text);

        // Convert **bold** to <b>bold</b>
        // Match ** that's not preceded by another *, followed by content, followed by ** not followed by another *
        html = html.replace(/(?<!\*)\*\*(?!\*)(.+?)(?<!\*)\*\*(?!\*)/g, '<b>$1</b>');

        return html;
      };

      const handleFileUpload = async (e) => {
        const uploadedFile = e.target.files[0];
        if (!uploadedFile || !uploadedFile.name.toLowerCase().endsWith('.pdf')) {
          setChatMessages(prev => [...prev, { role: 'assistant', content: "Please upload a PDF file." }]);
          return;
        }

        try {
          setFile(uploadedFile);
          const data = await readFile(uploadedFile);
          setFileData(data);
          const defaultTag = uploadedFile.name.replace(/\.[^/.]+$/, '').replace(/_/g, ' ').replace(/[^a-zA-Z0-9 ]/g, ' ').replace(/\s+/g, ' ').trim();
          setLectureTag(defaultTag);

          // Generate thumbnails in the background for image insertion feature
          generatePdfThumbnails(uploadedFile);

          setChatMessages(prev => [...prev,
            { role: 'user', content: `Uploaded: ${uploadedFile.name}` },
            { role: 'assistant', content: `Great! Tag: "${defaultTag}"\n\nNow choose what to generate:\n• "Generate Notes" - Create study notes from the PDF\n• "Generate Flashcards" - Create Anki cards (works best after notes are generated)${!apiKey ? '\n\n⚠️ Add your API key in Settings first!' : ''}` }
          ]);
        } catch (error) {
          setChatMessages(prev => [...prev, { role: 'assistant', content: `❌ Error loading PDF: ${error.message}. The file may be corrupted, too large, or in an unsupported format.` }]);
          setFile(null);
          setFileData(null);
          setPdfThumbnails([]); // Clear any partial thumbnails
        }
      };

      const generateNotes = async () => {
        if (!file || !apiKey || !fileData) {
          if (!apiKey) setChatMessages(prev => [...prev, { role: 'assistant', content: "⚠️ Add your API key in Settings first." }]);
          return;
        }
        setProcessing(true);
        setProcessingType('notes');
        setChatMessages(prev => [...prev, { role: 'assistant', content: "Generating notes from PDF..." }]);

        try {
          const loSection = userLearningObjectives.trim()
            ? `\n\nIMPORTANT: The user has provided these learning objectives for this lecture. Use these EXACTLY as the learningObjectives in your response:\n${userLearningObjectives}\n\nStructure your notes to address these learning objectives.`
            : '';
          const customInstructionsSection = customInstructions.trim()
            ? `\n\nADDITIONAL INSTRUCTIONS FROM USER:\n${customInstructions}\n\nPlease follow these instructions when generating the notes.`
            : '';
          const notesPrompt = `You are to summarise my medical school lecture slides into concise, high-density revision notes.\n\nFollow all rules exactly.\n\n⸻\n\nCORE GOAL\n\nProduce notes that are:\n• Maximally information-dense\n• Easy to visually process\n• Complete (no important details from the slides may be omitted)\n• Understandable even to someone not yet expert, while still exam-level\n\nThe notes should feel like an expert-compressed version of the lecture, not a paraphrase.\n\n⸻\n\nCONTENT RULES\n• Include all examinable mechanisms, structures, definitions, pathways, thresholds, and distinctions from the slides\n• Do not oversummarise at the expense of missing details\n• Rewrite content concisely, but preserve every causal link and logical step\n• Integrate related points together under the correct conceptual heading\n• Exclude anecdotal commentary, filler text, and slide narration\n\n⸻\n\nVISUAL PROCESSING RULES (CRITICAL)\n• Keep sentences short and direct\n• Prefer compact phrases over prose\n• Use directional arrows consistently:\n\nCause → Effect\n↓ / ↑ for decrease or increase\n⇄ for balance or reciprocity\n\nExamples:\n• ↓ insulin → ↑ lipolysis → ↑ ketogenesis → metabolic acidosis\n• ↑ T3/T4 → ↑ β-adrenergic receptor expression → ↑ heart rate\n• When describing regulation, always make directionality explicit\n• Avoid vague wording like "affects", "influences", or "involved in"\n\n⸻\n\nDENSITY WITHOUT CONFUSION\n• Notes should be as compressed as possible while remaining readable\n• If a concept is complex, break it into stacked bullet points rather than long sentences\n• Group related mechanisms together to minimise repetition\n• Prefer cause-effect chains over narrative explanation\n\n⸻\n\nSTRUCTURAL INTELLIGENCE\n• CRITICAL: Preserve the overall flow and order of the lecture - this sequencing is pedagogically intentional\n• Sections should appear in roughly the same order as the lecture presents topics\n• If the lecture covers Topic A then Topic B, do not reorganise to mix them or place Topic B content before Topic A\n• Within each topic/section, you may group related points logically\n• If content about a specific topic (e.g. future therapies for Disease X) appears in that topic's section in the lecture, keep it there - do not combine it with similar content from other topics\n• Place mechanisms next to their consequences\n• Place definitions immediately before usage\n• Make contrasts explicit where exam-relevant\n• When in doubt about ordering, follow the lecture's sequence\n\n⸻\n\nLANGUAGE RULES\n• Use precise medical terminology\n• No rhetorical questions\n• No conversational tone\n• No redundancy\n\n⸻\n\nFINAL RULE\n\nBefore finishing, internally verify that:\n• Every learning objective is fully addressed\n• No mechanism, value, structure, or regulatory step from the slides is missing\n• The notes can be skimmed rapidly and read slowly with full comprehension\n\nThe final output should read like expert-level, visually optimised revision notes designed for high-stakes exams.\n\n⸻\n\nIMPORTANT: Return ONLY valid JSON in this exact format:\n{"title": "Lecture Title", "learningObjectives": ["LO1", "LO2"], "notes": [{"section": "1. Section Title", "points": ["**Key term**: concise explanation", "↓ cause → ↑ effect"]}]}\n\nJSON FORMATTING RULES (CRITICAL):\n• Escape ALL backslashes (\\) as double backslash (\\\\)\n• Escape ALL double quotes (") inside content using backslash (\\")\n• Do NOT include actual newlines - keep each point on one line\n• Ensure every string is properly closed\n• All arrays must be properly closed with ]\n• The output must be valid, parseable JSON with double quotes only\n• Only use valid JSON escape sequences: \\\\ \\" \\n \\t\n\nDo NOT include bullet point characters (•) in the points - the UI adds those automatically.\nUse **asterisks** for key terms. Use UK English spelling.${loSection}${customInstructionsSection}`;

          const notesResponse = await fetch('https://api.anthropic.com/v1/messages', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json', 'x-api-key': apiKey, 'anthropic-version': '2023-06-01', 'anthropic-dangerous-direct-browser-access': 'true' },
            body: JSON.stringify({ model: 'claude-sonnet-4-20250514', max_tokens: 3000, messages: [{ role: 'user', content: [{ type: 'document', source: { type: 'base64', media_type: 'application/pdf', data: fileData.data } }, { type: 'text', text: notesPrompt }] }] })
          });

          if (!notesResponse.ok) {
            const err = await notesResponse.json();
            throw new Error(err.error?.message || 'API failed');
          }
          const notesData = await notesResponse.json();
          const rawText = notesData.content?.[0]?.text || '';
          console.log('Raw API response length:', rawText.length);
          console.log('Raw API response (first 500 chars):', rawText.substring(0, 500));
          console.log('Raw API response (last 500 chars):', rawText.substring(rawText.length - 500));

          // Try to extract JSON from the response
          const jsonMatch = rawText.match(/\{[\s\S]*\}/);
          if (!jsonMatch) {
            console.error('No JSON object found in response');
            throw new Error('No valid JSON found in API response. The model may have returned an incomplete or malformed response.');
          }

          let notesResult;
          try {
            notesResult = JSON.parse(jsonMatch[0]);
          } catch (parseError) {
            console.error('JSON parse error:', parseError.message);
            console.error('Attempted to parse:', jsonMatch[0].substring(0, 200) + '...');

            // Try to find the position of the error
            const errorMatch = parseError.message.match(/position (\d+)/);
            if (errorMatch) {
              const pos = parseInt(errorMatch[1]);
              console.error('Error context around position', pos, ':', jsonMatch[0].substring(Math.max(0, pos - 50), pos + 50));
            }

            throw new Error(`JSON parse error: ${parseError.message}. The API returned malformed JSON.`);
          }

          // Use the user-inputted lecture tag as the title instead of the PDF's title
          if (lectureTag) {
            notesResult.title = lectureTag;
          }
          setNotes(notesResult);
          setActiveTab('notes');
          setChatMessages(prev => [...prev, { role: 'assistant', content: `✅ Notes generated!\n• ${notesResult.notes?.length || 0} sections\n• ${notesResult.learningObjectives?.length || 0} learning objectives\n\nYou can now generate flashcards from these notes.` }]);
        } catch (error) {
          setChatMessages(prev => [...prev, { role: 'assistant', content: `❌ Error: ${error.message}` }]);
        } finally {
          setProcessing(false);
          setProcessingType('');
        }
      };

      const generateFlashcards = async () => {
        if (!apiKey) {
          setChatMessages(prev => [...prev, { role: 'assistant', content: "⚠️ Add your API key in Settings first." }]);
          return;
        }
        if (!notes) {
          setChatMessages(prev => [...prev, { role: 'assistant', content: "⚠️ Please generate notes first, then generate flashcards." }]);
          return;
        }

        setProcessing(true);
        setProcessingType('cards');
        setChatMessages(prev => [...prev, { role: 'assistant', content: "Generating flashcards from notes..." }]);

        try {
          const notesText = notes.notes?.map(s => `## ${s.section}\n${s.points?.map(p => `- ${p}`).join('\n')}`).join('\n\n') || '';
          const cardsPrompt = `You are to generate high-quality Anki flashcards from my medical lecture notes using a strict recall-optimised technique.

Follow all rules exactly.

⸻

Each flashcard must have:

Front (Question)
• A single, precise question
• Tests one concept only
• Answerable in ≤10 seconds
• No vague verbs (describe, discuss, outline)
• No MCQs
• No case vignettes
• No multi-part questions

Back (Answer)
• Must contain only the answer
• Must NOT repeat or paraphrase the question
• No filler words
• Prefer short noun phrases over sentences

Example (required style):
Front: How many brains does a human have?
Back: One

⸻

Answer formatting rules (mandatory):
1. Minimal phrasing
   • Use the shortest precise wording possible

2. Lists
   • Each item must be on its own line
   • Add a blank line between each item (use <br><br> between items)
   • Do not separate items with commas
   • Example: Item 1<br><br>Item 2<br><br>Item 3

3. Mechanisms (stepwise processes)
   • Each step must be on a new line, starting with →
   • No blank lines between steps
   • Example: → Step 1<br>→ Step 2<br>→ Step 3

4. Cause → effect
   • Use arrows (→) to show causal chains

5. Directional changes
   • Use ↑ for increase
   • Use ↓ for decrease

6. Length limit
   • Maximum 5 lines per answer
   • If more information is needed, split into multiple cards

⸻

Question categories to use (balanced mix where applicable):
• Definition / Identity
• Location / Source / Cell type
• Mechanism (single-step or stepwise)
• Cause → Effect
• Regulation / Feedback
• Comparison (one axis only)
• Thresholds / Diagnostic values
• Limited lists (3–5 items maximum)
• Clinical associations (no cases)

Each question must clearly fit one category only.

⸻

Final rule:

If a flashcard:
• Repeats the question in the answer
• Uses unnecessary full sentences
• Contains multiple concepts
• Is visually dense or cluttered

Rewrite it until it is maximally minimal, visually clean, and forces precise recall.

⸻

IMPORTANT: Return ONLY a JSON array, nothing else. No markdown, no explanation, just the array:
[{"front":"Question?","back":"Answer"}]

JSON FORMATTING RULES (CRITICAL):
- Escape ALL backslashes (\) as double backslash (\\)
- Escape ALL double quotes (") inside content using backslash (\")
- Replace ALL newlines inside content with <br> tags
- Ensure every string is properly closed
- Do not include line breaks within JSON strings
- The array must be valid, parseable JSON with double quotes only
- Only use valid JSON escape sequences: \\ \" \n \t

Aim to cover all content from the notes comprehensively within 20-50 cards.

DO NOT create flashcards for:
- Incidence, prevalence, or percentage statistics (e.g. "X% of cases are caused by Y")
- Background context or historical information
- Content that is intuitive or easily derived

PRIORITISE:
- Key definitions and terminology
- Diagnostic values and thresholds
- Mechanisms and pathways
- Clinical associations
- Drug names, doses, and side effects

Use UK English spelling.

LECTURE NOTES:
${notesText}`;

          const cardsResponse = await fetch('https://api.anthropic.com/v1/messages', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json', 'x-api-key': apiKey, 'anthropic-version': '2023-06-01', 'anthropic-dangerous-direct-browser-access': 'true' },
            body: JSON.stringify({ model: 'claude-sonnet-4-20250514', max_tokens: 4096, system: 'You are a flashcard generator. Generate 25-40 flashcards (hard limits: 20 min, 50 max). PRIORITISE: definitions, mechanisms, pathways, diagnostic thresholds, clinical associations, drug names/doses/side effects. NEVER include: incidence, prevalence, percentages, statistics, or "most common cause" questions. FORMATTING: For lists, put items in alphabetical order and add a blank line between each item (use <br><br>). For mechanisms, put a line break BEFORE each → arrow (not after). After step 1, use lowercase unless it is a chemical or abbreviation. Example list: "Apple<br><br>Banana<br><br>Cherry". Example mechanism: "↓ Oxygen<br>→ ↑ CO₂<br>→ acidosis<br>→ cardiovascular dysfunction".', messages: [{ role: 'user', content: cardsPrompt }] })
          });

          const cardsData = await cardsResponse.json();
          console.log('Cards API response:', cardsData);

          if (!cardsResponse.ok) {
            if (cardsResponse.status === 429) {
              throw new Error('Rate limit hit. Please wait a minute and try again.');
            }
            throw new Error(cardsData.error?.message || 'Flashcard API failed');
          }

          const rawText = cardsData.content?.[0]?.text || '';
          console.log('Raw flashcard text:', rawText);

          // Parse JSON array from response
          let parsedCards = [];
          let parseError = null;
          try {
            // Find JSON array in response (handles markdown code blocks too)
            const jsonMatch = rawText.match(/\[[\s\S]*\]/);
            console.log('JSON match found:', !!jsonMatch);
            if (jsonMatch) {
              let jsonText = jsonMatch[0];

              // Try to repair truncated JSON by finding last complete object
              if (jsonText.includes('unterminated string') || !jsonText.endsWith(']')) {
                const lastCompleteObj = jsonText.lastIndexOf('}');
                if (lastCompleteObj > 0) {
                  jsonText = jsonText.substring(0, lastCompleteObj + 1) + ']';
                  console.log('Repaired truncated JSON');
                }
              }

              const cardsArray = JSON.parse(jsonText);
              console.log('Parsed array length:', cardsArray.length);
              // Generate tag: MODULE_LectureName format (every word capitalized, no spaces)
              // Use lectureTag, or fall back to notes title if available
              const tagSource = lectureTag || notes?.title || 'Lecture';
              const lectureWords = tagSource.split(/[\s_\-\.]+/).filter(word => word.length > 0);
              const lectureName = lectureWords.map(word => word.charAt(0).toUpperCase() + word.slice(1)).join('');
              const moduleTag = moduleAbbrev ? `${moduleAbbrev}_${lectureName}` : lectureName;
              console.log('Generated tag:', moduleTag, 'from source:', tagSource);

              parsedCards = cardsArray.map(card => ({
                front: card.front || card.q || card.question || '',
                back: card.back || card.a || card.answer || '',
                tags: `Day2 ${moduleTag}`,
                image: null // Will be set by user if they choose to attach an image
              })).filter(card => card.front.length > 0);
            } else {
              parseError = 'No JSON array found in response';
            }
          } catch (e) {
            console.error('JSON parse error:', e);
            parseError = e.message;
          }

          console.log('Parsed cards:', parsedCards);

          setCards(parsedCards);
          setActiveTab('cards');

          if (parsedCards.length === 0) {
            const preview = rawText.substring(0, 200);
            setChatMessages(prev => [...prev, { role: 'assistant', content: `⚠️ No flashcards generated.\n\nError: ${parseError || 'Unknown'}\n\nResponse preview (first 200 chars):\n${preview}...\n\nPlease try again or check your notes.` }]);
          } else {
            setChatMessages(prev => [...prev, { role: 'assistant', content: `✅ Flashcards generated!\n• ${parsedCards.length} cards created\n\nGo to the Cards tab to review and export.` }]);
          }
        } catch (error) {
          setChatMessages(prev => [...prev, { role: 'assistant', content: `❌ Error: ${error.message}` }]);
        } finally {
          setProcessing(false);
          setProcessingType('');
        }
      };

      const modifyNotes = async () => {
        if (!notes || !modifyRequest.trim() || !apiKey) return;

        const requestText = modifyRequest;
        setModifying(true);
        setModifyRequest('');

        try {
          const currentNotesJson = JSON.stringify(notes, null, 2);
          const modifyPrompt = `You are a medical education assistant. Here are the current lecture notes in JSON format:

${currentNotesJson}

USER REQUEST: ${requestText}

Apply the user's requested changes to the notes. Return ONLY valid JSON in the exact same format:
{"title": "...", "learningObjectives": [...], "notes": [{"section": "...", "points": [...]}]}

Use **asterisks** for key terms. Be concise. UK English. Preserve all existing content unless the user specifically asks to remove or change something.`;

          const response = await fetch('https://api.anthropic.com/v1/messages', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json', 'x-api-key': apiKey, 'anthropic-version': '2023-06-01', 'anthropic-dangerous-direct-browser-access': 'true' },
            body: JSON.stringify({ model: 'claude-3-haiku-20240307', max_tokens: 4096, messages: [{ role: 'user', content: modifyPrompt }] })
          });

          if (!response.ok) {
            const err = await response.json().catch(() => ({}));
            throw new Error(err.error?.message || 'API request failed');
          }

          const data = await response.json();
          const rawText = data.content?.[0]?.text || '';
          console.log('Modify notes raw response:', rawText.substring(0, 500));

          // Try multiple parsing strategies
          let modifiedNotes = null;
          let parseError = null;

          // Strategy 1: Direct parse of the entire response (if it's pure JSON)
          try {
            modifiedNotes = JSON.parse(rawText);
            console.log('Strategy 1 worked: direct parse');
          } catch (e) {
            parseError = e.message;
          }

          // Strategy 2: Find JSON object with greedy regex
          if (!modifiedNotes) {
            const jsonMatch = rawText.match(/\{[\s\S]*\}/);
            if (jsonMatch) {
              try {
                modifiedNotes = JSON.parse(jsonMatch[0]);
                console.log('Strategy 2 worked: regex match');
              } catch (e) {
                parseError = e.message;
              }
            }
          }

          // Strategy 3: Look for ```json code block
          if (!modifiedNotes) {
            const codeBlockMatch = rawText.match(/```(?:json)?\s*([\s\S]*?)```/);
            if (codeBlockMatch) {
              try {
                modifiedNotes = JSON.parse(codeBlockMatch[1].trim());
                console.log('Strategy 3 worked: code block');
              } catch (e) {
                parseError = e.message;
              }
            }
          }

          // Strategy 4: Find first { and last } and try to parse between them
          if (!modifiedNotes) {
            const firstBrace = rawText.indexOf('{');
            const lastBrace = rawText.lastIndexOf('}');
            if (firstBrace !== -1 && lastBrace > firstBrace) {
              try {
                modifiedNotes = JSON.parse(rawText.substring(firstBrace, lastBrace + 1));
                console.log('Strategy 4 worked: first/last brace');
              } catch (e) {
                parseError = e.message;
              }
            }
          }

          if (!modifiedNotes) {
            console.error('All parsing strategies failed. Raw response:', rawText);
            throw new Error(`Could not parse response. Last error: ${parseError}`);
          }

          // Validate the parsed object has required fields
          if (!modifiedNotes.title) {
            throw new Error('Response missing "title" field');
          }
          if (!Array.isArray(modifiedNotes.notes)) {
            throw new Error('Response missing "notes" array');
          }

          setNotes(modifiedNotes);
          setChatMessages(prev => [...prev, { role: 'assistant', content: `✅ Notes modified!\nApplied: "${requestText}"` }]);
        } catch (error) {
          console.error('Modify notes error:', error);
          setChatMessages(prev => [...prev, { role: 'assistant', content: `❌ Modification failed: ${error.message}` }]);
        } finally {
          setModifying(false);
        }
      };

      const copyNotes = async () => {
        if (!notes) return;
        let md = `# ${notes.title}\n\n## Learning Objectives\n\n${notes.learningObjectives?.map(l => `• ${l}`).join('\n')}\n\n---\n\n`;
        notes.notes?.forEach(s => { md += `## ${s.section}\n\n${s.points?.map(p => `- ${p}`).join('\n')}\n\n`; });
        await navigator.clipboard.writeText(md);
        setCopied(true); setTimeout(() => setCopied(false), 2000);
      };

      // ===== PDF IMPORT FUNCTIONALITY =====

      // Helper: Detect indentation level from x-coordinate
      const getIndentLevel = (x) => {
        if (x < 70) return 0;      // x ≈ 55 (base)
        if (x < 110) return 1;     // x ≈ 95 (40px indent)
        if (x < 150) return 2;     // x ≈ 135 (80px indent)
        if (x < 190) return 3;     // x ≈ 175 (120px indent)
        return Math.floor((x - 55) / 40);
      };

      // Helper: Convert bold text items to **markdown**
      const convertBoldInline = (items) => {
        let result = '';
        let inBold = false;

        for (const item of items) {
          if (item.isBold && !inBold) {
            result += '**';
            inBold = true;
          } else if (!item.isBold && inBold) {
            result += '**';
            inBold = false;
          }
          result += item.text;
        }

        if (inBold) {
          result += '**';
        }

        return result;
      };

      // Helper: Reconstruct nested bullet HTML from hierarchical bullet lines
      const reconstructNestedBullets = (bulletLines) => {
        if (!bulletLines || bulletLines.length === 0) return [];

        const points = [];
        let currentPoint = null;
        let pendingNested = [];

        for (const line of bulletLines) {
          const level = getIndentLevel(line.x);
          const text = convertBoldInline(line.items);

          if (level === 0) {
            // Save previous point
            if (currentPoint) {
              if (pendingNested.length > 0) {
                currentPoint += '<ul>' + pendingNested.map(n => `<li>${n}</li>`).join('') + '</ul>';
                pendingNested = [];
              }
              points.push(currentPoint);
            }
            // Start new point
            currentPoint = text;
          } else if (level === 1) {
            // First-level nesting
            pendingNested.push(text);
          } else {
            // Deeper nesting - append to last nested item
            if (pendingNested.length > 0) {
              const lastIdx = pendingNested.length - 1;
              pendingNested[lastIdx] += `<ul><li>${text}</li></ul>`;
            }
          }
        }

        // Save final point
        if (currentPoint) {
          if (pendingNested.length > 0) {
            currentPoint += '<ul>' + pendingNested.map(n => `<li>${n}</li>`).join('') + '</ul>';
          }
          points.push(currentPoint);
        }

        return points;
      };

      // Main PDF parsing function
      const parsePDFToNotes = async (file) => {
        console.log('===== PDF IMPORT STARTED [VERSION 3.0 - LOSSLESS JSON METADATA] =====');

        // Read file as ArrayBuffer
        const arrayBuffer = await file.arrayBuffer();

        // Load PDF
        const pdf = await pdfjsLib.getDocument({ data: arrayBuffer }).promise;
        console.log('PDF loaded, pages:', pdf.numPages);

        // Extract text items from all pages
        const allItems = [];
        for (let pageNum = 1; pageNum <= pdf.numPages; pageNum++) {
          const page = await pdf.getPage(pageNum);
          const textContent = await page.getTextContent();

          for (const item of textContent.items) {
            allItems.push({
              text: item.str,
              x: Math.round(item.transform[4]),
              y: Math.round(item.transform[5]),
              fontSize: Math.round(item.transform[0]),
              fontName: item.fontName || '',
              isBold: (item.fontName || '').includes('Bold')
            });
          }
        }

        console.log('Total text items extracted:', allItems.length);
        if (allItems.length > 0) {
          console.log('Sample items (first 10):');
          allItems.slice(0, 10).forEach(item => {
            console.log(`  x:${item.x} y:${item.y} size:${item.fontSize} font:"${item.fontName}" bold:${item.isBold} text:"${item.text}"`);
          });

          // Show unique font names
          const uniqueFonts = [...new Set(allItems.map(i => i.fontName))];
          console.log('Unique font names in PDF:', uniqueFonts);
        }

        if (allItems.length === 0) {
          throw new Error('PDF contains no text');
        }

        // COLUMN DETECTION: Detect if PDF has multi-column layout
        // Group items by X-position to find columns
        const xPositions = allItems.map(item => item.x);
        const minX = Math.min(...xPositions);
        const maxX = Math.max(...xPositions);

        // Detect columns by clustering X positions of content starts
        const contentStarts = allItems
          .filter(item => item.fontSize >= 11) // Only content, not footnotes
          .map(item => item.x);

        // Common left margins in PDFs: ~40-60px (left column), ~300-350px (right column)
        const leftColumnItems = contentStarts.filter(x => x < 200);
        const rightColumnItems = contentStarts.filter(x => x >= 200);

        const hasMultipleColumns = rightColumnItems.length > 20; // At least 20 items in right column

        if (hasMultipleColumns) {
          console.log('Multi-column layout detected. Processing columns separately...');
        }

        // Sort by Y (descending, top to bottom), then X (ascending, left to right)
        allItems.sort((a, b) => b.y - a.y || a.x - b.x);

        // Group into lines (items with similar Y coordinates AND similar X positions to avoid merging columns)
        const lines = [];
        let currentLine = [];
        let lastY = null;
        let lastX = null;

        // Track line splits for debugging
        let lineBreaks = 0;
        let sameLineJoins = 0;
        let xJumpForwardCount = 0;
        let xJumpBackwardCount = 0;

        for (const item of allItems) {
          const yDiff = lastY !== null ? Math.abs(item.y - lastY) : 0;

          // STRICT: Only group items with EXACTLY the same Y coordinate (allow 1px tolerance for rounding)
          // AND only if X is progressing naturally (not jumping to a different column)
          const shouldGroup = lastY === null || (yDiff <= 1);

          // Check for column jumps: large X movement (backward OR forward) indicates different column/section
          // Use font-size-aware thresholds: smaller fonts (section headers) are stricter
          const xJumpBackward = lastX !== null && item.x < lastX - 10;

          // CRITICAL: Check distance from LINE START, not just previous item
          // This prevents chaining items across columns (x=40 → x=54 → x=123 → x=212 → x=253)
          // Column width for two-column A4 PDF is typically 200-240px (conservative: 200px)
          const lineStartX = currentLine.length > 0 ? currentLine[0].x : (lastX || 0);
          const columnWidth = 200; // Maximum span of a single line (detects column boundaries)

          // Forward jump: item is in a different column (far from where this line started)
          const xJumpForward = currentLine.length > 0 && item.x > lineStartX + columnWidth;

          // Log significant jumps for debugging
          if (xJumpForward) {
            xJumpForwardCount++;
            if (xJumpForwardCount <= 10) {
              console.log(`  Forward X-jump: line starts at ${lineStartX}, item at ${item.x} (span: ${item.x - lineStartX}px > ${columnWidth}px) text:"${item.text.substring(0, 20)}"`);
            }
          }
          if (xJumpBackward) {
            xJumpBackwardCount++;
            if (xJumpBackwardCount <= 5) {
              console.log(`  Backward X-jump: ${lastX} → ${item.x} text:"${item.text.substring(0, 20)}"`);
            }
          }

          if (shouldGroup && !xJumpBackward && !xJumpForward) {
            currentLine.push(item);
            // Debug: Log when items with X >= 200 are added to a line
            if (item.x >= 200 && currentLine.length <= 3) {
              console.log(`  Item at X=${item.x} added to line starting at X=${currentLine[0].x} (${currentLine.length} items, yDiff=${yDiff}, maxSpan=${columnWidth}px)`);
            }
            lastX = item.x;
            sameLineJoins++;
          } else {
            if (currentLine.length > 0) {
              // Join text with proper spacing - add space between items if not already present
              let text = '';
              for (let i = 0; i < currentLine.length; i++) {
                const itemText = currentLine[i].text;
                if (i > 0 && itemText.trim() && !itemText.startsWith(' ') && !text.endsWith(' ')) {
                  // Add space if both items have non-space content and no space between them
                  text += ' ';
                }
                text += itemText;
              }
              text = text.replace(/\s+/g, ' ').trim();

              const lineX = currentLine[0].x;
              lines.push({
                items: currentLine,
                y: lastY,
                text: text,
                x: lineX,
                fontSize: currentLine[0].fontSize,
                isBold: currentLine.some(i => i.isBold)
              });

              // Debug: Log lines that start with X >= 200
              if (lineX >= 200) {
                console.log(`  ✓ Created line with X=${lineX}: "${text.substring(0, 50)}"`);
              }

              lineBreaks++;
            }
            currentLine = [item];
            lastX = item.x;
          }
          lastY = item.y;
        }

        console.log(`Line grouping stats: ${sameLineJoins} items grouped, ${lineBreaks} line breaks, ${xJumpForwardCount} forward jumps, ${xJumpBackwardCount} backward jumps`);
        if (currentLine.length > 0) {
          // Join text with proper spacing - add space between items if not already present
          let text = '';
          for (let i = 0; i < currentLine.length; i++) {
            const itemText = currentLine[i].text;
            if (i > 0 && itemText.trim() && !itemText.startsWith(' ') && !text.endsWith(' ')) {
              // Add space if both items have non-space content and no space between them
              text += ' ';
            }
            text += itemText;
          }
          text = text.replace(/\s+/g, ' ').trim();

          lines.push({
            items: currentLine,
            y: lastY,
            text: text,
            x: currentLine[0].x,
            fontSize: currentLine[0].fontSize,
            isBold: currentLine.some(i => i.isBold)
          });
        }

        // CRITICAL: Handle multi-column layouts correctly
        // For newspaper-style columns, read entire left column, then entire right column
        let sortedLines;
        if (hasMultipleColumns) {
          console.log('Applying newspaper-style column reading order...');

          // Debug: Show X-coordinate distribution of all lines
          const lineXcoords = lines.map(l => l.x).sort((a, b) => a - b);
          console.log('Line X-coordinates (sorted):', lineXcoords.slice(0, 20), '...', lineXcoords.slice(-20));
          console.log('Min X:', Math.min(...lineXcoords), 'Max X:', Math.max(...lineXcoords));

          // Detect column boundary - typically around X=200-250 for two-column A4 PDFs
          const columnBoundary = 200;

          // Separate into columns
          const leftColumn = lines.filter(line => line.x < columnBoundary);
          const rightColumn = lines.filter(line => line.x >= columnBoundary);

          // Sort each column by Y-coordinate (descending = top to bottom)
          leftColumn.sort((a, b) => b.y - a.y);
          rightColumn.sort((a, b) => b.y - a.y);

          // Concatenate: left column first, then right column
          sortedLines = [...leftColumn, ...rightColumn];

          console.log(`Column separation: ${leftColumn.length} lines in left column, ${rightColumn.length} lines in right column`);
          if (rightColumn.length > 0) {
            console.log('First 3 right column lines:', rightColumn.slice(0, 3).map(l => `x:${l.x} text:"${l.text.substring(0, 40)}"`));
          }
        } else {
          // Single column - just sort by Y
          sortedLines = lines.sort((a, b) => b.y - a.y);
          console.log('Single column layout - sorted by Y-coordinate');
        }

        // Replace lines array with sorted version
        lines.length = 0;
        lines.push(...sortedLines);

        // Filter out malformed lines (those with clearly concatenated unrelated content)
        const cleanLines = lines.filter((line, idx) => {
          // Skip lines that have capital letters immediately following lowercase (indicates concatenation)
          // Example: "dermatomesLearning" or "nervePelvic"
          const hasConcatenation = /[a-z][A-Z]/.test(line.text);
          if (hasConcatenation) {
            console.log(`  [FILTERED] Line ${idx}: "${line.text.substring(0, 60)}..." (detected lowercase→uppercase pattern)`);
          }
          // Also detect if text has section numbering followed immediately by unrelated text
          const hasNumberMerge = /\d+\.\s*[A-Z][a-z]+[A-Z]/.test(line.text);
          if (hasNumberMerge) {
            console.log(`  [FILTERED] Line ${idx}: "${line.text.substring(0, 60)}..." (detected number + concatenation)`);
          }
          return !hasConcatenation && !hasNumberMerge;
        });

        console.log(`Filter removed ${lines.length - cleanLines.length} malformed lines`);

        console.log('Total lines created:', cleanLines.length, '(filtered from', lines.length, ')');
        console.log('First 15 clean lines:');
        cleanLines.slice(0, 15).forEach((line, idx) => {
          console.log(`  [${idx}] x:${line.x} size:${line.fontSize} text:"${line.text}"`);
        });

        // Extract title (find and combine all size-18 lines, wherever they appear)
        let title = 'Imported Notes';
        const titleLines = cleanLines
          .filter(line => line.fontSize >= 17)
          .map(line => line.text);

        if (titleLines.length > 0) {
          title = titleLines.join(' ').replace(' (Concise Notes)', '').replace('(Concise Notes)', '').trim();
        }
        console.log('Title extracted:', title, `(from ${titleLines.length} lines)`);
        console.log('Title lines:', titleLines);

        // Find "Learning Objectives" header (by text content, handle split lines)
        let loHeaderIdx = cleanLines.findIndex(line =>
          line.text.includes('Learning Objectives')
        );

        // If not found as one line, look for consecutive "Learning" and "Objectives" lines
        if (loHeaderIdx === -1) {
          for (let i = 0; i < cleanLines.length - 1; i++) {
            if (cleanLines[i].text.trim() === 'Learning' &&
                cleanLines[i + 1].text.trim() === 'Objectives' &&
                cleanLines[i].fontSize === 13 && cleanLines[i + 1].fontSize === 13) {
              loHeaderIdx = i;
              console.log('Learning Objectives found split across lines', i, 'and', i + 1);
              break;
            }
          }
        }
        console.log('Learning Objectives header index:', loHeaderIdx);

        // Extract learning objectives (size 11, x around 54, after LO header)
        const learningObjectives = [];
        if (loHeaderIdx >= 0) {
          // Skip past both "Learning" and "Objectives" if split
          let i = loHeaderIdx + 1;
          if (cleanLines[loHeaderIdx].text.trim() === 'Learning' &&
              cleanLines[i] && cleanLines[i].text.trim() === 'Objectives') {
            i++; // Skip the "Objectives" line
          }
          console.log('Extracting LOs starting from line', i);
          // Learning objectives are size 11 at x=54
          while (i < cleanLines.length && cleanLines[i].fontSize === 11 && cleanLines[i].x > 50 && cleanLines[i].x < 60) {
            console.log(`  Checking line ${i}: x=${cleanLines[i].x} text="${cleanLines[i].text}"`);
            const text = cleanLines[i].text.replace(/^•\s*/, '').trim();
            // Only include if it looks like a learning objective (starts with verb or describes anatomy)
            if (text && text.length > 10 && !text.match(/^\d+\./)) {
              learningObjectives.push(text);
            }
            i++;
          }
        }
        console.log('Learning Objectives extracted:', learningObjectives.length);

        // Extract sections and points
        const notes = [];
        let currentSection = null;
        const loEndIdx = loHeaderIdx >= 0 ? loHeaderIdx + 1 + learningObjectives.length : (titleLines.length || 1);
        console.log('Starting section extraction from line', loEndIdx);

        for (let i = loEndIdx; i < cleanLines.length; i++) {
          const line = cleanLines[i];
          const prevLine = i > 0 ? cleanLines[i - 1] : null;

          // Detect section header: size 13, x around 40, y-gap > 15
          const isYGap = !prevLine || (prevLine.y - line.y > 15);
          const yGapValue = prevLine ? (prevLine.y - line.y) : 0;

          if (line.fontSize === 13 && line.x < 45 && isYGap) {
            // New section - clean up the section name
            let sectionName = line.text.trim();
            console.log(`Section detected at line ${i}: "${sectionName}" (yGap: ${yGapValue})`);
            if (currentSection) {
              console.log(`  Closing previous section with ${currentSection.points.length} points`);
              notes.push(currentSection);
            }
            currentSection = {
              section: sectionName,
              points: []
            };
          } else if (currentSection && line.fontSize === 11 && line.x > 50 && line.x < 60) {
            // Bullet point detected by size and position
            const pointText = line.text.replace(/^•\s*/, '').trim();

            console.log(`Point detected at line ${i}: x=${line.x} text="${pointText.substring(0, 50)}..."`);

            if (!pointText || pointText.length < 5) continue; // Skip empty or very short lines

            currentSection.points.push(pointText);
          } else if (i < loEndIdx + 20) {
            // Log why line was skipped (only for first 20 lines after LOs)
            console.log(`Line ${i} skipped: x=${line.x} yGap=${yGapValue} size=${line.fontSize} text="${line.text.substring(0, 30)}..."`);
          }
        }

        if (currentSection) {
          console.log(`Final section has ${currentSection.points.length} points`);
          notes.push(currentSection);
        }

        console.log('===== EXTRACTION COMPLETE =====');
        console.log('Total sections extracted:', notes.length);

        // Log complete structure
        console.log('\n===== FINAL STRUCTURE BEING RETURNED =====');
        console.log('Title:', title);
        console.log('Learning Objectives (' + learningObjectives.length + '):');
        learningObjectives.forEach((lo, i) => {
          console.log(`  LO ${i + 1}: "${lo}"`);
        });
        console.log('\nSections (' + notes.length + '):');
        notes.forEach((section, i) => {
          console.log(`\nSection ${i + 1}: "${section.section}"`);
          console.log(`  Points (${section.points.length}):`);
          section.points.forEach((point, j) => {
            console.log(`    Point ${j + 1}: "${point.substring(0, 100)}${point.length > 100 ? '...' : ''}"`);
          });
        });
        console.log('===== PDF IMPORT COMPLETED =====\n');

        return { title, learningObjectives, notes };
      };

      // PDF Import Handler
      const handleImportPDF = async (e) => {
        const file = e.target.files?.[0];
        if (!file) return;

        // Confirm replacement
        if (notes?.notes?.length > 0) {
          const confirmed = window.confirm(
            'Import will replace all existing notes. Continue?'
          );
          if (!confirmed) {
            e.target.value = ''; // Reset file input
            return;
          }
        }

        try {
          setProcessing(true);
          setProcessingType('import');

          // Extract embedded JSON from PDF metadata or content (REQUIRED for import)
          let importedNotes = null;

          const arrayBuffer = await file.arrayBuffer();
          const pdf = await pdfjsLib.getDocument({ data: arrayBuffer }).promise;

          console.log('PDF loaded, pages:', pdf.numPages);

          const startDelimiter = '[EMBEDDED_NOTES_DATA_START]';
          const endDelimiter = '[EMBEDDED_NOTES_DATA_END]';

          // First try to get from PDF metadata (new method - no blank pages)
          const metadata = await pdf.getMetadata();
          const keywords = metadata?.info?.Keywords || '';
          console.log('PDF Keywords metadata length:', keywords.length);

          if (keywords.includes(startDelimiter)) {
            console.log('✅ Found embedded JSON in PDF metadata (keywords) - using lossless import');
            const startIndex = keywords.indexOf(startDelimiter);
            const endIndex = keywords.indexOf(endDelimiter);
            if (startIndex !== -1 && endIndex !== -1 && endIndex > startIndex) {
              const jsonStr = keywords.substring(startIndex + startDelimiter.length, endIndex).trim();
              importedNotes = JSON.parse(jsonStr);
            }
          }

          // Fall back to content extraction (old method for backwards compatibility)
          if (!importedNotes) {
            console.log('Trying content extraction fallback...');
            let allText = '';
            for (let pageNum = 1; pageNum <= pdf.numPages; pageNum++) {
              const page = await pdf.getPage(pageNum);
              const textContent = await page.getTextContent();
              const pageText = textContent.items.map(item => item.str).join('');
              allText += pageText;
            }

            console.log('Total text length:', allText.length);

            const startIndex = allText.indexOf(startDelimiter);
            const endIndex = allText.indexOf(endDelimiter);

            if (startIndex !== -1 && endIndex !== -1 && endIndex > startIndex) {
              console.log('✅ Found embedded JSON in PDF content - using lossless import');
              const jsonStr = allText.substring(startIndex + startDelimiter.length, endIndex).trim();
              importedNotes = JSON.parse(jsonStr);
            } else {
              // No embedded data found - cannot import
              console.log('No embedded JSON found in PDF content or metadata');
              throw new Error('NO_METADATA');
            }
          }

          // Validate structure
          if (!importedNotes || !importedNotes.title || !importedNotes.notes) {
            throw new Error('Invalid notes structure in PDF metadata');
          }

          // Update state
          console.log('\n===== IMPORTING FROM METADATA =====');
          console.log('Title:', importedNotes.title);
          console.log('LOs:', importedNotes.learningObjectives?.length || 0);
          console.log('Sections:', importedNotes.notes.length);

          // Extract and restore point and section images if present
          if (importedNotes._pointImages || importedNotes._sectionImages || importedNotes._imageReferences) {
            if (importedNotes._pointImages) {
              console.log('Restoring point images:', Object.keys(importedNotes._pointImages).length);
              setPointImages(importedNotes._pointImages);
            }
            if (importedNotes._sectionImages) {
              console.log('Restoring section images:', Object.keys(importedNotes._sectionImages).length);
              setSectionImages(importedNotes._sectionImages);
            }
            if (importedNotes._imageReferences) {
              console.log('Restoring image references:', Object.keys(importedNotes._imageReferences).length);
              setImageReferences(importedNotes._imageReferences);
            }
            // Remove image data from notes object before setting
            const { _pointImages, _sectionImages, _imageReferences, ...cleanNotes } = importedNotes;
            setNotes(cleanNotes);
          } else {
            setNotes(importedNotes);
          }

          // Set module abbreviation if selected
          if (importModuleAbbrev) {
            setModuleAbbrev(importModuleAbbrev);
          }

          // Success message
          setChatMessages(prev => [...prev, {
            role: 'assistant',
            content: `✅ PDF imported successfully!\n• ${importedNotes.notes.length} section(s)\n• ${importedNotes.learningObjectives?.length || 0} learning objective(s)${importModuleAbbrev ? `\n• Module: ${importModuleAbbrev}` : ''}`
          }]);

          console.log('===== IMPORT COMPLETE =====\n');

        } catch (error) {
          console.error('PDF import error:', error);

          let errorMessage;
          if (error.message === 'NO_METADATA') {
            errorMessage = `⚠️ **This PDF cannot be imported**\n\nThis PDF doesn't contain embedded metadata and cannot be imported reliably.\n\n**Solution:** Please re-export your notes using the latest version of this tool, then try importing again.\n\n*Note: Only PDFs exported from version 3.0+ (with embedded metadata) can be imported.*`;
          } else {
            errorMessage = `❌ Import failed: ${error.message}\n\nPlease ensure you're uploading a PDF that was previously exported from this tool.`;
          }

          setChatMessages(prev => [...prev, {
            role: 'assistant',
            content: errorMessage
          }]);
        } finally {
          setProcessing(false);
          setProcessingType('');
          e.target.value = ''; // Reset file input
        }
      };

      const handleImportCSV = async (e) => {
        const file = e.target.files?.[0];
        if (!file) return;

        // Store the file and show modal to get module/lecture info
        setPendingCsvFile(file);
        setCsvImportModule('');
        setCsvImportLectureTitle('');
        setCsvImportCustomTag('');
        setShowCsvImportModal(true);
        e.target.value = ''; // Reset file input
      };

      const processCsvImport = async () => {
        if (!pendingCsvFile) return;

        // Confirm replacement if cards exist
        if (cards.length > 0) {
          const confirmed = window.confirm(
            'Import will replace all existing flashcards. Continue?'
          );
          if (!confirmed) {
            setShowCsvImportModal(false);
            setPendingCsvFile(null);
            return;
          }
        }

        try {
          const text = await pendingCsvFile.text();
          const lines = text.split('\n').filter(line => line.trim());

          // Skip header row if it looks like a header
          const startIndex = lines[0]?.toLowerCase().includes('front') || lines[0]?.toLowerCase().includes('question') ? 1 : 0;

          // Use custom tag if provided, otherwise generate from module and lecture title
          let newTag = '';
          if (csvImportCustomTag.trim()) {
            newTag = csvImportCustomTag.trim();
          } else if (csvImportModule || csvImportLectureTitle) {
            const lectureWords = csvImportLectureTitle.split(/[\s_\-\.]+/).filter(word => word.length > 0);
            const lectureName = lectureWords.map(word => word.charAt(0).toUpperCase() + word.slice(1)).join('');
            newTag = csvImportModule ? `Day2 ${csvImportModule}_${lectureName || 'Lecture'}` : (lectureName ? `Day2 ${lectureName}` : '');
          }

          const importedCards = [];
          for (let i = startIndex; i < lines.length; i++) {
            const line = lines[i];
            // Parse CSV - handle quoted fields with commas
            const matches = line.match(/("(?:[^"\\]|\\.)*"|[^,]*),("(?:[^"\\]|\\.)*"|[^,]*),?(.*)?/);
            if (matches) {
              let front = matches[1]?.replace(/^"|"$/g, '').replace(/""/g, '"').trim();
              let back = matches[2]?.replace(/^"|"$/g, '').replace(/""/g, '"').trim();
              // Use new tag if provided, otherwise keep original tag
              let tags = newTag || matches[3]?.replace(/^"|"$/g, '').replace(/""/g, '"').trim() || '';

              if (front && back) {
                importedCards.push({ front, back, tags });
              }
            }
          }

          if (importedCards.length === 0) {
            throw new Error('No valid flashcards found in CSV');
          }

          // Update module and lecture tag state
          if (csvImportModule) setModuleAbbrev(csvImportModule);
          if (csvImportLectureTitle) setLectureTag(csvImportLectureTitle);

          setCards(importedCards);
          setActiveTab('cards');
          setShowCsvImportModal(false);
          setPendingCsvFile(null);
          setChatMessages(prev => [...prev, {
            role: 'assistant',
            content: `✅ CSV imported successfully!\n• ${importedCards.length} flashcard(s) imported${csvImportModule ? `\n• Module: ${csvImportModule}` : ''}${csvImportLectureTitle ? `\n• Lecture: ${csvImportLectureTitle}` : ''}`
          }]);

        } catch (error) {
          console.error('CSV import error:', error);
          setShowCsvImportModal(false);
          setPendingCsvFile(null);
          setChatMessages(prev => [...prev, {
            role: 'assistant',
            content: `❌ Import failed: ${error.message}\n\nExpected CSV format: Front,Back,Tags (one card per line)`
          }]);
        } finally {
          e.target.value = '';
        }
      };

      const exportPDF = () => {
        console.log('===== PDF EXPORT STARTED (pdfmake) =====');
        if (!notes) return;

        // Helper function to parse HTML/markdown text into pdfmake text array
        const parseText = (text) => {
          if (!text) return '';
          let str = String(text);

          // Convert <br>, <div>, and <blockquote> tags to newlines to preserve line breaks
          str = str.replace(/<br\s*\/?>/gi, '\n');
          str = str.replace(/<div[^>]*>/gi, '\n');
          str = str.replace(/<\/div>/gi, '');
          str = str.replace(/<blockquote[^>]*>/gi, '\n');
          str = str.replace(/<\/blockquote>/gi, '');

          // Convert <b> and <strong> tags to markdown bold syntax BEFORE removing HTML tags
          str = str.replace(/<(b|strong)>(.*?)<\/(b|strong)>/gi, '**$2**');

          // Decode HTML entities
          const decodeEntities = (txt) => {
            const entities = {
              '&nbsp;': ' ', '&amp;': '&', '&lt;': '<', '&gt;': '>',
              '&quot;': '"', '&#39;': "'", '&apos;': "'",
              '&alpha;': 'α', '&beta;': 'β', '&gamma;': 'γ', '&delta;': 'δ',
              '&epsilon;': 'ε', '&theta;': 'θ', '&lambda;': 'λ', '&mu;': 'μ',
              '&pi;': 'π', '&sigma;': 'σ', '&tau;': 'τ', '&phi;': 'φ', '&omega;': 'ω',
              '&rarr;': '→', '&larr;': '←', '&uarr;': '↑', '&darr;': '↓',
              '&le;': '≤', '&ge;': '≥', '&ne;': '≠',
              '&deg;': '°', '&plusmn;': '±', '&times;': '×', '&divide;': '÷'
            };
            let result = txt;
            for (const [entity, char] of Object.entries(entities)) {
              result = result.split(entity).join(char);
            }
            return result;
          };

          str = decodeEntities(str);

          // Remove HTML tags but preserve their content
          str = str.replace(/<[^>]+>/g, '');

          // Parse **bold** syntax into pdfmake text array while preserving newlines
          const textArray = [];
          const boldRegex = /\*\*(.+?)\*\*/g;
          let lastIndex = 0;
          let match;

          while ((match = boldRegex.exec(str)) !== null) {
            // Add text before the bold part (preserve newlines in the text itself)
            if (match.index > lastIndex) {
              const normalText = str.substring(lastIndex, match.index);
              if (normalText) textArray.push({ text: normalText });
            }
            // Add the bold part
            textArray.push({ text: match[1], bold: true });
            lastIndex = match.index + match[0].length;
          }

          // Add remaining text after last bold (preserve newlines in the text itself)
          if (lastIndex < str.length) {
            const remainingText = str.substring(lastIndex);
            if (remainingText) textArray.push({ text: remainingText });
          }

          return textArray.length > 0 ? textArray : str;
        };

        // Helper function to recursively parse nested HTML lists
        const parseNestedList = (html, depth = 0) => {
          const items = [];
          const tempDiv = document.createElement('div');
          tempDiv.innerHTML = html;

          // Get the top-level ul/ol
          const topList = tempDiv.querySelector('ul, ol');
          if (!topList) return items;

          // Process direct children of the list
          const children = Array.from(topList.childNodes);

          // Check if there are any LI elements at this level
          const hasListItems = children.some(child => child.nodeName === 'LI');

          // If no LI elements but there are nested UL/OL, parse those directly
          if (!hasListItems) {
            children.forEach(child => {
              if (child.nodeName === 'UL' || child.nodeName === 'OL') {
                const nestedItems = parseNestedList(child.outerHTML, depth);
                items.push(...nestedItems);
              }
            });
            return items;
          }

          let i = 0;
          while (i < children.length) {
            const child = children[i];

            if (child.nodeName === 'LI') {
              // Get text content of this li
              let textContent = '';
              for (let node of child.childNodes) {
                if (node.nodeType === Node.TEXT_NODE) {
                  textContent += node.textContent;
                } else if (node.nodeName !== 'UL' && node.nodeName !== 'OL') {
                  textContent += node.textContent;
                }
              }
              textContent = textContent.trim();

              // Check for nested list INSIDE this li
              const nestedListInside = child.querySelector('ul, ol');

              // Check for nested list as NEXT SIBLING (malformed HTML case)
              let nestedListSibling = null;
              if (i + 1 < children.length) {
                const nextChild = children[i + 1];
                if (nextChild.nodeName === 'UL' || nextChild.nodeName === 'OL') {
                  nestedListSibling = nextChild;
                }
              }

              const nestedList = nestedListInside || nestedListSibling;

              if (nestedList) {
                // Has nested list
                const nestedItems = parseNestedList(nestedList.outerHTML, depth + 1);
                // Add dash prefix for nested items (depth > 0)
                const parsedText = parseText(textContent);
                const textContent_formatted = depth > 0
                  ? (Array.isArray(parsedText) ? [{ text: '- ' }, ...parsedText] : [{ text: '- ' }, { text: parsedText }])
                  : parsedText;
                items.push({
                  stack: [
                    { text: textContent_formatted, style: 'bullet' },
                    { ul: nestedItems, margin: [15, 2, 0, 0], type: 'none', markerColor: 'transparent' }
                  ]
                });

                // Skip the sibling nested list if we used it
                if (nestedListSibling && !nestedListInside) {
                  i++; // Skip next element since we already processed it
                }
              } else if (textContent) {
                // Regular item - add dash prefix for nested items (depth > 0)
                if (depth > 0) {
                  const parsedText = parseText(textContent);
                  const textWithDash = Array.isArray(parsedText)
                    ? [{ text: '- ' }, ...parsedText]
                    : [{ text: '- ' }, { text: parsedText }];
                  items.push({
                    text: textWithDash,
                    style: 'bullet'
                  });
                } else {
                  items.push({
                    text: parseText(textContent),
                    style: 'bullet'
                  });
                }
              }
            }

            i++;
          }

          return items;
        };

        // Helper function to parse non-list HTML content and preserve indentation
        const parseNonListContent = (html) => {
          if (!html || !html.trim()) return [];

          const items = [];
          const tempDiv = document.createElement('div');
          tempDiv.innerHTML = html;

          // Process all child nodes with accumulated margin for nested blockquotes
          const processNode = (node, accumulatedMargin = 0) => {
            if (node.nodeName === 'DIV') {
              // Process all children of the div
              Array.from(node.childNodes).forEach(child => {
                if (child.nodeName === 'BLOCKQUOTE') {
                  // Extract indentation from blockquote style
                  const style = child.getAttribute('style') || '';
                  let leftMargin = 0;

                  // Try margin-left first (e.g., "margin-left: 40px")
                  let marginMatch = style.match(/margin-left:\s*(\d+)px/);
                  if (marginMatch) {
                    leftMargin = parseInt(marginMatch[1]);
                  } else {
                    // Try shorthand margin (e.g., "margin: 0 0 0 40px")
                    marginMatch = style.match(/margin:\s*[^;]*?(\d+)px/);
                    if (marginMatch) {
                      leftMargin = parseInt(marginMatch[1]);
                    }
                  }
                  console.log('[parseNonListContent] Found blockquote with margin:', leftMargin, 'accumulated:', accumulatedMargin, 'total:', accumulatedMargin + leftMargin);

                  // Check if blockquote contains nested blockquotes (at any depth)
                  const hasNestedBlockquote = child.querySelector('blockquote') !== null;

                  if (hasNestedBlockquote) {
                    // Process nested blockquotes with accumulated margin
                    Array.from(child.childNodes).forEach(nestedChild => {
                      processNode(nestedChild, accumulatedMargin + leftMargin);
                    });
                  } else {
                    // No nested blockquotes, extract text with total margin
                    const text = parseText(child.textContent.trim());
                    if (text) {
                      console.log('[parseNonListContent] Creating text item with margin:', accumulatedMargin + leftMargin, 'text:', text.substring ? text.substring(0, 50) : text);
                      items.push({
                        text: text,
                        margin: [accumulatedMargin + leftMargin, 2, 0, 2],
                        fontSize: 11
                      });
                    }
                  }
                } else if (child.nodeName === 'UL' || child.nodeName === 'OL') {
                  // List element - parse as bullets
                  console.log('[parseNonListContent] Found list element, parsing with parseNestedList');
                  const listItems = parseNestedList(child.outerHTML);
                  console.log('[parseNonListContent] List items parsed:', listItems.length);
                  // Add list items with accumulated margin
                  if (listItems.length > 0) {
                    if (accumulatedMargin > 0) {
                      // Wrap in structure with margin
                      items.push({
                        ul: listItems,
                        margin: [accumulatedMargin, 2, 0, 2]
                      });
                    } else {
                      // Add directly
                      items.push({ ul: listItems });
                    }
                  }
                } else if (child.nodeName === 'DIV') {
                  // Nested div - process recursively with same margin
                  processNode(child, accumulatedMargin);
                } else if (child.nodeType === Node.TEXT_NODE) {
                  // Text node
                  const text = parseText(child.textContent.trim());
                  if (text) {
                    items.push({
                      text: text,
                      margin: [accumulatedMargin, 2, 0, 2],
                      fontSize: 11
                    });
                  }
                } else if (child.nodeType === Node.ELEMENT_NODE) {
                  // Other element - get text content
                  const text = parseText(child.textContent.trim());
                  if (text) {
                    items.push({
                      text: text,
                      margin: [accumulatedMargin, 2, 0, 2],
                      fontSize: 11
                    });
                  }
                }
              });
            } else if (node.nodeName === 'BLOCKQUOTE') {
              // Blockquote node
              const style = node.getAttribute('style') || '';
              let leftMargin = 0;

              // Try margin-left first (e.g., "margin-left: 40px")
              let marginMatch = style.match(/margin-left:\s*(\d+)px/);
              if (marginMatch) {
                leftMargin = parseInt(marginMatch[1]);
              } else {
                // Try shorthand margin (e.g., "margin: 0 0 0 40px")
                marginMatch = style.match(/margin:\s*[^;]*?(\d+)px/);
                if (marginMatch) {
                  leftMargin = parseInt(marginMatch[1]);
                }
              }
              console.log('[parseNonListContent] Found top-level blockquote with margin:', leftMargin, 'accumulated:', accumulatedMargin, 'total:', accumulatedMargin + leftMargin);

              // Check if blockquote contains nested blockquotes (at any depth)
              const hasNestedBlockquote = node.querySelector('blockquote') !== null;

              if (hasNestedBlockquote) {
                // Process nested blockquotes with accumulated margin
                Array.from(node.childNodes).forEach(child => {
                  processNode(child, accumulatedMargin + leftMargin);
                });
              } else {
                // No nested blockquotes, extract text with total margin
                const text = parseText(node.textContent.trim());
                if (text) {
                  items.push({
                    text: text,
                    margin: [accumulatedMargin + leftMargin, 2, 0, 2],
                    fontSize: 11
                  });
                }
              }
            } else if (node.nodeName === 'UL' || node.nodeName === 'OL') {
              // Top-level list element - parse as bullets
              console.log('[parseNonListContent] Found top-level list element');
              const listItems = parseNestedList(node.outerHTML);
              console.log('[parseNonListContent] Top-level list items parsed:', listItems.length);
              if (listItems.length > 0) {
                if (accumulatedMargin > 0) {
                  items.push({
                    ul: listItems,
                    margin: [accumulatedMargin, 2, 0, 2]
                  });
                } else {
                  items.push({ ul: listItems });
                }
              }
            } else if (node.nodeType === Node.TEXT_NODE) {
              // Plain text node
              const text = parseText(node.textContent.trim());
              if (text) {
                items.push({
                  text: text,
                  margin: [accumulatedMargin, 2, 0, 2],
                  fontSize: 11
                });
              }
            }
          };

          // Process all top-level children
          Array.from(tempDiv.childNodes).forEach(node => processNode(node, 0));

          return items;
        };

        // Build pdfmake document definition
        const docDefinition = {
          pageSize: 'A4',
          pageMargins: [40, 40, 40, 40],
          defaultStyle: {
            font: 'NotoSans',
            fontSize: 11
          },
          content: [],
          styles: {
            title: {
              fontSize: 18,
              bold: true,
              color: '#365F91',
              margin: [0, 0, 0, 12]
            },
            sectionHeader: {
              fontSize: 13,
              bold: true,
              color: '#4F81BD',
              margin: [0, 8, 0, 4]
            },
            objectivesHeader: {
              fontSize: 13,
              bold: true,
              color: '#4F81BD',
              margin: [0, 0, 0, 6]
            },
            bullet: {
              fontSize: 11,
              margin: [0, 2, 0, 2]
            },
            objectiveBullet: {
              fontSize: 11,
              margin: [0, 1, 0, 1]
            }
          },
          // Embed original notes JSON in PDF metadata for lossless import
          info: {
            title: notes.title || 'Lecture Notes',
            author: 'Lecture Revision Tool',
            subject: 'Concise Lecture Notes',
            // Embed the full notes structure as a custom metadata field
            // This allows perfect round-trip import/export
            notesJSON: JSON.stringify(notes)
          }
        };

        // Add title
        docDefinition.content.push({
          text: (notes.title || 'Lecture Notes') + ' (Concise Notes)',
          style: 'title'
        });

        // Add learning objectives section
        if (notes.learningObjectives && notes.learningObjectives.length > 0) {
          docDefinition.content.push({
            text: 'Learning Objectives',
            style: 'objectivesHeader'
          });

          const objectivesList = {
            ul: notes.learningObjectives.map(obj => ({
              text: parseText(obj),
              style: 'objectiveBullet'
            })),
            margin: [0, 0, 0, 8]
          };
          docDefinition.content.push(objectivesList);
        }

        // Global figure counter for the entire document
        let figureCounter = 0;

        // Add notes sections
        if (notes.notes && notes.notes.length > 0) {
          notes.notes.forEach((section, idx) => {
            // Store section index for image lookup (must be outside if block for section images)
            const sectionIndex = idx;

            // Collect all images for this section with their figure numbers
            // Order: section title image first, then point images (top-to-bottom)
            const sectionFigures = [];

            // Check for section-level image FIRST (appears at section title)
            const sectionImg = getSectionImage(sectionIndex);
            if (sectionImg && sectionImg.dataUrl) {
              figureCounter++;
              sectionFigures.push({ figNum: figureCounter, image: sectionImg, type: 'section' });
            }

            // Then check for point images
            if (section.points) {
              section.points.forEach((_, pIdx) => {
                const img = getPointImage(sectionIndex, pIdx);
                if (img && img.dataUrl) {
                  figureCounter++;
                  sectionFigures.push({ figNum: figureCounter, image: img, type: 'point', pointIndex: pIdx });
                }
              });
            }

            // Get section figure reference if exists
            const sectionFigure = sectionFigures.find(f => f.type === 'section');

            // Section header with figure reference (fig ref in purple, smaller, not bold)
            if (sectionFigure) {
              docDefinition.content.push({
                text: [
                  { text: parseText(section.section || `Section ${idx + 1}`), style: 'sectionHeader' },
                  { text: ` (Fig ${sectionFigure.figNum})`, fontSize: 9, color: '#8B5CF6', bold: false }
                ],
                style: 'sectionHeader',
                margin: [0, 8, 0, 4]
              });
            } else {
              docDefinition.content.push({
                text: parseText(section.section || `Section ${idx + 1}`),
                style: 'sectionHeader'
              });
            }

            // Section points as bullets
            if (section.points && section.points.length > 0) {
              // Process points: create main bullets with indented sub-bullets for newlines
              const processedPoints = [];
              section.points.forEach((point, pointIdx) => {
                const idx = pointIdx; // Keep original variable name for compatibility
                console.log(`\n=== Processing point ${idx} ===`);
                console.log('Point content:', point);
                console.log('Contains div:', point.includes('<div'));
                console.log('Contains blockquote:', point.includes('<blockquote'));
                console.log('Contains br:', point.includes('<br>'));
                console.log('Contains ul/li:', point.includes('<ul>') || point.includes('<li>'));

                // Check if this point has a figure reference to add (primary or referenced)
                const pointFigure = sectionFigures.find(f => f.type === 'point' && f.pointIndex === pointIdx);
                let figRef = '';
                if (pointFigure) {
                  figRef = ` (Fig ${pointFigure.figNum})`;
                } else {
                  // Check if this point references another image
                  const refKey = getImageReference(sectionIndex, pointIdx);
                  if (refKey) {
                    const [refS, refP] = refKey.split('-').map(Number);
                    // Find the figure number from all collected figures
                    const refFigNum = getFigureNumber(refS, refP, 'point');
                    if (refFigNum) {
                      figRef = ` (Fig ${refFigNum})`;
                    }
                  }
                }

                // Check if point contains div, blockquote, br, or list tags - create sub-bullets
                if (typeof point === 'string' && (point.includes('<div') || point.includes('<blockquote') || point.includes('<br>') || point.includes('<br/>') || point.includes('<br />') || point.includes('<ul>') || point.includes('<li>'))) {

                  // Check if point contains UL/LI tags - parse as HTML list directly
                  if (point.includes('<ul>') || point.includes('<li>')) {
                    console.log('Point contains HTML lists, parsing directly');

                    // Use DOM to properly extract list and remaining content
                    const tempDiv = document.createElement('div');
                    const ulIndex = point.indexOf('<ul');

                    let mainText = '';
                    let remainingContent = '';

                    if (ulIndex > 0) {
                      mainText = point.substring(0, ulIndex).trim() + figRef;
                      tempDiv.innerHTML = point.substring(ulIndex);
                    } else {
                      tempDiv.innerHTML = point;
                    }

                    // Extract the UL element
                    const ulElement = tempDiv.querySelector('ul');
                    let actualListHtml = '';

                    if (ulElement) {
                      actualListHtml = ulElement.outerHTML;
                      // Remove UL and get remaining HTML
                      ulElement.remove();
                      remainingContent = tempDiv.innerHTML.trim();
                    }

                    console.log('Main text:', mainText);
                    console.log('List HTML:', actualListHtml);
                    console.log('Remaining content:', remainingContent);

                    // Parse the list
                    const nestedItems = parseNestedList(actualListHtml);
                    console.log('Nested items parsed:', nestedItems.length);

                    // Parse remaining content as additional text (preserving indentation, no bullets)
                    const remainingItems = parseNonListContent(remainingContent);
                    console.log('Remaining items parsed:', remainingItems.length);

                    // Check if main text contains indentation (div/blockquote tags)
                    const mainTextHasIndentation = mainText && (mainText.includes('<div') || mainText.includes('<blockquote'));
                    console.log('Main text has indentation:', mainTextHasIndentation);

                    const mainTextItems = mainTextHasIndentation ? parseNonListContent(mainText) : null;
                    if (mainTextHasIndentation) {
                      console.log('Main text items parsed:', mainTextItems.length, mainTextItems);
                    }

                    // Build the output structure
                    if (mainText && nestedItems.length > 0) {
                      // Main text with sub-bullets and optional remaining content
                      let stackContent;

                      if (mainTextHasIndentation) {
                        // Main text has indentation, use parsed items
                        console.log('Using mainTextItems for indented content');
                        stackContent = [
                          ...mainTextItems,
                          { ul: nestedItems, margin: [15, 2, 0, 0] }
                        ];
                      } else {
                        // Simple main text, use parseText
                        console.log('Using parseText for simple main text');
                        stackContent = [
                          { text: parseText(mainText), style: 'bullet' },
                          { ul: nestedItems, margin: [15, 2, 0, 0] }
                        ];
                      }
                      console.log('Stack content:', stackContent);

                      // Add remaining content items (plain text, no bullets)
                      if (remainingItems.length > 0) {
                        stackContent.push(...remainingItems);
                      }

                      processedPoints.push({ stack: stackContent });
                    } else if (nestedItems.length > 0) {
                      // Only sub-bullets, no main text
                      if (remainingItems.length > 0) {
                        // Wrap bullets and remaining content in a stack
                        processedPoints.push({
                          stack: [
                            { ul: nestedItems, margin: [0, 0, 0, 0] },
                            ...remainingItems
                          ]
                        });
                      } else {
                        processedPoints.push(...nestedItems);
                      }
                    } else if (mainText) {
                      // Only main text, no sub-bullets parsed
                      if (mainTextHasIndentation) {
                        // Main text has indentation
                        if (remainingItems.length > 0) {
                          processedPoints.push({
                            stack: [
                              ...mainTextItems,
                              ...remainingItems
                            ]
                          });
                        } else {
                          if (mainTextItems.length === 1) {
                            processedPoints.push(mainTextItems[0]);
                          } else {
                            processedPoints.push({ stack: mainTextItems });
                          }
                        }
                      } else {
                        // Simple main text
                        if (remainingItems.length > 0) {
                          processedPoints.push({
                            stack: [
                              { text: parseText(mainText), style: 'bullet' },
                              ...remainingItems
                            ]
                          });
                        } else {
                          processedPoints.push({
                            text: parseText(mainText),
                            style: 'bullet'
                          });
                        }
                      }
                    } else if (remainingItems.length > 0) {
                      // Only remaining text (plain text, no bullets)
                      if (remainingItems.length === 1) {
                        processedPoints.push(remainingItems[0]);
                      } else {
                        processedPoints.push({ stack: remainingItems });
                      }
                    }

                    return; // Skip the rest of the processing for this point
                  }

                  // Point contains div/blockquote but no ul/li - treat as plain text without bullets
                  console.log('Processing point with div/blockquote (no ul/li)');

                  // Find the first div or blockquote tag to split main text from additional content
                  const divIndex = point.search(/<(div|blockquote)/i);

                  if (divIndex > 0) {
                    // Has main text before div/blockquote - add figure reference
                    const mainText = point.substring(0, divIndex).trim() + figRef;
                    const additionalContent = point.substring(divIndex);

                    console.log('Main text:', mainText);
                    console.log('Additional content:', additionalContent);

                    // Parse additional content as plain text (no bullets, preserve indentation)
                    const plainTextItems = parseNonListContent(additionalContent);
                    console.log('Plain text items parsed:', plainTextItems.length);

                    if (plainTextItems.length > 0) {
                      // Create stack with main text and plain text items
                      processedPoints.push({
                        stack: [
                          { text: parseText(mainText), style: 'bullet' },
                          ...plainTextItems
                        ]
                      });
                    } else {
                      // Only main text
                      processedPoints.push({
                        text: parseText(mainText),
                        style: 'bullet'
                      });
                    }
                  } else {
                    // No main text before div/blockquote, all content is plain text - add figure ref to first item
                    const plainTextItems = parseNonListContent(point + figRef);
                    console.log('All plain text items parsed:', plainTextItems.length);

                    if (plainTextItems.length > 0) {
                      if (plainTextItems.length === 1) {
                        processedPoints.push(plainTextItems[0]);
                      } else {
                        processedPoints.push({ stack: plainTextItems });
                      }
                    }
                  }
                } else {
                  // No newlines, treat as regular bullet - add figure reference if image exists
                  if (pointFigure) {
                    // Create text array with styled figure reference
                    const parsedText = parseText(point);
                    const textArray = Array.isArray(parsedText) ? parsedText : [{ text: parsedText }];
                    textArray.push({ text: ` (Fig ${pointFigure.figNum})`, fontSize: 9, color: '#8B5CF6' });
                    processedPoints.push({
                      text: textArray,
                      style: 'bullet'
                    });
                  } else {
                    processedPoints.push({
                      text: parseText(point),
                      style: 'bullet'
                    });
                  }
                }
              });

              // Add the bullet points
              const pointsList = {
                ul: processedPoints,
                margin: [0, 0, 0, 6]
              };
              docDefinition.content.push(pointsList);

              // After bullets, render image grid if there are figures in this section
              if (sectionFigures.length > 0) {
                // Helper to calculate image dimensions for grid (2 per row)
                // Use smaller max height to help images fit on pages better
                const calcGridImageSize = (image, shrinkFactor = 1) => {
                  const maxW = 220 * shrinkFactor; // ~half of content width minus gap
                  const maxH = 180 * shrinkFactor; // Reduced from 210 to help fit on pages
                  let w = image.width || maxW;
                  let h = image.height || maxH;
                  if (w > maxW) { const s = maxW / w; w = maxW; h = h * s; }
                  if (h > maxH) { const s = maxH / h; h = maxH; w = w * s; }
                  return { width: w, height: h };
                };

                // Create image grid (2 per row)
                const imageRows = [];
                for (let fi = 0; fi < sectionFigures.length; fi += 2) {
                  const row = [];

                  // First image in row
                  const fig1 = sectionFigures[fi];
                  const size1 = calcGridImageSize(fig1.image);
                  const slideNum1 = fig1.image.pageNum || '?';
                  row.push({
                    stack: [
                      { image: fig1.image.dataUrl, width: size1.width, height: size1.height },
                      { text: `Fig ${fig1.figNum}, Slide ${slideNum1}`, fontSize: 9, color: '#8B5CF6', margin: [0, 2, 0, 0], alignment: 'center' }
                    ],
                    width: '*'
                  });

                  // Second image in row (if exists)
                  if (fi + 1 < sectionFigures.length) {
                    const fig2 = sectionFigures[fi + 1];
                    const size2 = calcGridImageSize(fig2.image);
                    const slideNum2 = fig2.image.pageNum || '?';
                    row.push({
                      stack: [
                        { image: fig2.image.dataUrl, width: size2.width, height: size2.height },
                        { text: `Fig ${fig2.figNum}, Slide ${slideNum2}`, fontSize: 9, color: '#8B5CF6', margin: [0, 2, 0, 0], alignment: 'center' }
                      ],
                      width: '*'
                    });
                  } else {
                    // Empty cell to maintain layout
                    row.push({ text: '', width: '*' });
                  }

                  imageRows.push({
                    columns: row,
                    columnGap: 15,
                    margin: [0, 5, 0, 5]
                  });
                }

                // Add image grid with unbreakable constraint to avoid page breaks inside
                docDefinition.content.push({
                  stack: imageRows,
                  unbreakable: sectionFigures.length <= 4, // Only unbreakable for small grids
                  margin: [0, 8, 0, 12]
                });
              }
            }
          });
        }

        // Also embed image data in the notes JSON for lossless import
        const notesWithImages = {
          ...notes,
          _pointImages: pointImages,
          _sectionImages: sectionImages,
          _imageReferences: imageReferences
        };

        // CRITICAL: Embed JSON data in PDF metadata for lossless import (including images)
        // Store in the 'keywords' metadata field which supports longer strings
        docDefinition.info.keywords = `[EMBEDDED_NOTES_DATA_START]${JSON.stringify(notesWithImages)}[EMBEDDED_NOTES_DATA_END]`;

        console.log('Embedded notes JSON in PDF metadata (keywords field)');

        // Generate and open PDF in new tab
        try {
          const pdfDocGenerator = pdfMake.createPdf(docDefinition);
          const filename = `${lectureTag || 'lecture_notes'}_notes.pdf`;
          pdfDocGenerator.open();
          console.log('PDF opened in new tab:', filename);
        } catch (error) {
          console.error('PDF generation failed:', error);
          alert('Failed to generate PDF: ' + error.message);
        }
      };

      const exportCSV = () => {
        const csv = 'Front,Back,Tags\n' + cards.map(c => {
          // If card has an image, append it to the back as an img tag
          let backContent = c.back;
          if (c.image && c.image.dataUrl) {
            backContent += `<br><br><img src="${c.image.dataUrl}" style="max-width:300px;max-height:250px;">`;
          }
          return `"${c.front.replace(/"/g,'""')}","${backContent.replace(/"/g,'""')}","${c.tags}"`;
        }).join('\n');
        const a = document.createElement('a'); a.href = URL.createObjectURL(new Blob([csv], {type:'text/csv'})); a.download = `${lectureTag}_anki.csv`; a.click();
      };

      // Card editing functions
      const startEditCard = (index) => {
        const card = cards[index];
        // Check if it's an occlusion card with editable metadata
        if (card.occlusionData) {
          setEditingOcclusionCard({
            index,
            originalImage: card.occlusionData.originalImage,
            label: { ...card.occlusionData.label },
            questionText: card.occlusionData.questionText,
            explanation: card.occlusionData.explanation
          });
        } else if (card.interpretationData) {
          // Open interpretation card edit modal
          setEditingInterpretationCard({
            index,
            imageDataUrl: card.interpretationData.imageDataUrl,
            question: card.interpretationData.question,
            answer: card.interpretationData.answer
          });
        } else {
          setEditingCard({ index, front: card.front, back: card.back });
          setExpandedCards(p => ({ ...p, [index]: true }));
        }
      };

      const saveEditCard = () => {
        if (!editingCard) return;
        const updated = [...cards];
        updated[editingCard.index] = { ...updated[editingCard.index], front: editingCard.front, back: editingCard.back };
        setCards(updated);
        setEditingCard(null);
      };

      const saveOcclusionCardEdit = async () => {
        if (!editingOcclusionCard) return;
        const { index, originalImage, label, questionText, explanation } = editingOcclusionCard;

        // Regenerate masked image with new label position
        const maskedDataUrl = await createMaskedImage(originalImage, label);

        // Update the card
        const updated = [...cards];
        updated[index] = {
          ...updated[index],
          front: `<img src="${maskedDataUrl}" style="max-width:400px;"><br><br>${questionText}`,
          back: `<b>${label.text}</b><br><br>${explanation}<br><br><img src="${originalImage}" style="max-width:300px;">`,
          occlusionData: {
            originalImage,
            label: { ...label },
            questionText,
            explanation
          }
        };
        setCards(updated);
        setEditingOcclusionCard(null);
        setEditOcclusionDragging(null);
        setEditOcclusionResizing(null);
      };

      const deleteCard = (index) => {
        setCards(cards.filter((_, i) => i !== index));
        setExpandedCards({});
      };

      const addCard = () => {
        if (!newCard.front.trim() || !newCard.back.trim()) return;
        const tagSource = lectureTag || notes?.title || 'Lecture';
        const lectureWords = tagSource.split(/[\s_\-\.]+/).filter(word => word.length > 0);
        const lectureName = lectureWords.map(word => word.charAt(0).toUpperCase() + word.slice(1)).join('');
        const moduleTag = moduleAbbrev ? `${moduleAbbrev}_${lectureName}` : lectureName;
        setCards([...cards, { front: newCard.front, back: newCard.back, tags: `Day2 ${moduleTag}` }]);
        setNewCard({ front: '', back: '' });
        setShowAddCard(false);
      };

      // Note editing functions
      const startEditPoint = (sectionIndex, pointIndex) => {
        // Convert <br> tags back to newlines for editing
        const value = String(notes.notes[sectionIndex].points[pointIndex]).replace(/<br\s*\/?>/gi, '\n');
        setEditingNote({ type: 'point', sectionIndex, pointIndex, value });
      };

      const startEditSection = (sectionIndex) => {
        // Convert <br> tags back to newlines for editing
        const value = String(notes.notes[sectionIndex].section).replace(/<br\s*\/?>/gi, '\n');
        setEditingNote({ type: 'section', sectionIndex, value });
      };

      const startEditLO = (index) => {
        // Convert <br> tags back to newlines for editing
        const value = String(notes.learningObjectives[index]).replace(/<br\s*\/?>/gi, '\n');
        setEditingNote({ type: 'lo', index, value });
      };

      const saveNoteEdit = () => {
        if (!editingNote || !notes) return;
        const updated = JSON.parse(JSON.stringify(notes)); // deep clone

        console.log('Saving note edit. Original value:', editingNote.value);

        // Don't convert newlines to <br> if the content already has HTML structure
        let processedValue;
        if (editingNote.value.includes('<ul>') || editingNote.value.includes('<ol>') || editingNote.value.includes('<li>')) {
          // Keep HTML as-is for lists
          processedValue = editingNote.value;
          console.log('Content has HTML lists, keeping as-is');
        } else {
          // Convert newlines to <br> tags for plain text
          processedValue = editingNote.value.replace(/\n/g, '<br>');
          console.log('Plain text, converting newlines to <br>');
        }

        console.log('Processed value:', processedValue);

        if (editingNote.type === 'title') {
          updated.title = editingNote.value;
        } else if (editingNote.type === 'point') {
          updated.notes[editingNote.sectionIndex].points[editingNote.pointIndex] = processedValue;
        } else if (editingNote.type === 'section') {
          updated.notes[editingNote.sectionIndex].section = processedValue;
        } else if (editingNote.type === 'lo') {
          updated.learningObjectives[editingNote.index] = processedValue;
        }

        setNotes(updated);
        setEditingNote(null);
      };

      const deletePoint = (sectionIndex, pointIndex) => {
        const updated = JSON.parse(JSON.stringify(notes));
        updated.notes[sectionIndex].points.splice(pointIndex, 1);
        setNotes(updated);
      };

      const addPoint = (sectionIndex) => {
        const updated = JSON.parse(JSON.stringify(notes));
        updated.notes[sectionIndex].points.push('New point - click to edit');
        setNotes(updated);
        // Auto-start editing the new point
        setEditingNote({ type: 'point', sectionIndex, pointIndex: updated.notes[sectionIndex].points.length - 1, value: '' });
      };

      const deleteSection = (sectionIndex) => {
        const updated = JSON.parse(JSON.stringify(notes));
        updated.notes.splice(sectionIndex, 1);

        // Renumber all remaining sections
        updated.notes = updated.notes.map((section, index) => {
          if (section.section) {
            // Replace leading number with new index (handles formats like "1.", "1:", "1)", "1 -", etc.)
            const newSection = section.section.replace(/^\d+[\.\:\)\-]?\s*/, `${index + 1}. `);
            return { ...section, section: newSection };
          }
          return section;
        });

        setNotes(updated);
      };

      const addSection = () => {
        const updated = JSON.parse(JSON.stringify(notes));
        const newSectionNumber = updated.notes.length + 1;
        updated.notes.push({
          section: `${newSectionNumber}. New Section - click to edit`,
          points: ['New point - click to edit']
        });
        setNotes(updated);
        // Auto-start editing the new section title
        setTimeout(() => startEditSection(updated.notes.length - 1), 50);
      };

      // Drag and drop handlers for reordering points
      // Drag and drop for points
      const handleDragStart = (e, sectionIndex, pointIndex) => {
        e.dataTransfer.effectAllowed = 'move';
        e.dataTransfer.setData('text/plain', ''); // Empty string prevents Safari search
        setDraggedPoint({ sectionIndex, pointIndex });
      };

      const handleDragOver = (e) => {
        e.preventDefault(); // Allow drop
      };

      const handlePointDragOver = (e, sectionIndex, pointIndex) => {
        e.preventDefault();
        if (draggedPoint) {
          setDropTargetPoint({ sectionIndex, pointIndex });
        }
      };

      const handleSectionDragOver = (e, sectionIndex) => {
        e.preventDefault();
        if (draggedSection !== null) {
          setDropTargetSection(sectionIndex);
        }
      };

      const handleDragEnd = (e) => {
        e.preventDefault(); // Prevent Safari from treating as search
        setDraggedPoint(null);
        setDraggedSection(null);
        setDropTargetPoint(null);
        setDropTargetSection(null);
      };

      const handleDragLeave = (e) => {
        // Only clear if leaving the actual element (not entering a child)
        if (!e.currentTarget.contains(e.relatedTarget)) {
          setDropTargetPoint(null);
          setDropTargetSection(null);
        }
      };

      const handleDrop = (targetSectionIndex, targetPointIndex) => {
        if (!draggedPoint) return;

        // Same position in same section - no change needed
        if (draggedPoint.sectionIndex === targetSectionIndex && draggedPoint.pointIndex === targetPointIndex) return;

        const updated = JSON.parse(JSON.stringify(notes));
        const sourceSection = updated.notes[draggedPoint.sectionIndex];
        const targetSection = updated.notes[targetSectionIndex];

        // Remove from source section
        const [movedPoint] = sourceSection.points.splice(draggedPoint.pointIndex, 1);

        // Insert into target section
        // Adjust target index if moving within same section and source is before target
        let adjustedTargetIndex = targetPointIndex;
        if (draggedPoint.sectionIndex === targetSectionIndex && draggedPoint.pointIndex < targetPointIndex) {
          adjustedTargetIndex = targetPointIndex; // Already adjusted by splice
        }
        targetSection.points.splice(adjustedTargetIndex, 0, movedPoint);
        setNotes(updated);
        setDraggedPoint(null);
        setDropTargetPoint(null);
      };

      // Drag and drop for sections
      const handleSectionDragStart = (e, sectionIndex) => {
        e.dataTransfer.effectAllowed = 'move';
        e.dataTransfer.setData('text/plain', ''); // Empty string prevents Safari search
        setDraggedSection(sectionIndex);
      };

      const handleSectionDrop = (targetSectionIndex) => {
        if (draggedSection === null) return;
        if (draggedSection === targetSectionIndex) return; // Same position

        const updated = JSON.parse(JSON.stringify(notes));
        const [movedSection] = updated.notes.splice(draggedSection, 1);
        updated.notes.splice(targetSectionIndex, 0, movedSection);

        // Renumber all sections after reordering
        updated.notes = updated.notes.map((section, index) => {
          if (section.section) {
            // Replace leading number with new index (handles formats like "1.", "1:", "1)", "1 -", etc.)
            const newSection = section.section.replace(/^\d+[\.\:\)\-]?\s*/, `${index + 1}. `);
            return { ...section, section: newSection };
          }
          return section;
        });

        setNotes(updated);
        setDraggedSection(null);
        setDropTargetSection(null);
      };

      // Formatting functions for contentEditable
      const insertFormatting = (command) => {
        if (!textareaRef.current) return;

        // Set flag to prevent ref callback from interfering
        isFormattingRef.current = true;

        // Focus the editor first
        textareaRef.current.focus();

        const commandMap = {
          'bold': 'bold',
          'italic': 'italic',
          'underline': 'underline',
          'superscript': 'superscript',
          'subscript': 'subscript'
        };

        const execCmd = commandMap[command];
        if (execCmd) {
          const sel = window.getSelection();

          // For superscript/subscript, we need special handling
          if (execCmd === 'superscript' || execCmd === 'subscript') {
            const oppositeCmd = execCmd === 'superscript' ? 'subscript' : 'superscript';
            const oppositeTag = oppositeCmd === 'superscript' ? 'SUP' : 'SUB';
            const sameTag = execCmd === 'superscript' ? 'SUP' : 'SUB';
            const isCollapsed = sel.isCollapsed;

            // If no text is selected (collapsed cursor), toggle the formatting mode for future typing
            if (isCollapsed) {
              console.log(`[FORMAT] ${execCmd}: Toggling mode (no selection)`);

              // Check if we're currently in this formatting mode
              const wasActive = activeFormatting[execCmd];
              console.log(`[FORMAT] Was active: ${wasActive}`);

              // Update formatting state
              const newFormatting = { ...activeFormatting };

              // Turn off opposite
              newFormatting[oppositeCmd] = false;

              // Toggle same
              newFormatting[execCmd] = !newFormatting[execCmd];

              setActiveFormatting(newFormatting);
              console.log(`[FORMAT] New formatting state:`, newFormatting);

              // Check if cursor is currently inside a formatting tag
              let isInsideTag = false;
              let formattedNode = null;

              if (sel.rangeCount > 0) {
                const range = sel.getRangeAt(0);
                const container = range.commonAncestorContainer;
                let node = container.nodeType === Node.TEXT_NODE ? container.parentElement : container;

                while (node && node !== textareaRef.current) {
                  if (node.tagName === sameTag) {
                    isInsideTag = true;
                    formattedNode = node;
                    break;
                  }
                  node = node.parentElement;
                }
              }

              console.log(`[FORMAT] Was active: ${wasActive}, Inside tag: ${isInsideTag}`);

              if (!wasActive) {
                // Turning ON - use execCommand
                console.log(`[FORMAT] Turning ON - using execCommand`);
                document.execCommand(execCmd, false, null);
              } else {
                // Turning OFF
                console.log(`[FORMAT] Turning OFF - inserting space to break formatting`);

                // Insert a regular space followed by zero-width space to break out of formatting
                // Regular space for visible spacing, zero-width space ensures we're outside the tag
                if (isInsideTag && formattedNode) {
                  // Create a text node with space + zero-width space after the formatted node
                  const breakNode = document.createTextNode(' \u200B');
                  formattedNode.parentNode.insertBefore(breakNode, formattedNode.nextSibling);

                  // Move cursor to after the break characters
                  const newRange = document.createRange();
                  newRange.setStartAfter(breakNode);
                  newRange.collapse(true);
                  sel.removeAllRanges();
                  sel.addRange(newRange);

                  console.log(`[FORMAT] Inserted space + break character after formatted text`);
                } else {
                  // Not inside a tag, just insert space + zero-width space
                  document.execCommand('insertText', false, ' \u200B');
                  console.log(`[FORMAT] Inserted space + break character at cursor`);
                }
              }
            } else {
              // Text is selected - format the selection
              // Save the current selection
              let savedRange = null;
              if (sel.rangeCount > 0) {
                savedRange = sel.getRangeAt(0).cloneRange();
              }

              // Check if selection contains the same or opposite formatting
              let hasSameFormat = false;
              let hasOppositeFormat = false;
              let formattedNode = null;

              if (sel.rangeCount > 0) {
                const range = sel.getRangeAt(0);
                const container = range.commonAncestorContainer;

                // Check parent elements for formatting tags
                let node = container.nodeType === Node.TEXT_NODE ? container.parentElement : container;
                while (node && node !== textareaRef.current) {
                  if (node.tagName === sameTag) {
                    hasSameFormat = true;
                    formattedNode = node;
                  }
                  if (node.tagName === oppositeTag) hasOppositeFormat = true;
                  node = node.parentElement;
                }
              }

              console.log(`[FORMAT] ${execCmd}: hasSame=${hasSameFormat}, hasOpposite=${hasOppositeFormat}`);

              // Turn off opposite formatting if present
              if (hasOppositeFormat) {
                console.log(`[FORMAT] Removing opposite: ${oppositeCmd}`);
                document.execCommand(oppositeCmd, false, null);
                // Restore selection after command
                if (savedRange) {
                  sel.removeAllRanges();
                  sel.addRange(savedRange);
                }
              }

              // If same formatting exists, we need to manually remove it
              if (hasSameFormat && formattedNode) {
                console.log(`[FORMAT] Manually removing ${sameTag.toLowerCase()} tag`);
                // Get the text content and replace the formatted node with plain text
                const textContent = formattedNode.textContent;
                const textNode = document.createTextNode(textContent);
                formattedNode.parentNode.replaceChild(textNode, formattedNode);

                // Select the newly created text node
                const newRange = document.createRange();
                newRange.selectNodeContents(textNode);
                sel.removeAllRanges();
                sel.addRange(newRange);
              } else {
                console.log(`[FORMAT] Adding ${execCmd}`);
                document.execCommand(execCmd, false, null);
              }
            }
          } else {
            // For other formatting (bold, italic, underline), just toggle
            document.execCommand(execCmd, false, null);
          }

          // Manually trigger input event to update React state
          const inputEvent = new Event('input', { bubbles: true });
          textareaRef.current.dispatchEvent(inputEvent);
        }

        // Clear flag after a short delay
        setTimeout(() => {
          isFormattingRef.current = false;
        }, 50);
      };

      const insertSymbol = (symbol) => {
        if (!textareaRef.current) return;
        textareaRef.current.focus();
        document.execCommand('insertText', false, symbol);
        setTimeout(() => {
          const html = textareaRef.current.innerHTML;
          setEditingNote(p => ({ ...p, value: html }));
        }, 10);
      };

      const insertBullet = () => {
        if (!textareaRef.current) return;
        textareaRef.current.focus();
        document.execCommand('insertUnorderedList', false, null);
        setTimeout(() => {
          const html = textareaRef.current.innerHTML;
          setEditingNote(p => ({ ...p, value: html }));
        }, 10);
      };

      // Essential symbols for medical/scientific notation (shortlist for one-click access)
      const essentialSymbols = [
        { symbol: 'α', title: 'alpha' },
        { symbol: 'β', title: 'beta' },
        { symbol: 'Δ', title: 'Delta' },
        { symbol: 'μ', title: 'mu' },
        { symbol: '→', title: 'right arrow' },
        { symbol: '←', title: 'left arrow' },
        { symbol: '↑', title: 'up arrow' },
        { symbol: '↓', title: 'down arrow' },
        { symbol: '>', title: 'greater than' },
        { symbol: '<', title: 'less than' },
        { symbol: '≥', title: 'greater than or equal' },
        { symbol: '≤', title: 'less than or equal' },
        { symbol: '±', title: 'plus or minus' },
        { symbol: '≈', title: 'approximately equal' },
        { symbol: '°', title: 'degree' }
      ];

      const renderText = (text) => {
        if (text === null || text === undefined) return '';
        let str = String(text);

        // Split by <br> tags first for line breaks
        const lines = str.split(/<br\s*\/?>/gi);

        return lines.map((line, lineIdx) => {
          // Parse HTML-like tags for formatting
          const parseFormatting = (text) => {
            const parts = [];
            let currentPos = 0;
            const regex = /(<\/?(?:b|i|u|strong|em|sup|sub)>)/gi;
            let match;
            let stack = [];
            let currentText = '';

            const addPart = () => {
              if (currentText) {
                let content = currentText;
                // Handle bold markers
                content = content.replace(/\*\*([^*]+)\*\*/g, (_, text) => {
                  return text;
                });

                const styles = {};
                if (stack.includes('b') || stack.includes('strong')) styles.bold = true;
                if (stack.includes('i') || stack.includes('em')) styles.italic = true;
                if (stack.includes('u')) styles.underline = true;
                if (stack.includes('sup')) styles.superscript = true;
                if (stack.includes('sub')) styles.subscript = true;

                parts.push({ text: content, ...styles });
                currentText = '';
              }
            };

            const tokens = line.split(/(<\/?(?:b|i|u|strong|em|sup|sub|\*\*)>|\*\*)/gi);
            tokens.forEach(token => {
              if (token.match(/^<(b|strong)>$/i)) {
                addPart();
                stack.push(token.match(/^<(b|strong)>$/i)[1].toLowerCase());
              } else if (token.match(/^<\/(b|strong)>$/i)) {
                addPart();
                const tag = token.match(/^<\/(b|strong)>$/i)[1].toLowerCase();
                stack = stack.filter(t => t !== tag);
              } else if (token.match(/^<(i|em)>$/i)) {
                addPart();
                stack.push(token.match(/^<(i|em)>$/i)[1].toLowerCase());
              } else if (token.match(/^<\/(i|em)>$/i)) {
                addPart();
                const tag = token.match(/^<\/(i|em)>$/i)[1].toLowerCase();
                stack = stack.filter(t => t !== tag);
              } else if (token.match(/^<u>$/i)) {
                addPart();
                stack.push('u');
              } else if (token.match(/^<\/u>$/i)) {
                addPart();
                stack = stack.filter(t => t !== 'u');
              } else if (token.match(/^<sup>$/i)) {
                addPart();
                stack.push('sup');
              } else if (token.match(/^<\/sup>$/i)) {
                addPart();
                stack = stack.filter(t => t !== 'sup');
              } else if (token.match(/^<sub>$/i)) {
                addPart();
                stack.push('sub');
              } else if (token.match(/^<\/sub>$/i)) {
                addPart();
                stack = stack.filter(t => t !== 'sub');
              } else if (token === '**') {
                addPart();
                if (stack.includes('**')) {
                  stack = stack.filter(t => t !== '**');
                } else {
                  stack.push('**');
                }
              } else if (token) {
                currentText += token;
              }
            });
            addPart();

            return parts.map((part, i) => {
              if (!part.text) return null;
              let className = 'text-slate-300';
              if (part.bold) className += ' text-indigo-300 font-semibold';
              if (part.italic) className += ' italic';
              if (part.underline) className += ' underline';

              if (part.superscript) {
                return <sup key={i} className={className}>{part.text}</sup>;
              } else if (part.subscript) {
                return <sub key={i} className={className}>{part.text}</sub>;
              } else {
                return <span key={i} className={className}>{part.text}</span>;
              }
            });
          };

          const renderedLine = parseFormatting(line);

          // Return line with line break after (except for last line)
          if (lineIdx < lines.length - 1) {
            return <span key={lineIdx}>{renderedLine}<br /></span>;
          }
          return <span key={lineIdx}>{renderedLine}</span>;
        });
      };

      return (
      <>
        <div className="h-full flex flex-col bg-gradient-to-br from-slate-900 via-slate-800 to-slate-900 text-white">
          <div className="bg-slate-800/50 border-b border-slate-700 px-4 py-3">
            <div className="flex items-center justify-between">
              <div className="flex items-center gap-3">
                <div className="p-2 bg-indigo-600 rounded-lg"><Icon name="brain" className="w-5 h-5" /></div>
                <div><h1 className="font-semibold">Medical Lecture Study Assistant <span className="text-xs text-green-400 font-bold bg-green-900 px-2 py-1 rounded">v2.72</span></h1><p className="text-xs text-slate-400">Notes + Anki cards from PDF slides</p></div>
              </div>
              <button onClick={() => setShowSettings(!showSettings)} className={`p-2 rounded-lg ${apiKey ? 'bg-green-600/20 text-green-400' : 'bg-orange-600/20 text-orange-400'}`}><Icon name="settings" className="w-5 h-5" /></button>
            </div>
            {showSettings && (
              <div className="mt-3 p-3 bg-slate-700/50 rounded-xl">
                <div className="flex items-center gap-2 mb-2"><Icon name="key" className="w-4 h-4 text-slate-400" /><span className="text-sm font-medium">Anthropic API Key</span>{apiKey && <span className="text-xs bg-green-600/20 text-green-400 px-2 py-0.5 rounded">Saved</span>}</div>
                <div className="flex gap-2">
                  <input type={keyVisible ? 'text' : 'password'} value={apiKey} onChange={(e) => saveApiKey(e.target.value)} placeholder="sk-ant-..." className="flex-1 bg-slate-800 border border-slate-600 rounded-lg px-3 py-2 text-sm focus:outline-none focus:border-indigo-500" />
                  <button onClick={() => setKeyVisible(!keyVisible)} className="px-3 py-2 bg-slate-600 rounded-lg text-sm">{keyVisible ? 'Hide' : 'Show'}</button>
                </div>
                <p className="text-xs text-slate-400 mt-2">Get key at <a href="https://console.anthropic.com/settings/keys" target="_blank" className="text-indigo-400 underline">console.anthropic.com</a></p>
              </div>
            )}
          </div>

          <div className="flex bg-slate-800/30 border-b border-slate-700">
            {['upload', 'notes', 'cards'].map(tab => (
              <button key={tab} onClick={() => setActiveTab(tab)} className={`flex-1 py-3 text-sm font-medium ${activeTab === tab ? 'bg-slate-700/50 text-indigo-400 border-b-2 border-indigo-500' : 'text-slate-400'}`}>
                {tab === 'upload' ? 'Chat' : tab === 'notes' ? `Notes${notes ? ' ✓' : ''}` : `Cards${cards.length ? ` (${cards.length})` : ''}`}
              </button>
            ))}
          </div>

          <div className="flex-1 overflow-hidden">
            {activeTab === 'upload' && (
              <div className="h-full flex flex-col">
                <div className="flex-1 overflow-y-auto p-4 space-y-4">
                  {chatMessages.map((msg, i) => (
                    <div key={i} className={`flex ${msg.role === 'user' ? 'justify-end' : 'justify-start'}`}>
                      <div className={`max-w-[85%] rounded-2xl px-4 py-2.5 ${msg.role === 'user' ? 'bg-indigo-600' : 'bg-slate-700/70'}`}>
                        <p className="text-sm whitespace-pre-wrap">{msg.content}</p>
                      </div>
                    </div>
                  ))}
                  {processing && <div className="flex justify-start"><div className="bg-slate-700/70 rounded-2xl px-4 py-3 flex items-center gap-2"><div className="w-4 h-4 border-2 border-indigo-400 border-t-transparent rounded-full animate-spin"></div><span className="text-sm">{processingType === 'notes' ? 'Generating notes...' : 'Generating flashcards...'}</span></div></div>}
                </div>
                <div className="p-4 bg-slate-800/50 border-t border-slate-700 space-y-3">
                  {file && (
                    <div className="space-y-2">
                      <select value={moduleAbbrev} onChange={(e) => setModuleAbbrev(e.target.value)} className="w-full bg-slate-700/50 border border-slate-600 rounded-lg px-3 py-2 text-sm focus:outline-none focus:border-indigo-500">
                        <option value="">Select Module...</option>
                        {modules.map(m => <option key={m.abbrev} value={m.abbrev}>{m.name} ({m.abbrev})</option>)}
                      </select>
                      <input type="text" value={lectureTag} onChange={(e) => setLectureTag(e.target.value)} placeholder="Lecture name (e.g. Applied Anatomy Of The Female Reproductive System)" className="w-full bg-slate-700/50 border border-slate-600 rounded-lg px-3 py-2 text-sm focus:outline-none focus:border-indigo-500" />
                      {moduleAbbrev && lectureTag && <p className="text-xs text-slate-400">Tag preview: Day2 {moduleAbbrev}_{lectureTag.split(/[\s_\-\.]+/).map(w => w.charAt(0).toUpperCase() + w.slice(1)).join('')}</p>}
                      <textarea
                        value={userLearningObjectives}
                        onChange={(e) => setUserLearningObjectives(e.target.value)}
                        placeholder="Paste learning objectives here (optional)&#10;e.g.&#10;1. Describe the anatomy of...&#10;2. Explain the mechanism of..."
                        className="w-full bg-slate-700/50 border border-slate-600 rounded-lg px-3 py-2 text-sm focus:outline-none focus:border-indigo-500 min-h-[80px] resize-y"
                        rows={3}
                      />
                      <p className="text-xs text-slate-400">Learning objectives will be used to structure your notes</p>
                    </div>
                  )}
                  {file && (
                    <div className="space-y-2">
                      <textarea
                        value={customInstructions}
                        onChange={(e) => setCustomInstructions(e.target.value)}
                        placeholder="Custom instructions for note generation (optional)&#10;e.g. Focus on clinical applications, include diagrams descriptions, emphasise pharmacology..."
                        className="w-full bg-slate-700/50 border border-slate-600 rounded-lg px-3 py-2 text-sm focus:outline-none focus:border-indigo-500 min-h-[60px] resize-y"
                        rows={2}
                      />
                      <p className="text-xs text-slate-400">Add any specific instructions or preferences for how notes should be generated</p>
                    </div>
                  )}
                  <div className="flex gap-2 flex-wrap">
                    <input type="file" ref={fileInputRef} onChange={handleFileUpload} accept=".pdf" className="hidden" />
                    <button onClick={() => fileInputRef.current?.click()} className="flex items-center gap-2 px-4 py-2.5 bg-slate-700 hover:bg-slate-600 rounded-xl"><Icon name="upload" className="w-4 h-4" /><span className="text-sm">Upload PDF</span></button>
                    {file && <div className="flex items-center gap-2 px-3 bg-slate-700/50 rounded-xl"><span className="text-sm truncate max-w-[150px]">{file.name}</span><button onClick={() => {setFile(null); setFileData(null);}} className="text-slate-400 hover:text-white">×</button></div>}
                  </div>
                  <div className="flex gap-2">
                    <button onClick={generateNotes} disabled={!file || processing || !apiKey} className="flex-1 flex items-center justify-center gap-2 px-4 py-2.5 bg-indigo-600 hover:bg-indigo-500 disabled:bg-slate-600 disabled:opacity-50 rounded-xl">
                      <Icon name="file-text" className="w-4 h-4" /><span className="text-sm">Generate Notes</span>
                    </button>
                    <button onClick={() => { console.log('Flashcard button clicked, notes:', notes); generateFlashcards(); }} disabled={!notes || processing || !apiKey} className="flex-1 flex items-center justify-center gap-2 px-4 py-2.5 bg-green-600 hover:bg-green-500 disabled:bg-slate-600 disabled:opacity-50 rounded-xl">
                      <Icon name="layers" className="w-4 h-4" /><span className="text-sm">Generate Flashcards {notes ? '✓' : ''}</span>
                    </button>
                  </div>
                  {!apiKey && <p className="text-orange-400 text-xs">⚠️ Add API key in Settings</p>}
                  {file && !notes && <p className="text-slate-400 text-xs">Step 1: Generate notes from PDF</p>}
                  {notes && !cards.length && <p className="text-slate-400 text-xs">Step 2: Generate flashcards from notes</p>}
                </div>
              </div>
            )}

            {activeTab === 'notes' && (
              <div className="h-full flex flex-col">
                <div className="flex-1 overflow-y-auto p-4">
                  {notes ? (
                    <div className="space-y-6">
                      <div className="flex justify-between items-center">
                        <div className="flex items-center gap-2 group">
                          {editingNote?.type === 'title' ? (
                            <div className="flex gap-2">
                              <input
                                type="text"
                                value={editingNote.value}
                                onChange={(e) => setEditingNote(p => ({ ...p, value: e.target.value }))}
                                onKeyDown={(e) => e.key === 'Enter' && saveNoteEdit()}
                                className="text-xl font-bold bg-slate-700/50 border border-slate-600 rounded px-2 py-1 focus:outline-none focus:border-indigo-500"
                                autoFocus
                              />
                              <button onClick={saveNoteEdit} className="px-2 py-1 bg-indigo-600 hover:bg-indigo-500 rounded text-xs">Save</button>
                              <button onClick={() => setEditingNote(null)} className="px-2 py-1 bg-slate-600 hover:bg-slate-500 rounded text-xs">Cancel</button>
                            </div>
                          ) : (
                            <>
                              <h2 className="text-xl font-bold">{notes.title || 'Untitled'}</h2>
                              <button onClick={() => setEditingNote({ type: 'title', value: notes.title || '' })} className="opacity-0 group-hover:opacity-100 px-1 py-0.5 bg-slate-600 hover:bg-slate-500 rounded text-xs transition-opacity">
                                <Icon name="edit-2" className="w-3 h-3" />
                              </button>
                            </>
                          )}
                        </div>
                        <div className="flex gap-2"><button onClick={() => setNotes({ ...notes })} className="px-3 py-1.5 bg-indigo-600 hover:bg-indigo-500 rounded-lg text-sm flex items-center gap-1"><Icon name="refresh-cw" className="w-4 h-4" />Reload</button><button onClick={copyNotes} className="px-3 py-1.5 bg-indigo-600 hover:bg-indigo-500 rounded-lg text-sm">{copied ? '✓ Copied' : 'Copy'}</button><input type="file" ref={pdfImportInputRef} onChange={handleImportPDF} accept=".pdf" className="hidden" /><button onClick={() => pdfImportInputRef.current?.click()} disabled={processing} className="px-3 py-1.5 bg-purple-600 hover:bg-purple-500 disabled:bg-slate-600 disabled:opacity-50 rounded-lg text-sm flex items-center gap-1">{processing && processingType === 'import' ? (<><div className="w-4 h-4 border-2 border-white border-t-transparent rounded-full animate-spin"></div>Importing...</>) : (<><Icon name="upload" className="w-4 h-4" />Import PDF</>)}</button><button onClick={exportPDF} className="px-3 py-1.5 bg-green-600 hover:bg-green-500 rounded-lg text-sm flex items-center gap-1"><Icon name="download" className="w-4 h-4" />PDF</button></div></div>
                      <div className="bg-indigo-900/30 border border-indigo-700/50 rounded-xl p-4">
                        <h3 className="text-sm font-semibold text-indigo-400 mb-2">Learning Objectives</h3>
                        <ul className="space-y-1">
                          {Array.isArray(notes.learningObjectives) && notes.learningObjectives.map((o, i) => (
                            <li key={i} className="text-sm text-slate-300 group flex items-start gap-2">
                              {editingNote?.type === 'lo' && editingNote.index === i ? (
                                <div className="flex-1 flex gap-2">
                                  <input
                                    type="text"
                                    value={editingNote.value}
                                    onChange={(e) => setEditingNote(p => ({ ...p, value: e.target.value }))}
                                    onKeyDown={(e) => e.key === 'Enter' && saveNoteEdit()}
                                    className="flex-1 bg-slate-700/50 border border-slate-600 rounded px-2 py-1 text-sm focus:outline-none focus:border-indigo-500"
                                    autoFocus
                                  />
                                  <button onClick={saveNoteEdit} className="px-2 py-1 bg-indigo-600 hover:bg-indigo-500 rounded text-xs">Save</button>
                                  <button onClick={() => setEditingNote(null)} className="px-2 py-1 bg-slate-600 hover:bg-slate-500 rounded text-xs">Cancel</button>
                                </div>
                              ) : (
                                <>
                                  <span className="flex-1">• {String(o)}</span>
                                  <button onClick={() => startEditLO(i)} className="opacity-0 group-hover:opacity-100 px-1 py-0.5 bg-slate-600 hover:bg-slate-500 rounded text-xs transition-opacity">
                                    <Icon name="edit-2" className="w-3 h-3" />
                                  </button>
                                </>
                              )}
                            </li>
                          ))}
                        </ul>
                      </div>
                      {Array.isArray(notes.notes) && notes.notes.map((s, i) => (
                        <div
                          key={i}
                          className={`bg-slate-800/50 rounded-xl p-4 ${dropTargetSection === i && draggedSection !== i ? 'drop-target-indicator' : ''}`}
                          onDragOver={(e) => handleSectionDragOver(e, i)}
                          onDragLeave={handleDragLeave}
                          onDrop={() => handleSectionDrop(i)}
                        >
                          <div className="flex items-center gap-2 mb-3 group">
                            <div
                              draggable={!editingNote ? "true" : "false"}
                              onDragStart={(e) => handleSectionDragStart(e, i)}
                              onDragEnd={handleDragEnd}
                              className="cursor-move p-1 -m-1"
                            >
                              <Icon name="grip-vertical" className="w-4 h-4 text-slate-500 opacity-0 group-hover:opacity-100 transition-opacity flex-shrink-0" />
                            </div>
                            {editingNote?.type === 'section' && editingNote.sectionIndex === i ? (
                              <div className="flex-1 flex gap-2">
                                <input
                                  type="text"
                                  value={editingNote.value}
                                  onChange={(e) => setEditingNote(p => ({ ...p, value: e.target.value }))}
                                  onKeyDown={(e) => e.key === 'Enter' && saveNoteEdit()}
                                  className="flex-1 bg-slate-700/50 border border-slate-600 rounded px-2 py-1 text-sm font-semibold focus:outline-none focus:border-indigo-500"
                                  autoFocus
                                />
                                <button onClick={saveNoteEdit} className="px-2 py-1 bg-indigo-600 hover:bg-indigo-500 rounded text-xs">Save</button>
                                <button onClick={() => setEditingNote(null)} className="px-2 py-1 bg-slate-600 hover:bg-slate-500 rounded text-xs">Cancel</button>
                              </div>
                            ) : (
                              <>
                                <h3 className="font-semibold flex-1">
                                  {s?.section || `Section ${i + 1}`}
                                  {getSectionImage(i) && <span className="text-indigo-400 text-xs font-normal ml-2">(Fig {getFigureNumber(i, null, 'section')})</span>}
                                </h3>
                                <div className="opacity-0 group-hover:opacity-100 flex gap-1 transition-opacity">
                                  <button onClick={() => startEditSection(i)} className="px-1 py-0.5 bg-slate-600 hover:bg-slate-500 rounded text-xs" title="Edit section">
                                    <Icon name="edit-2" className="w-3 h-3" />
                                  </button>
                                  <button
                                    onClick={() => setImagePickerOpen({ type: 'section', sectionIndex: i })}
                                    className="px-1 py-0.5 bg-slate-600 hover:bg-slate-500 rounded text-xs"
                                    title={pdfThumbnails.length > 0 ? "Add image to section" : "Upload a PDF first to insert images"}
                                    disabled={pdfThumbnails.length === 0}
                                  >
                                    <Icon name="image" className="w-3 h-3" />
                                  </button>
                                  <button onClick={() => deleteSection(i)} className="px-1 py-0.5 bg-red-600/50 hover:bg-red-600 rounded text-xs" title="Delete section">
                                    <Icon name="trash-2" className="w-3 h-3" />
                                  </button>
                                </div>
                              </>
                            )}
                          </div>
                          <ul className="space-y-2">
                            {Array.isArray(s?.points) && s.points.map((p, j) => (
                              <li
                                key={j}
                                className={`text-sm text-slate-300 pl-4 border-l-2 border-slate-700 group flex items-start gap-2 ${dropTargetPoint?.sectionIndex === i && dropTargetPoint?.pointIndex === j && !(draggedPoint?.sectionIndex === i && draggedPoint?.pointIndex === j) ? 'drop-target-indicator' : ''}`}
                                onDragOver={(e) => handlePointDragOver(e, i, j)}
                                onDragLeave={handleDragLeave}
                                onDrop={() => handleDrop(i, j)}
                              >
                                {editingNote?.type === 'point' && editingNote.sectionIndex === i && editingNote.pointIndex === j ? (
                                  <div className="flex-1 space-y-2">
                                    {/* Formatting Toolbar */}
                                    <div className="flex flex-wrap gap-1 p-2 bg-slate-800/50 rounded-lg border border-slate-600 mb-2">
                                      <div className="text-xs text-slate-500 w-full mb-1">Format text:</div>
                                      <button onClick={() => insertFormatting('bold')} className="px-2 py-1 bg-slate-700 hover:bg-slate-600 rounded text-xs font-bold" title="Bold">B</button>
                                      <button onClick={() => insertFormatting('italic')} className="px-2 py-1 bg-slate-700 hover:bg-slate-600 rounded text-xs italic" title="Italic">I</button>
                                      <button onClick={() => insertFormatting('underline')} className="px-2 py-1 bg-slate-700 hover:bg-slate-600 rounded text-xs underline" title="Underline">U</button>
                                      <button onClick={() => insertFormatting('superscript')} className={`px-2 py-1 rounded text-xs ${activeFormatting.superscript ? 'bg-indigo-600 hover:bg-indigo-500' : 'bg-slate-700 hover:bg-slate-600'}`} title="Superscript">X<sup>2</sup></button>
                                      <button onClick={() => insertFormatting('subscript')} className={`px-2 py-1 rounded text-xs ${activeFormatting.subscript ? 'bg-indigo-600 hover:bg-indigo-500' : 'bg-slate-700 hover:bg-slate-600'}`} title="Subscript">X<sub>2</sub></button>
                                      <button onClick={insertBullet} className="px-2 py-1 bg-slate-700 hover:bg-slate-600 rounded text-xs" title="Bullet point">•</button>
                                      <span className="border-l border-slate-600 mx-1"></span>
                                      <button onClick={() => insertSymbol('α')} className="px-2 py-1 bg-slate-700 hover:bg-slate-600 rounded text-xs" title="alpha">α</button>
                                      <button onClick={() => insertSymbol('β')} className="px-2 py-1 bg-slate-700 hover:bg-slate-600 rounded text-xs" title="beta">β</button>
                                      <button onClick={() => insertSymbol('Δ')} className="px-2 py-1 bg-slate-700 hover:bg-slate-600 rounded text-xs" title="Delta">Δ</button>
                                      <button onClick={() => insertSymbol('μ')} className="px-2 py-1 bg-slate-700 hover:bg-slate-600 rounded text-xs" title="mu">μ</button>
                                      <button onClick={() => insertSymbol('→')} className="px-2 py-1 bg-slate-700 hover:bg-slate-600 rounded text-xs" title="right arrow">→</button>
                                      <button onClick={() => insertSymbol('←')} className="px-2 py-1 bg-slate-700 hover:bg-slate-600 rounded text-xs" title="left arrow">←</button>
                                      <button onClick={() => insertSymbol('↑')} className="px-2 py-1 bg-slate-700 hover:bg-slate-600 rounded text-xs" title="up arrow">↑</button>
                                      <button onClick={() => insertSymbol('↓')} className="px-2 py-1 bg-slate-700 hover:bg-slate-600 rounded text-xs" title="down arrow">↓</button>
                                      <button onClick={() => insertSymbol('>')} className="px-2 py-1 bg-slate-700 hover:bg-slate-600 rounded text-xs" title="greater than">{'>'}</button>
                                      <button onClick={() => insertSymbol('<')} className="px-2 py-1 bg-slate-700 hover:bg-slate-600 rounded text-xs" title="less than">{'<'}</button>
                                      <button onClick={() => insertSymbol('≥')} className="px-2 py-1 bg-slate-700 hover:bg-slate-600 rounded text-xs" title="greater than or equal">≥</button>
                                      <button onClick={() => insertSymbol('≤')} className="px-2 py-1 bg-slate-700 hover:bg-slate-600 rounded text-xs" title="less than or equal">≤</button>
                                      <button onClick={() => insertSymbol('±')} className="px-2 py-1 bg-slate-700 hover:bg-slate-600 rounded text-xs" title="plus or minus">±</button>
                                      <button onClick={() => insertSymbol('≈')} className="px-2 py-1 bg-slate-700 hover:bg-slate-600 rounded text-xs" title="approximately equal">≈</button>
                                      <button onClick={() => insertSymbol('°')} className="px-2 py-1 bg-slate-700 hover:bg-slate-600 rounded text-xs" title="degree">°</button>
                                    </div>
                                    <div
                                      ref={(el) => {
                                        textareaRef.current = el;
                                        // Only update innerHTML if we're not currently formatting
                                        if (el && !isFormattingRef.current && el.innerHTML !== editingNote.value) {
                                          el.innerHTML = editingNote.value || '';
                                          // Set cursor at end
                                          const range = document.createRange();
                                          const sel = window.getSelection();
                                          if (el.childNodes.length > 0) {
                                            const lastChild = el.childNodes[el.childNodes.length - 1];
                                            const lastNode = lastChild.nodeType === Node.TEXT_NODE ? lastChild : lastChild.lastChild || lastChild;
                                            try {
                                              range.setStart(lastNode, lastNode.textContent?.length || 0);
                                              range.collapse(true);
                                              sel.removeAllRanges();
                                              sel.addRange(range);
                                            } catch (e) {
                                              // Ignore if cursor positioning fails
                                            }
                                          }
                                        }
                                      }}
                                      contentEditable
                                      suppressContentEditableWarning
                                      onInput={(e) => {
                                        const html = e.currentTarget.innerHTML;
                                        setEditingNote(p => ({ ...p, value: html }));
                                      }}
                                      onKeyDown={(e) => {
                                        // Save on Ctrl/Cmd+Enter
                                        if (e.key === 'Enter' && (e.ctrlKey || e.metaKey)) {
                                          e.preventDefault();
                                          const html = e.currentTarget.innerHTML;
                                          setEditingNote(p => ({ ...p, value: html }));
                                          saveNoteEdit();
                                        }
                                        // Tab for indent
                                        if (e.key === 'Tab') {
                                          e.preventDefault();
                                          if (e.shiftKey) {
                                            document.execCommand('outdent');
                                          } else {
                                            document.execCommand('indent');
                                          }
                                        }
                                        // Backspace to remove indentation at start of line
                                        if (e.key === 'Backspace') {
                                          const sel = window.getSelection();
                                          if (sel && sel.rangeCount > 0) {
                                            const range = sel.getRangeAt(0);

                                            // Only proceed if nothing is selected (collapsed range)
                                            if (range.collapsed) {
                                              // Check if we're inside a blockquote (indented content)
                                              let node = range.startContainer;
                                              let blockquote = null;

                                              // Traverse up the DOM to find a blockquote
                                              while (node && node !== e.currentTarget) {
                                                if (node.nodeName === 'BLOCKQUOTE') {
                                                  blockquote = node;
                                                  break;
                                                }
                                                node = node.parentNode;
                                              }

                                              if (blockquote) {
                                                // Check if cursor is at the start of visible content
                                                // by checking if there's any non-whitespace text before the cursor
                                                let textBeforeCursor = '';
                                                if (range.startContainer.nodeType === Node.TEXT_NODE) {
                                                  textBeforeCursor = range.startContainer.textContent.substring(0, range.startOffset);
                                                }

                                                // If no visible text before cursor, outdent
                                                if (textBeforeCursor.trim() === '') {
                                                  e.preventDefault();
                                                  document.execCommand('outdent');
                                                }
                                              }
                                            }
                                          }
                                        }
                                      }}
                                      className="w-full bg-slate-700/50 border border-slate-600 rounded px-3 py-2 text-sm focus:outline-none focus:border-indigo-500 min-h-[80px] max-h-[300px] overflow-y-auto"
                                      style={{ whiteSpace: 'pre-wrap', wordBreak: 'break-word' }}
                                    />
                                    <div className="flex gap-2">
                                      <button onClick={saveNoteEdit} className="px-2 py-1 bg-indigo-600 hover:bg-indigo-500 rounded text-xs">Save</button>
                                      <button onClick={() => setEditingNote(null)} className="px-2 py-1 bg-slate-600 hover:bg-slate-500 rounded text-xs">Cancel</button>
                                    </div>
                                  </div>
                                ) : (
                                  <div className="flex-1">
                                    <div className="flex items-start gap-2">
                                      <span
                                        className="opacity-0 group-hover:opacity-100 cursor-move text-slate-500 p-1 -m-1"
                                        draggable={!editingNote ? "true" : "false"}
                                        onDragStart={(e) => handleDragStart(e, i, j)}
                                        onDragEnd={handleDragEnd}
                                      >
                                        <Icon name="grip-vertical" className="w-3 h-3" />
                                      </span>
                                      <span className="flex-1 notes-display" dangerouslySetInnerHTML={{ __html: '• ' + markdownToHTML(p) + (() => {
                                        const imgData = getPointImageOrRef(i, j);
                                        if (!imgData) return '';
                                        const figNum = imgData.isPrimary
                                          ? getFigureNumber(i, j, 'point')
                                          : (() => {
                                              const [s, p] = imgData.refKey.split('-').map(Number);
                                              return getFigureNumber(s, p, 'point');
                                            })();
                                        return ` <span class="text-indigo-400 text-xs">(Fig ${figNum})</span>`;
                                      })() }} />
                                      <div className="opacity-0 group-hover:opacity-100 flex gap-1 transition-opacity">
                                        <button onClick={() => startEditPoint(i, j)} className="px-1 py-0.5 bg-slate-600 hover:bg-slate-500 rounded text-xs" title="Edit point">
                                          <Icon name="edit-2" className="w-3 h-3" />
                                        </button>
                                        <button
                                          onClick={() => {
                                            setImagePickerOpen({ type: 'point', sectionIndex: i, pointIndex: j });
                                            setImagePickerTab('slides');
                                          }}
                                          className="px-1 py-0.5 bg-slate-600 hover:bg-slate-500 rounded text-xs"
                                          title={pdfThumbnails.length > 0 || Object.keys(pointImages).length > 0 ? "Insert or reference image" : "Upload a PDF first to insert images"}
                                          disabled={pdfThumbnails.length === 0 && Object.keys(pointImages).length === 0}
                                        >
                                          <Icon name="image" className="w-3 h-3" />
                                        </button>
                                        <button onClick={() => deletePoint(i, j)} className="px-1 py-0.5 bg-red-600/50 hover:bg-red-600 rounded text-xs" title="Delete point">
                                          <Icon name="trash-2" className="w-3 h-3" />
                                        </button>
                                      </div>
                                    </div>
                                    {/* Display image if one is attached to this point (primary image) */}
                                    {getPointImage(i, j) && (
                                      <div className="mt-2 ml-8 group/image">
                                        <div className="relative inline-block max-w-[200px]">
                                          <img
                                            src={getPointImage(i, j).dataUrl}
                                            alt={`Fig - Slide ${getPointImage(i, j).pageNum}`}
                                            className="w-full rounded border border-slate-600 bg-white"
                                          />
                                          <div className="absolute top-1 right-1 flex gap-1 opacity-0 group-hover/image:opacity-100 transition-opacity">
                                            <button
                                              onClick={async () => {
                                                const imgData = getPointImage(i, j);
                                                // Create display dimensions for the crop modal
                                                const img = new Image();
                                                img.src = imgData.dataUrl;
                                                await new Promise(r => img.onload = r);
                                                const maxWidth = Math.min(800, window.innerWidth - 100);
                                                const maxHeight = Math.min(600, window.innerHeight - 200);
                                                const scale = Math.min(maxWidth / img.width, maxHeight / img.height, 1);
                                                setCropModalOpen({
                                                  type: 'point',
                                                  sectionIndex: i,
                                                  pointIndex: j,
                                                  imageData: {
                                                    dataUrl: imgData.dataUrl,
                                                    displayWidth: img.width * scale,
                                                    displayHeight: img.height * scale
                                                  },
                                                  pageNum: imgData.pageNum,
                                                  isEditing: true
                                                });
                                                setCropArea({ x: 0, y: 0, width: img.width * scale, height: img.height * scale });
                                              }}
                                              className="p-1 bg-purple-600/80 hover:bg-purple-600 rounded-full"
                                              title="Edit image"
                                            >
                                              <Icon name="edit-2" className="w-3 h-3" />
                                            </button>
                                            <button
                                              onClick={() => removePointImage(i, j)}
                                              className="p-1 bg-red-600/80 hover:bg-red-600 rounded-full"
                                              title="Remove image"
                                            >
                                              <Icon name="x" className="w-3 h-3" />
                                            </button>
                                          </div>
                                        </div>
                                      </div>
                                    )}
                                    {/* Display reference indicator if this point references another image */}
                                    {!getPointImage(i, j) && getImageReference(i, j) && (() => {
                                      const refKey = getImageReference(i, j);
                                      const [refS, refP] = refKey.split('-').map(Number);
                                      const figNum = getFigureNumber(refS, refP, 'point');
                                      return (
                                        <div className="mt-1 ml-8 flex items-center gap-2 text-xs text-slate-400 group/ref">
                                          <Icon name="link" className="w-3 h-3 text-indigo-400" />
                                          <span>References Fig {figNum}</span>
                                          <button
                                            onClick={() => removeImageReference(i, j)}
                                            className="opacity-0 group-hover/ref:opacity-100 text-red-400 hover:text-red-300 transition-opacity"
                                            title="Remove reference"
                                          >
                                            <Icon name="x" className="w-3 h-3" />
                                          </button>
                                        </div>
                                      );
                                    })()}
                                  </div>
                                )}
                              </li>
                            ))}
                          </ul>
                          <button onClick={() => addPoint(i)} className="mt-3 px-2 py-1 bg-slate-700 hover:bg-slate-600 rounded text-xs flex items-center gap-1 text-slate-400 hover:text-white">
                            <Icon name="plus" className="w-3 h-3" />Add point
                          </button>

                          {/* Section-level image (displayed below all bullet points) */}
                          {getSectionImage(i) && (
                            <div className="mt-4 ml-4 group/sectionimage">
                              <div className="relative inline-block max-w-[200px]">
                                <img
                                  src={getSectionImage(i).dataUrl}
                                  alt={`Section ${i + 1} image - Slide ${getSectionImage(i).pageNum}`}
                                  className="w-full rounded border border-slate-600 bg-white"
                                />
                                <div className="absolute top-1 right-1 flex gap-1 opacity-0 group-hover/sectionimage:opacity-100 transition-opacity">
                                  <button
                                    onClick={async () => {
                                      const imgData = getSectionImage(i);
                                      const img = new Image();
                                      img.src = imgData.dataUrl;
                                      await new Promise(r => img.onload = r);
                                      const maxWidth = Math.min(800, window.innerWidth - 100);
                                      const maxHeight = Math.min(600, window.innerHeight - 200);
                                      const scale = Math.min(maxWidth / img.width, maxHeight / img.height, 1);
                                      setCropModalOpen({
                                        type: 'section',
                                        sectionIndex: i,
                                        pointIndex: null,
                                        imageData: {
                                          dataUrl: imgData.dataUrl,
                                          displayWidth: img.width * scale,
                                          displayHeight: img.height * scale
                                        },
                                        pageNum: imgData.pageNum,
                                        isEditing: true
                                      });
                                      setCropArea({ x: 0, y: 0, width: img.width * scale, height: img.height * scale });
                                    }}
                                    className="p-1 bg-purple-600/80 hover:bg-purple-600 rounded-full"
                                    title="Edit image"
                                  >
                                    <Icon name="edit-2" className="w-3 h-3" />
                                  </button>
                                  <button
                                    onClick={() => removeSectionImage(i)}
                                    className="p-1 bg-red-600/80 hover:bg-red-600 rounded-full"
                                    title="Remove section image"
                                  >
                                    <Icon name="x" className="w-3 h-3" />
                                  </button>
                                </div>
                              </div>
                            </div>
                          )}
                        </div>
                      ))}
                      <button onClick={addSection} className="mt-4 px-3 py-2 bg-indigo-600 hover:bg-indigo-500 rounded-xl text-sm flex items-center gap-2 mx-auto">
                        <Icon name="plus" className="w-4 h-4" />Add Section
                      </button>
                    </div>
                  ) : (
                    <div className="h-full flex items-center justify-center p-8">
                      <div className="max-w-md w-full bg-slate-800/50 rounded-xl p-6 space-y-4">
                        <div className="text-center space-y-2">
                          <Icon name="file-text" className="w-12 h-12 mx-auto text-indigo-400" />
                          <h3 className="text-lg font-semibold text-slate-200">Import Lecture Notes</h3>
                          <p className="text-sm text-slate-400">Upload a PDF that was previously exported from this tool</p>
                        </div>

                        <div className="space-y-3">
                          <div>
                            <label className="block text-sm font-medium text-slate-300 mb-2">Select Module</label>
                            <select
                              value={importModuleAbbrev}
                              onChange={(e) => setImportModuleAbbrev(e.target.value)}
                              className="w-full bg-slate-700 border border-slate-600 rounded-lg px-3 py-2 text-sm focus:outline-none focus:border-indigo-500"
                            >
                              <option value="">-- Select Module --</option>
                              {modules.map(m => (
                                <option key={m.abbrev} value={m.abbrev}>{m.name} ({m.abbrev})</option>
                              ))}
                            </select>
                          </div>

                          <input
                            type="file"
                            ref={pdfImportInputRef}
                            onChange={handleImportPDF}
                            accept=".pdf"
                            className="hidden"
                          />

                          <button
                            onClick={() => pdfImportInputRef.current?.click()}
                            disabled={processing}
                            className="w-full px-4 py-3 bg-purple-600 hover:bg-purple-500 disabled:bg-slate-600 disabled:opacity-50 rounded-lg text-sm font-medium flex items-center justify-center gap-2"
                          >
                            {processing && processingType === 'import' ? (
                              <>
                                <div className="w-5 h-5 border-2 border-white border-t-transparent rounded-full animate-spin"></div>
                                Importing...
                              </>
                            ) : (
                              <>
                                <Icon name="upload" className="w-5 h-5" />
                                Import PDF
                              </>
                            )}
                          </button>
                        </div>

                        <div className="text-center text-xs text-slate-500 pt-2 border-t border-slate-700">
                          Or upload lecture slides in the Upload tab to generate new notes
                        </div>
                      </div>
                    </div>
                  )}
                </div>
                {notes && (
                  <div className="p-4 bg-slate-800/50 border-t border-slate-700">
                    <div className="flex gap-2">
                      <input
                        type="text"
                        value={modifyRequest}
                        onChange={(e) => setModifyRequest(e.target.value)}
                        onKeyDown={(e) => e.key === 'Enter' && !modifying && modifyNotes()}
                        placeholder="Request changes (e.g. 'Add more detail to section 2', 'Simplify the clinical points')"
                        className="flex-1 bg-slate-700/50 border border-slate-600 rounded-lg px-3 py-2 text-sm focus:outline-none focus:border-indigo-500"
                        disabled={modifying}
                      />
                      <button
                        onClick={modifyNotes}
                        disabled={modifying || !modifyRequest.trim()}
                        className="px-4 py-2 bg-amber-600 hover:bg-amber-500 disabled:bg-slate-600 disabled:opacity-50 rounded-lg text-sm flex items-center gap-2"
                      >
                        {modifying ? <><div className="w-4 h-4 border-2 border-white border-t-transparent rounded-full animate-spin"></div>Modifying...</> : <><Icon name="edit-3" className="w-4 h-4" />Modify</>}
                      </button>
                    </div>
                    <p className="text-xs text-slate-400 mt-2">Make changes to your notes before downloading or generating flashcards</p>
                  </div>
                )}
              </div>
            )}

            {activeTab === 'cards' && (
              <div className="h-full flex flex-col">
                <div className="flex-1 overflow-y-auto p-4">
                  {cards.length ? (
                    <div className="space-y-3">
                      <div className="flex justify-between items-center mb-4">
                        <h2 className="font-semibold">{cards.length} Flashcards</h2>
                        <div className="flex gap-2">
                          <button onClick={() => setShowAddCard(true)} className="px-3 py-1.5 bg-indigo-600 hover:bg-indigo-500 rounded-lg text-sm flex items-center gap-1">
                            <Icon name="plus" className="w-4 h-4" />Add
                          </button>
                          <button onClick={() => csvImportInputRef.current?.click()} className="px-3 py-1.5 bg-purple-600 hover:bg-purple-500 rounded-lg text-sm flex items-center gap-1">
                            <Icon name="upload" className="w-4 h-4" />Import
                          </button>
                          <button onClick={exportCSV} className="px-3 py-1.5 bg-green-600 hover:bg-green-500 rounded-lg text-sm">Export CSV</button>
                        </div>
                      </div>

                      {/* Special Card Types */}
                      {getAllNotesImages().length > 0 && (
                        <div className="bg-slate-700/30 rounded-xl p-3 mb-4">
                          <p className="text-xs text-slate-400 mb-2">Generate additional cards from images:</p>
                          <div className="flex gap-2">
                            <button
                              onClick={() => {
                                setOcclusionModalOpen(true);
                                setOcclusionStep('select');
                              }}
                              className="px-3 py-1.5 bg-orange-600 hover:bg-orange-500 rounded-lg text-sm flex items-center gap-1"
                            >
                              <Icon name="eye-off" className="w-4 h-4" />Image Occlusion
                            </button>
                            <button
                              onClick={() => {
                                setInterpretationModalOpen(true);
                                setInterpretationStep('select');
                              }}
                              className="px-3 py-1.5 bg-teal-600 hover:bg-teal-500 rounded-lg text-sm flex items-center gap-1"
                            >
                              <Icon name="message-square" className="w-4 h-4" />Interpretation Cards
                            </button>
                          </div>
                        </div>
                      )}

                      {/* Add Card Form */}
                      {showAddCard && (
                        <div className="bg-indigo-900/30 border border-indigo-700/50 rounded-xl p-4 mb-4">
                          <h3 className="text-sm font-semibold text-indigo-400 mb-3">Add New Card</h3>
                          <div className="space-y-2">
                            <input
                              type="text"
                              value={newCard.front}
                              onChange={(e) => setNewCard(p => ({ ...p, front: e.target.value }))}
                              placeholder="Front (question)"
                              className="w-full bg-slate-700/50 border border-slate-600 rounded-lg px-3 py-2 text-sm focus:outline-none focus:border-indigo-500"
                            />
                            <textarea
                              value={newCard.back}
                              onChange={(e) => setNewCard(p => ({ ...p, back: e.target.value }))}
                              placeholder="Back (answer) - use <b>text</b> for bold"
                              className="w-full bg-slate-700/50 border border-slate-600 rounded-lg px-3 py-2 text-sm focus:outline-none focus:border-indigo-500 min-h-[60px]"
                              rows={2}
                            />
                            <div className="flex gap-2 justify-end">
                              <button onClick={() => { setShowAddCard(false); setNewCard({ front: '', back: '' }); }} className="px-3 py-1.5 bg-slate-600 hover:bg-slate-500 rounded-lg text-sm">Cancel</button>
                              <button onClick={addCard} disabled={!newCard.front.trim() || !newCard.back.trim()} className="px-3 py-1.5 bg-indigo-600 hover:bg-indigo-500 disabled:bg-slate-600 disabled:opacity-50 rounded-lg text-sm">Add Card</button>
                            </div>
                          </div>
                        </div>
                      )}

                      {cards.map((c, i) => (
                        <div key={i} className="bg-slate-800/50 rounded-xl">
                          <div className="flex items-center">
                            <button onClick={() => setExpandedCards(p => ({ ...p, [i]: !p[i] }))} className="flex-1 px-4 py-3 flex justify-between text-left items-center">
                              <span className="text-sm flex items-center gap-2">
                                #{i + 1} {c.occlusionData ? (
                                  <span className="inline-flex items-center gap-1 text-orange-400">
                                    <Icon name="eye-off" className="w-4 h-4" />
                                    Image Occlusion Card
                                  </span>
                                ) : c.interpretationData ? (
                                  <span className="inline-flex items-center gap-1 text-teal-400">
                                    <Icon name="message-square" className="w-4 h-4" />
                                    Interpretation Card
                                  </span>
                                ) : (editingCard?.index === i ? editingCard.front : c.front)}
                              </span>
                              <span>{expandedCards[i] ? '▲' : '▼'}</span>
                            </button>
                          </div>
                          {expandedCards[i] && (
                            <div className="px-4 py-3 bg-indigo-900/20 border-t border-slate-700">
                              {editingCard?.index === i ? (
                                <div className="space-y-2">
                                  <input
                                    type="text"
                                    value={editingCard.front}
                                    onChange={(e) => setEditingCard(p => ({ ...p, front: e.target.value }))}
                                    className="w-full bg-slate-700/50 border border-slate-600 rounded-lg px-3 py-2 text-sm focus:outline-none focus:border-indigo-500"
                                    placeholder="Front (question)"
                                  />
                                  {/* Formatting Toolbar for Card Back */}
                                  <div className="flex flex-wrap gap-1 p-2 bg-slate-800/50 rounded-lg border border-slate-600">
                                    <div className="text-xs text-slate-500 w-full mb-1">Format answer:</div>
                                    <button onClick={() => { if (!cardTextareaRef.current) return; cardTextareaRef.current.focus(); document.execCommand('bold'); setTimeout(() => setEditingCard(p => ({ ...p, back: cardTextareaRef.current.innerHTML })), 10); }} className="px-2 py-1 bg-slate-700 hover:bg-slate-600 rounded text-xs font-bold">B</button>
                                    <button onClick={() => { if (!cardTextareaRef.current) return; cardTextareaRef.current.focus(); document.execCommand('italic'); setTimeout(() => setEditingCard(p => ({ ...p, back: cardTextareaRef.current.innerHTML })), 10); }} className="px-2 py-1 bg-slate-700 hover:bg-slate-600 rounded text-xs italic">I</button>
                                    <button onClick={() => { if (!cardTextareaRef.current) return; cardTextareaRef.current.focus(); document.execCommand('underline'); setTimeout(() => setEditingCard(p => ({ ...p, back: cardTextareaRef.current.innerHTML })), 10); }} className="px-2 py-1 bg-slate-700 hover:bg-slate-600 rounded text-xs underline">U</button>
                                    <button onClick={() => { if (!cardTextareaRef.current) return; cardTextareaRef.current.focus(); document.execCommand('insertUnorderedList'); setTimeout(() => setEditingCard(p => ({ ...p, back: cardTextareaRef.current.innerHTML })), 10); }} className="px-2 py-1 bg-slate-700 hover:bg-slate-600 rounded text-xs" title="Bullet point">•</button>
                                    <span className="border-l border-slate-600 mx-1"></span>
                                    {essentialSymbols.slice(0,8).map(({ symbol }) => (
                                      <button key={symbol} onClick={() => { if (!cardTextareaRef.current) return; cardTextareaRef.current.focus(); document.execCommand('insertText', false, symbol); setTimeout(() => setEditingCard(p => ({ ...p, back: cardTextareaRef.current.innerHTML })), 10); }} className="px-2 py-1 bg-slate-700 hover:bg-slate-600 rounded text-xs">{symbol}</button>
                                    ))}
                                  </div>
                                  <div
                                    ref={(el) => {
                                      cardTextareaRef.current = el;
                                      if (el && el.innerHTML !== editingCard.back) {
                                        el.innerHTML = editingCard.back || '';
                                        // Set cursor at end
                                        const range = document.createRange();
                                        const sel = window.getSelection();
                                        if (el.childNodes.length > 0) {
                                          const lastChild = el.childNodes[el.childNodes.length - 1];
                                          const lastNode = lastChild.nodeType === Node.TEXT_NODE ? lastChild : lastChild.lastChild || lastChild;
                                          try {
                                            range.setStart(lastNode, lastNode.textContent?.length || 0);
                                            range.collapse(true);
                                            sel.removeAllRanges();
                                            sel.addRange(range);
                                          } catch (e) {
                                            // Ignore if cursor positioning fails
                                          }
                                        }
                                      }
                                    }}
                                    contentEditable
                                    suppressContentEditableWarning
                                    onInput={(e) => {
                                      const html = e.currentTarget.innerHTML;
                                      setEditingCard(p => ({ ...p, back: html }));
                                    }}
                                    onKeyDown={(e) => {
                                      // Tab for indent
                                      if (e.key === 'Tab') {
                                        e.preventDefault();
                                        if (e.shiftKey) {
                                          document.execCommand('outdent');
                                        } else {
                                          document.execCommand('indent');
                                        }
                                      }
                                      // Backspace to remove indentation at start of line
                                      if (e.key === 'Backspace') {
                                        const sel = window.getSelection();
                                        if (sel && sel.rangeCount > 0) {
                                          const range = sel.getRangeAt(0);

                                          // Only proceed if nothing is selected (collapsed range)
                                          if (range.collapsed) {
                                            // Check if we're inside a blockquote (indented content)
                                            let node = range.startContainer;
                                            let blockquote = null;

                                            // Traverse up the DOM to find a blockquote
                                            while (node && node !== e.currentTarget) {
                                              if (node.nodeName === 'BLOCKQUOTE') {
                                                blockquote = node;
                                                break;
                                              }
                                              node = node.parentNode;
                                            }

                                            if (blockquote) {
                                              // Check if cursor is at the start of visible content
                                              // by checking if there's any non-whitespace text before the cursor
                                              let textBeforeCursor = '';
                                              if (range.startContainer.nodeType === Node.TEXT_NODE) {
                                                textBeforeCursor = range.startContainer.textContent.substring(0, range.startOffset);
                                              }

                                              // If no visible text before cursor, outdent
                                              if (textBeforeCursor.trim() === '') {
                                                e.preventDefault();
                                                document.execCommand('outdent');
                                              }
                                            }
                                          }
                                        }
                                      }
                                    }}
                                    className="w-full bg-slate-700/50 border border-slate-600 rounded-lg px-3 py-2 text-sm focus:outline-none focus:border-indigo-500 min-h-[60px] max-h-[200px] overflow-y-auto"
                                    style={{ whiteSpace: 'pre-wrap', wordBreak: 'break-word' }}
                                  />
                                  <div className="flex gap-2 justify-end">
                                    <button onClick={() => setEditingCard(null)} className="px-3 py-1.5 bg-slate-600 hover:bg-slate-500 rounded-lg text-sm">Cancel</button>
                                    <button onClick={saveEditCard} className="px-3 py-1.5 bg-indigo-600 hover:bg-indigo-500 rounded-lg text-sm">Save</button>
                                  </div>
                                </div>
                              ) : (
                                <>
                                  {/* Show question (front) - render HTML for occlusion cards */}
                                  {c.front.includes('<img') ? (
                                    <div className="mb-3 pb-3 border-b border-slate-700">
                                      <p className="text-xs text-slate-400 mb-2">Question:</p>
                                      <div className="text-sm text-slate-200" dangerouslySetInnerHTML={{ __html: c.front }} />
                                    </div>
                                  ) : (
                                    <div className="mb-3 pb-3 border-b border-slate-700">
                                      <p className="text-xs text-slate-400 mb-1">Q:</p>
                                      <p className="text-sm text-slate-200">{c.front}</p>
                                    </div>
                                  )}
                                  <p className="text-xs text-slate-400 mb-1">A:</p>
                                  <p className="text-sm text-indigo-300" dangerouslySetInnerHTML={{ __html: c.back }} />
                                  {/* Display attached image if present */}
                                  {c.image && (
                                    <div className="mt-3 relative inline-block">
                                      <img src={c.image.dataUrl} alt="Card image" className="max-w-[200px] max-h-[150px] rounded border border-slate-600" />
                                      <button
                                        onClick={() => {
                                          setCards(prev => prev.map((card, idx) => idx === i ? { ...card, image: null } : card));
                                        }}
                                        className="absolute -top-2 -right-2 w-5 h-5 bg-red-500 hover:bg-red-600 rounded-full flex items-center justify-center"
                                        title="Remove image"
                                      >
                                        <Icon name="x" className="w-3 h-3 text-white" />
                                      </button>
                                    </div>
                                  )}
                                  {/* Image attachment options */}
                                  {(() => {
                                    const availableImages = getAvailableImagesForCard(c);
                                    if (availableImages.length === 0 && !c.image) return null;
                                    return (
                                      <div className="mt-3 pt-3 border-t border-slate-700">
                                        {!c.image && availableImages.length > 0 && (
                                          <div className="flex flex-wrap gap-2 items-center">
                                            <span className="text-xs text-slate-400">Attach image:</span>
                                            {availableImages.map((imgOption, imgIdx) => (
                                              <button
                                                key={imgIdx}
                                                onClick={() => {
                                                  setCards(prev => prev.map((card, idx) => idx === i ? { ...card, image: imgOption.image } : card));
                                                }}
                                                className="px-2 py-1 bg-purple-600/50 hover:bg-purple-600 rounded text-xs flex items-center gap-1"
                                                title={imgOption.label}
                                              >
                                                <Icon name="image" className="w-3 h-3" />
                                                Slide {imgOption.image.pageNum}
                                              </button>
                                            ))}
                                          </div>
                                        )}
                                      </div>
                                    );
                                  })()}
                                  <div className="flex justify-between items-center mt-3">
                                    <p className="text-xs text-slate-500">Tags: {c.tags}</p>
                                    <div className="flex gap-2">
                                      <button onClick={() => startEditCard(i)} className="px-2 py-1 bg-slate-600 hover:bg-slate-500 rounded text-xs flex items-center gap-1">
                                        <Icon name="edit-2" className="w-3 h-3" />Edit
                                      </button>
                                      <button onClick={() => deleteCard(i)} className="px-2 py-1 bg-red-600/50 hover:bg-red-600 rounded text-xs flex items-center gap-1">
                                        <Icon name="trash-2" className="w-3 h-3" />Delete
                                      </button>
                                    </div>
                                  </div>
                                </>
                              )}
                            </div>
                          )}
                        </div>
                      ))}
                    </div>
                  ) : (
                    <div className="h-full flex flex-col items-center justify-center text-slate-400">
                      <p>No flashcards yet. Generate notes first, then click "Generate Flashcards".</p>
                      <div className="mt-4 flex gap-2">
                        <button onClick={() => setShowAddCard(true)} className="px-4 py-2 bg-indigo-600 hover:bg-indigo-500 rounded-lg text-sm flex items-center gap-2 text-white">
                          <Icon name="plus" className="w-4 h-4" />Add Card Manually
                        </button>
                        <input type="file" ref={csvImportInputRef} onChange={handleImportCSV} accept=".csv" className="hidden" />
                        <button onClick={() => csvImportInputRef.current?.click()} className="px-4 py-2 bg-purple-600 hover:bg-purple-500 rounded-lg text-sm flex items-center gap-2 text-white">
                          <Icon name="upload" className="w-4 h-4" />Import CSV
                        </button>
                      </div>
                    </div>
                  )}
                </div>
              </div>
            )}
          </div>
        </div>

        {/* Crop & Edit Modal */}
        {cropModalOpen && (
          <div className="fixed inset-0 bg-black/80 flex items-center justify-center z-50">
            <div className="bg-slate-800 rounded-xl p-6 max-w-5xl w-full mx-4 max-h-[95vh] flex flex-col">
              <div className="flex items-center justify-between mb-4">
                <div>
                  <h3 className="text-lg font-semibold text-slate-200">Edit Image - Slide {cropModalOpen.pageNum}</h3>
                  <p className="text-sm text-slate-400 mt-1">
                    {currentTool === 'crop' ? 'Drag to select crop area' :
                     currentTool === 'draw' ? 'Draw freehand on the image' :
                     currentTool === 'circle' ? 'Click and drag to draw a circle' :
                     currentTool === 'arrow' ? 'Click and drag to draw an arrow' :
                     currentTool === 'text' ? 'Click to place text' : 'Select a tool'}
                  </p>
                </div>
                <button
                  onClick={() => {
                    setCropModalOpen(null);
                    setCropArea(null);
                    setAnnotations([]);
                    setCurrentTool('crop');
                    setTextInput({ visible: false, x: 0, y: 0, value: '' });
                  }}
                  className="p-2 hover:bg-slate-700 rounded-lg transition-colors"
                >
                  <Icon name="x" className="w-5 h-5" />
                </button>
              </div>

              {/* Toolbar */}
              <div className="flex flex-wrap items-center gap-2 mb-4 p-3 bg-slate-700/50 rounded-lg">
                <div className="flex items-center gap-1 mr-4">
                  <span className="text-xs text-slate-400 mr-2">Tools:</span>
                  <button
                    onClick={() => setCurrentTool('crop')}
                    className={`p-2 rounded-lg transition-colors ${currentTool === 'crop' ? 'bg-purple-600 text-white' : 'bg-slate-600 hover:bg-slate-500'}`}
                    title="Crop"
                  >
                    <Icon name="crop" className="w-4 h-4" />
                  </button>
                  <button
                    onClick={() => setCurrentTool('draw')}
                    className={`p-2 rounded-lg transition-colors ${currentTool === 'draw' ? 'bg-purple-600 text-white' : 'bg-slate-600 hover:bg-slate-500'}`}
                    title="Draw"
                  >
                    <Icon name="pencil" className="w-4 h-4" />
                  </button>
                  <button
                    onClick={() => setCurrentTool('circle')}
                    className={`p-2 rounded-lg transition-colors ${currentTool === 'circle' ? 'bg-purple-600 text-white' : 'bg-slate-600 hover:bg-slate-500'}`}
                    title="Circle"
                  >
                    <Icon name="circle" className="w-4 h-4" />
                  </button>
                  <button
                    onClick={() => setCurrentTool('arrow')}
                    className={`p-2 rounded-lg transition-colors ${currentTool === 'arrow' ? 'bg-purple-600 text-white' : 'bg-slate-600 hover:bg-slate-500'}`}
                    title="Arrow"
                  >
                    <Icon name="arrow-right" className="w-4 h-4" />
                  </button>
                  <button
                    onClick={() => setCurrentTool('text')}
                    className={`p-2 rounded-lg transition-colors ${currentTool === 'text' ? 'bg-purple-600 text-white' : 'bg-slate-600 hover:bg-slate-500'}`}
                    title="Text"
                  >
                    <Icon name="type" className="w-4 h-4" />
                  </button>
                </div>

                <div className="flex items-center gap-1 mr-4">
                  <span className="text-xs text-slate-400 mr-2">Color:</span>
                  {['#ef4444', '#3b82f6', '#22c55e', '#eab308', '#000000', '#ffffff'].map(color => (
                    <button
                      key={color}
                      onClick={() => setAnnotationColor(color)}
                      className={`w-6 h-6 rounded-full border-2 transition-transform ${annotationColor === color ? 'border-purple-400 scale-110' : 'border-slate-500'}`}
                      style={{ backgroundColor: color }}
                      title={color}
                    />
                  ))}
                </div>

                {/* Font Size Selector - only show when text tool is active */}
                {currentTool === 'text' && (
                  <div className="flex items-center gap-1 mr-4">
                    <span className="text-xs text-slate-400 mr-2">Size:</span>
                    {[10, 14, 18, 24, 32].map(size => (
                      <button
                        key={size}
                        onClick={() => setTextFontSize(size)}
                        className={`px-2 py-1 rounded text-xs font-medium transition-colors ${textFontSize === size ? 'bg-purple-600 text-white' : 'bg-slate-600 hover:bg-slate-500 text-slate-300'}`}
                        title={`${size}px`}
                      >
                        {size}
                      </button>
                    ))}
                  </div>
                )}

                <div className="flex items-center gap-2">
                  <button
                    onClick={() => setAnnotations(prev => prev.slice(0, -1))}
                    disabled={annotations.length === 0}
                    className="p-2 bg-slate-600 hover:bg-slate-500 disabled:opacity-50 disabled:cursor-not-allowed rounded-lg transition-colors"
                    title="Undo"
                  >
                    <Icon name="undo-2" className="w-4 h-4" />
                  </button>
                  <button
                    onClick={() => setAnnotations([])}
                    disabled={annotations.length === 0}
                    className="p-2 bg-slate-600 hover:bg-slate-500 disabled:opacity-50 disabled:cursor-not-allowed rounded-lg transition-colors"
                    title="Clear all annotations"
                  >
                    <Icon name="trash-2" className="w-4 h-4" />
                  </button>
                </div>
              </div>

              {/* Image with overlays */}
              <div className="flex-1 overflow-auto flex items-center justify-center bg-slate-900 rounded-lg p-4">
                <div
                  className={`relative inline-block ${
                    currentTool === 'crop' ? 'cursor-crosshair' :
                    currentTool === 'text' ? 'cursor-text' : 'cursor-crosshair'
                  }`}
                  onMouseDown={(e) => {
                    const rect = e.currentTarget.getBoundingClientRect();
                    const x = e.clientX - rect.left;
                    const y = e.clientY - rect.top;

                    if (currentTool === 'crop') {
                      setIsDraggingCrop(true);
                      setCropDragStart({ x, y });
                      setCropArea({ x, y, width: 0, height: 0 });
                    } else if (currentTool === 'draw') {
                      setIsDrawing(true);
                      setCurrentPath([{ x, y }]);
                    } else if (currentTool === 'circle' || currentTool === 'arrow') {
                      setIsDrawing(true);
                      setCropDragStart({ x, y });
                    } else if (currentTool === 'text') {
                      setTextInput({ visible: true, x, y, value: '' });
                    }
                  }}
                  onMouseMove={(e) => {
                    const rect = e.currentTarget.getBoundingClientRect();
                    const currentX = Math.max(0, Math.min(e.clientX - rect.left, cropModalOpen.imageData.displayWidth));
                    const currentY = Math.max(0, Math.min(e.clientY - rect.top, cropModalOpen.imageData.displayHeight));

                    if (currentTool === 'crop' && isDraggingCrop && cropDragStart) {
                      const x = Math.min(cropDragStart.x, currentX);
                      const y = Math.min(cropDragStart.y, currentY);
                      const width = Math.abs(currentX - cropDragStart.x);
                      const height = Math.abs(currentY - cropDragStart.y);
                      setCropArea({ x, y, width, height });
                    } else if (currentTool === 'draw' && isDrawing) {
                      setCurrentPath(prev => [...prev, { x: currentX, y: currentY }]);
                    }
                  }}
                  onMouseUp={(e) => {
                    const rect = e.currentTarget.getBoundingClientRect();
                    const currentX = Math.max(0, Math.min(e.clientX - rect.left, cropModalOpen.imageData.displayWidth));
                    const currentY = Math.max(0, Math.min(e.clientY - rect.top, cropModalOpen.imageData.displayHeight));

                    if (currentTool === 'crop') {
                      setIsDraggingCrop(false);
                      setCropDragStart(null);
                      if (cropArea && cropArea.width < 20 && cropArea.height < 20) {
                        setCropArea({
                          x: 0, y: 0,
                          width: cropModalOpen.imageData.displayWidth,
                          height: cropModalOpen.imageData.displayHeight
                        });
                      }
                    } else if (currentTool === 'draw' && isDrawing && currentPath.length > 1) {
                      setAnnotations(prev => [...prev, { type: 'draw', points: currentPath, color: annotationColor }]);
                      setCurrentPath([]);
                      setIsDrawing(false);
                    } else if (currentTool === 'circle' && isDrawing && cropDragStart) {
                      const radius = Math.sqrt(Math.pow(currentX - cropDragStart.x, 2) + Math.pow(currentY - cropDragStart.y, 2));
                      if (radius > 5) {
                        setAnnotations(prev => [...prev, {
                          type: 'circle',
                          cx: cropDragStart.x,
                          cy: cropDragStart.y,
                          radius,
                          color: annotationColor
                        }]);
                      }
                      setCropDragStart(null);
                      setIsDrawing(false);
                    } else if (currentTool === 'arrow' && isDrawing && cropDragStart) {
                      const dist = Math.sqrt(Math.pow(currentX - cropDragStart.x, 2) + Math.pow(currentY - cropDragStart.y, 2));
                      if (dist > 10) {
                        setAnnotations(prev => [...prev, {
                          type: 'arrow',
                          x1: cropDragStart.x,
                          y1: cropDragStart.y,
                          x2: currentX,
                          y2: currentY,
                          color: annotationColor
                        }]);
                      }
                      setCropDragStart(null);
                      setIsDrawing(false);
                    }
                  }}
                  onMouseLeave={() => {
                    if (isDraggingCrop) {
                      setIsDraggingCrop(false);
                      setCropDragStart(null);
                    }
                    if (isDrawing && currentTool === 'draw' && currentPath.length > 1) {
                      setAnnotations(prev => [...prev, { type: 'draw', points: currentPath, color: annotationColor }]);
                      setCurrentPath([]);
                    }
                    setIsDrawing(false);
                  }}
                >
                  <img
                    src={cropModalOpen.imageData.dataUrl}
                    alt={`Slide ${cropModalOpen.pageNum}`}
                    style={{
                      width: cropModalOpen.imageData.displayWidth,
                      height: cropModalOpen.imageData.displayHeight
                    }}
                    className="rounded select-none"
                    draggable={false}
                  />

                  {/* SVG overlay for annotations */}
                  <svg
                    className="absolute inset-0 pointer-events-none"
                    width={cropModalOpen.imageData.displayWidth}
                    height={cropModalOpen.imageData.displayHeight}
                  >
                    {/* Rendered annotations */}
                    {annotations.map((ann, idx) => {
                      if (ann.type === 'draw') {
                        const pathD = ann.points.map((p, i) => `${i === 0 ? 'M' : 'L'} ${p.x} ${p.y}`).join(' ');
                        return <path key={idx} d={pathD} stroke={ann.color} strokeWidth="3" fill="none" strokeLinecap="round" strokeLinejoin="round" />;
                      } else if (ann.type === 'circle') {
                        return <circle key={idx} cx={ann.cx} cy={ann.cy} r={ann.radius} stroke={ann.color} strokeWidth="3" fill="none" />;
                      } else if (ann.type === 'arrow') {
                        // Hide SVG arrow when arrow tool selected (show interactive overlay instead)
                        if (currentTool === 'arrow') return null;
                        const angle = Math.atan2(ann.y2 - ann.y1, ann.x2 - ann.x1);
                        const headLen = 10;
                        const x3 = ann.x2 - headLen * Math.cos(angle - Math.PI / 6);
                        const y3 = ann.y2 - headLen * Math.sin(angle - Math.PI / 6);
                        const x4 = ann.x2 - headLen * Math.cos(angle + Math.PI / 6);
                        const y4 = ann.y2 - headLen * Math.sin(angle + Math.PI / 6);
                        return (
                          <g key={idx}>
                            <line x1={ann.x1} y1={ann.y1} x2={ann.x2} y2={ann.y2} stroke={ann.color} strokeWidth="2" />
                            <polygon points={`${ann.x2},${ann.y2} ${x3},${y3} ${x4},${y4}`} fill={ann.color} />
                          </g>
                        );
                      } else if (ann.type === 'text') {
                        // Hide SVG text when draggable divs are showing (text tool selected, input not visible)
                        if (currentTool === 'text' && !textInput.visible) return null;
                        return (
                          <text
                            key={idx}
                            x={ann.x}
                            y={ann.y}
                            fill={ann.color}
                            fontSize={ann.fontSize || 14}
                            fontWeight="500"
                            style={{ textShadow: '1px 1px 1px rgba(0,0,0,0.4)' }}
                          >
                            {ann.text}
                          </text>
                        );
                      }
                      return null;
                    })}

                    {/* Current drawing path */}
                    {currentTool === 'draw' && currentPath.length > 1 && (
                      <path
                        d={currentPath.map((p, i) => `${i === 0 ? 'M' : 'L'} ${p.x} ${p.y}`).join(' ')}
                        stroke={annotationColor}
                        strokeWidth="3"
                        fill="none"
                        strokeLinecap="round"
                        strokeLinejoin="round"
                      />
                    )}
                  </svg>

                  {/* Draggable text annotation handles - only show when text tool selected and input not visible */}
                  {currentTool === 'text' && !textInput.visible && annotations.map((ann, idx) => {
                    if (ann.type !== 'text') return null;
                    const isHovered = hoveredTextIndex === idx;
                    const isDragging = draggingTextIndex === idx;
                    const isResizing = resizingTextIndex === idx;
                    const fontSize = ann.fontSize || 14;
                    return (
                      <div
                        key={`drag-${idx}`}
                        className="absolute cursor-move select-none"
                        style={{
                          left: ann.x - 5,
                          top: ann.y - fontSize - 2,
                          padding: '3px 6px',
                          paddingRight: '28px',
                          background: isDragging || isHovered || isResizing ? 'rgba(139, 92, 246, 0.2)' : 'transparent',
                          border: isDragging || isHovered || isResizing ? '1px dashed #8B5CF6' : '1px dashed transparent',
                          borderRadius: '4px',
                          color: ann.color,
                          fontSize: `${fontSize}px`,
                          fontWeight: '500',
                          textShadow: '1px 1px 1px rgba(0,0,0,0.4)',
                          zIndex: 40
                        }}
                        onMouseEnter={() => setHoveredTextIndex(idx)}
                        onMouseLeave={() => { if (!isResizing) setHoveredTextIndex(null); }}
                        onMouseDown={(e) => {
                          e.stopPropagation();
                          e.preventDefault();
                          setDraggingTextIndex(idx);
                          setDragOffset({
                            x: e.clientX - ann.x,
                            y: e.clientY - ann.y
                          });
                        }}
                      >
                        {ann.text}
                        {/* Delete button - only show on hover */}
                        {(isHovered || isResizing) && !isDragging && (
                          <button
                            className="absolute -top-2 -right-2 w-5 h-5 bg-red-500 hover:bg-red-600 rounded-full flex items-center justify-center shadow-md"
                            style={{ zIndex: 45 }}
                            onClick={(e) => {
                              e.stopPropagation();
                              e.preventDefault();
                              setAnnotations(prev => prev.filter((_, i) => i !== idx));
                              setHoveredTextIndex(null);
                            }}
                            onMouseDown={(e) => {
                              e.stopPropagation();
                              e.preventDefault();
                            }}
                          >
                            <Icon name="x" className="w-3 h-3 text-white" />
                          </button>
                        )}
                        {/* Resize handle - bottom right corner */}
                        {(isHovered || isResizing) && !isDragging && (
                          <div
                            className="absolute -bottom-1 -right-1 w-4 h-4 bg-purple-500 hover:bg-purple-400 rounded-sm cursor-ns-resize flex items-center justify-center shadow-md"
                            style={{ zIndex: 45 }}
                            onMouseDown={(e) => {
                              e.stopPropagation();
                              e.preventDefault();
                              setResizingTextIndex(idx);
                              setResizeStartFontSize(fontSize);
                              setResizeStartY(e.clientY);
                            }}
                          >
                            <Icon name="move-vertical" className="w-2.5 h-2.5 text-white" />
                          </div>
                        )}
                      </div>
                    );
                  })}

                  {/* Arrow annotation overlays - only show when arrow tool selected */}
                  {currentTool === 'arrow' && annotations.map((ann, idx) => {
                    if (ann.type !== 'arrow') return null;
                    const isHovered = hoveredArrowIndex === idx;
                    // Calculate arrow bounding box
                    const minX = Math.min(ann.x1, ann.x2) - 10;
                    const minY = Math.min(ann.y1, ann.y2) - 10;
                    const maxX = Math.max(ann.x1, ann.x2) + 10;
                    const maxY = Math.max(ann.y1, ann.y2) + 10;
                    // Calculate arrow properties for drawing
                    const angle = Math.atan2(ann.y2 - ann.y1, ann.x2 - ann.x1);
                    const headLen = 10;
                    const x3 = ann.x2 - headLen * Math.cos(angle - Math.PI / 6);
                    const y3 = ann.y2 - headLen * Math.sin(angle - Math.PI / 6);
                    const x4 = ann.x2 - headLen * Math.cos(angle + Math.PI / 6);
                    const y4 = ann.y2 - headLen * Math.sin(angle + Math.PI / 6);
                    return (
                      <div
                        key={`arrow-${idx}`}
                        className="absolute"
                        style={{
                          left: minX,
                          top: minY,
                          width: maxX - minX,
                          height: maxY - minY,
                          zIndex: 40
                        }}
                        onMouseEnter={() => setHoveredArrowIndex(idx)}
                        onMouseLeave={() => setHoveredArrowIndex(null)}
                      >
                        {/* SVG to render the arrow */}
                        <svg
                          width={maxX - minX}
                          height={maxY - minY}
                          className="absolute inset-0"
                          style={{ pointerEvents: 'none' }}
                        >
                          <line
                            x1={ann.x1 - minX}
                            y1={ann.y1 - minY}
                            x2={ann.x2 - minX}
                            y2={ann.y2 - minY}
                            stroke={isHovered ? '#8B5CF6' : ann.color}
                            strokeWidth="2"
                          />
                          <polygon
                            points={`${ann.x2 - minX},${ann.y2 - minY} ${x3 - minX},${y3 - minY} ${x4 - minX},${y4 - minY}`}
                            fill={isHovered ? '#8B5CF6' : ann.color}
                          />
                        </svg>
                        {/* Delete button - only show on hover */}
                        {isHovered && (
                          <button
                            className="absolute -top-2 -right-2 w-5 h-5 bg-red-500 hover:bg-red-600 rounded-full flex items-center justify-center shadow-md"
                            style={{ zIndex: 45 }}
                            onClick={(e) => {
                              e.stopPropagation();
                              e.preventDefault();
                              setAnnotations(prev => prev.filter((_, i) => i !== idx));
                              setHoveredArrowIndex(null);
                            }}
                          >
                            <Icon name="x" className="w-3 h-3 text-white" />
                          </button>
                        )}
                      </div>
                    );
                  })}

                  {/* Global mouse handlers for dragging */}
                  {draggingTextIndex !== null && (
                    <div
                      className="fixed inset-0 z-50 cursor-move"
                      onMouseMove={(e) => {
                        const newX = Math.max(5, Math.min(e.clientX - dragOffset.x, (cropModalOpen?.imageData?.displayWidth || 400) - 20));
                        const newY = Math.max(20, Math.min(e.clientY - dragOffset.y, (cropModalOpen?.imageData?.displayHeight || 300) - 5));
                        setAnnotations(prev => prev.map((ann, i) =>
                          i === draggingTextIndex ? { ...ann, x: newX, y: newY } : ann
                        ));
                      }}
                      onMouseUp={() => setDraggingTextIndex(null)}
                      onMouseLeave={() => setDraggingTextIndex(null)}
                    />
                  )}

                  {/* Global mouse handlers for text resizing */}
                  {resizingTextIndex !== null && (
                    <div
                      className="fixed inset-0 z-50 cursor-ns-resize"
                      onMouseMove={(e) => {
                        const deltaY = e.clientY - resizeStartY;
                        // Increase font size as user drags down, decrease as they drag up
                        const newFontSize = Math.max(8, Math.min(48, resizeStartFontSize + Math.round(deltaY / 3)));
                        setAnnotations(prev => prev.map((ann, i) =>
                          i === resizingTextIndex ? { ...ann, fontSize: newFontSize } : ann
                        ));
                      }}
                      onMouseUp={() => {
                        setResizingTextIndex(null);
                        setResizeStartFontSize(null);
                        setResizeStartY(null);
                        setHoveredTextIndex(null);
                      }}
                      onMouseLeave={() => {
                        setResizingTextIndex(null);
                        setResizeStartFontSize(null);
                        setResizeStartY(null);
                        setHoveredTextIndex(null);
                      }}
                    />
                  )}

                  {/* Text input */}
                  {textInput.visible && (
                    <input
                      type="text"
                      ref={(input) => input && setTimeout(() => input.focus(), 10)}
                      value={textInput.value}
                      onChange={(e) => setTextInput(prev => ({ ...prev, value: e.target.value }))}
                      onKeyDown={(e) => {
                        e.stopPropagation();
                        if (e.key === 'Enter') {
                          e.preventDefault();
                          textSubmittedRef.current = true;
                          if (textInput.value.trim()) {
                            setAnnotations(prev => [...prev, {
                              type: 'text',
                              x: textInput.x,
                              y: textInput.y,
                              text: textInput.value,
                              color: annotationColor,
                              fontSize: textFontSize
                            }]);
                          }
                          setTextInput({ visible: false, x: 0, y: 0, value: '' });
                        } else if (e.key === 'Escape') {
                          e.preventDefault();
                          textSubmittedRef.current = true;
                          setTextInput({ visible: false, x: 0, y: 0, value: '' });
                        }
                      }}
                      onBlur={(e) => {
                        setTimeout(() => {
                          if (textSubmittedRef.current) {
                            textSubmittedRef.current = false;
                            return;
                          }
                          setTextInput({ visible: false, x: 0, y: 0, value: '' });
                        }, 50);
                      }}
                      onClick={(e) => e.stopPropagation()}
                      onMouseDown={(e) => e.stopPropagation()}
                      className="absolute bg-slate-800/90 border-2 border-purple-500 rounded px-2 py-1 text-white font-medium outline-none min-w-[100px] z-50"
                      style={{
                        left: Math.min(textInput.x, (cropModalOpen?.imageData?.displayWidth || 400) - 160),
                        top: Math.max(0, textInput.y - textFontSize - 10),
                        color: annotationColor,
                        fontSize: `${textFontSize}px`,
                        textShadow: '1px 1px 2px rgba(0,0,0,0.5)'
                      }}
                      placeholder="Type and press Enter..."
                    />
                  )}

                  {/* Crop overlay (only show when crop tool is active) */}
                  {currentTool === 'crop' && cropArea && (cropArea.width > 0 || cropArea.height > 0) && (
                    <>
                      <div className="absolute bg-black/60 pointer-events-none" style={{ top: 0, left: 0, right: 0, height: cropArea.y }} />
                      <div className="absolute bg-black/60 pointer-events-none" style={{ top: cropArea.y + cropArea.height, left: 0, right: 0, bottom: 0 }} />
                      <div className="absolute bg-black/60 pointer-events-none" style={{ top: cropArea.y, left: 0, width: cropArea.x, height: cropArea.height }} />
                      <div className="absolute bg-black/60 pointer-events-none" style={{ top: cropArea.y, left: cropArea.x + cropArea.width, right: 0, height: cropArea.height }} />
                      <div className="absolute border-2 border-purple-500 pointer-events-none" style={{ top: cropArea.y, left: cropArea.x, width: cropArea.width, height: cropArea.height }}>
                        <div className="absolute -top-1 -left-1 w-3 h-3 bg-purple-500 rounded-sm" />
                        <div className="absolute -top-1 -right-1 w-3 h-3 bg-purple-500 rounded-sm" />
                        <div className="absolute -bottom-1 -left-1 w-3 h-3 bg-purple-500 rounded-sm" />
                        <div className="absolute -bottom-1 -right-1 w-3 h-3 bg-purple-500 rounded-sm" />
                      </div>
                    </>
                  )}
                </div>
              </div>

              {/* Action buttons */}
              <div className="flex items-center justify-between mt-4 pt-4 border-t border-slate-700">
                <button
                  onClick={() => {
                    setCropArea({
                      x: 0,
                      y: 0,
                      width: cropModalOpen.imageData.displayWidth,
                      height: cropModalOpen.imageData.displayHeight
                    });
                    setCurrentTool('crop');
                  }}
                  className="px-4 py-2 bg-slate-700 hover:bg-slate-600 rounded-lg text-sm flex items-center gap-2"
                >
                  <Icon name="maximize-2" className="w-4 h-4" />
                  Reset Crop
                </button>
                <div className="flex gap-3">
                  <button
                    onClick={() => {
                      setCropModalOpen(null);
                      setCropArea(null);
                      setAnnotations([]);
                      setCurrentTool('crop');
                      setTextInput({ visible: false, x: 0, y: 0, value: '' });
                    }}
                    className="px-4 py-2 bg-slate-600 hover:bg-slate-500 rounded-lg text-sm"
                  >
                    Cancel
                  </button>
                  <button
                    onClick={confirmCropAndInsert}
                    className="px-4 py-2 bg-purple-600 hover:bg-purple-500 rounded-lg text-sm flex items-center gap-2"
                  >
                    <Icon name="check" className="w-4 h-4" />
                    Insert Image
                  </button>
                </div>
              </div>
            </div>
          </div>
        )}

        {/* Image Picker Modal */}
        {imagePickerOpen && (() => {
          // Filter and sort thumbnails based on search query
          const filteredThumbnails = pdfThumbnails
            .filter(thumb => {
              if (!imageSearchQuery.trim()) return true;
              return thumb.text.includes(imageSearchQuery.toLowerCase());
            })
            .sort((a, b) => {
              // Always sort by page number to maintain PDF order
              return a.pageNum - b.pageNum;
            });

          // Get existing images from notes for "From Notes" tab
          const existingImages = Object.entries(pointImages).map(([key, img]) => {
            const [sIdx, pIdx] = key.split('-').map(Number);
            const sectionTitle = notes?.notes?.[sIdx]?.section || `Section ${sIdx + 1}`;
            const figNum = getFigureNumber(sIdx, pIdx, 'point');
            return { key, img, sIdx, pIdx, sectionTitle, figNum };
          });

          return (
          <div className="fixed inset-0 bg-black/70 flex items-center justify-center z-50">
            <div className="bg-slate-800 rounded-xl p-6 max-w-4xl w-full mx-4 max-h-[90vh] flex flex-col">
              <div className="flex items-center justify-between mb-4">
                <div>
                  <h3 className="text-lg font-semibold text-slate-200">Insert Image</h3>
                  <p className="text-sm text-slate-400 mt-1">
                    {imagePickerTab === 'slides'
                      ? (thumbnailsLoading
                          ? 'Loading slide thumbnails...'
                          : `${filteredThumbnails.length} of ${pdfThumbnails.length} slides`)
                      : `${existingImages.length} images in notes`}
                  </p>
                </div>
                <button
                  onClick={() => { setImagePickerOpen(null); setImageSearchQuery(''); setSlidePreviewIndex(null); }}
                  className="p-2 hover:bg-slate-700 rounded-lg transition-colors"
                >
                  <Icon name="x" className="w-5 h-5" />
                </button>
              </div>

              {/* Tab Buttons */}
              <div className="flex gap-2 mb-4">
                <button
                  onClick={() => setImagePickerTab('slides')}
                  className={`px-4 py-2 rounded-lg text-sm font-medium transition-colors flex items-center gap-2 ${
                    imagePickerTab === 'slides'
                      ? 'bg-indigo-600 text-white'
                      : 'bg-slate-700 text-slate-300 hover:bg-slate-600'
                  }`}
                >
                  <Icon name="file-image" className="w-4 h-4" />
                  From Slides
                </button>
                <button
                  onClick={() => setImagePickerTab('notes')}
                  className={`px-4 py-2 rounded-lg text-sm font-medium transition-colors flex items-center gap-2 ${
                    imagePickerTab === 'notes'
                      ? 'bg-indigo-600 text-white'
                      : 'bg-slate-700 text-slate-300 hover:bg-slate-600'
                  } ${existingImages.length === 0 ? 'opacity-50 cursor-not-allowed' : ''}`}
                  disabled={existingImages.length === 0}
                >
                  <Icon name="link" className="w-4 h-4" />
                  From Notes ({existingImages.length})
                </button>
              </div>

              {imagePickerTab === 'notes' ? (
                /* From Notes Tab */
                existingImages.length === 0 ? (
                  <div className="flex-1 flex items-center justify-center">
                    <div className="text-center">
                      <Icon name="image-off" className="w-12 h-12 mx-auto text-slate-500" />
                      <p className="text-slate-400 mt-2">No images in notes yet</p>
                      <p className="text-sm text-slate-500">Insert an image from slides first</p>
                    </div>
                  </div>
                ) : (
                  <div className="flex-1 overflow-y-auto">
                    <p className="text-xs text-slate-500 mb-3">Select an existing image to reference:</p>
                    <div className="grid grid-cols-3 sm:grid-cols-4 gap-4">
                      {existingImages.map(({ key, img, sIdx, pIdx, sectionTitle, figNum }) => {
                        const currentKey = getPointImageKey(imagePickerOpen.sectionIndex, imagePickerOpen.pointIndex);
                        const isCurrentPoint = key === currentKey;

                        return (
                          <button
                            key={key}
                            onClick={() => {
                              if (!isCurrentPoint) {
                                const { sectionIndex, pointIndex } = imagePickerOpen;
                                setImageReference(sectionIndex, pointIndex, key);
                                setImagePickerOpen(null);
                                setImageSearchQuery('');
                              }
                            }}
                            disabled={isCurrentPoint}
                            className={`group relative rounded-lg overflow-hidden border-2 transition-all ${
                              isCurrentPoint
                                ? 'border-slate-500 opacity-50 cursor-not-allowed'
                                : 'border-slate-600 hover:border-indigo-500 hover:ring-2 hover:ring-indigo-500/50'
                            }`}
                          >
                            <img
                              src={img.dataUrl}
                              alt={`Fig ${figNum}`}
                              className="w-full aspect-video object-contain bg-white"
                            />
                            <div className="absolute bottom-0 left-0 right-0 bg-gradient-to-t from-black/90 to-transparent p-2">
                              <span className="text-xs text-white font-medium block">Fig {figNum}</span>
                              <span className="text-xs text-slate-300 block truncate">{sectionTitle}</span>
                              {isCurrentPoint && (
                                <span className="text-xs text-yellow-400 block mt-1">Current point</span>
                              )}
                            </div>
                            {!isCurrentPoint && (
                              <div className="absolute inset-0 bg-indigo-500/20 opacity-0 group-hover:opacity-100 transition-opacity flex items-center justify-center">
                                <Icon name="link" className="w-8 h-8 text-white" />
                              </div>
                            )}
                          </button>
                        );
                      })}
                    </div>
                  </div>
                )
              ) : (
                /* From Slides Tab */
                <>
                  {/* Search Box */}
                  {!thumbnailsLoading && pdfThumbnails.length > 0 && (
                    <div className="relative mb-4">
                      <Icon name="search" className="absolute left-3 top-1/2 -translate-y-1/2 w-4 h-4 text-slate-400" />
                      <input
                        type="text"
                        value={imageSearchQuery}
                        onChange={(e) => { setImageSearchQuery(e.target.value); setSlidePreviewIndex(null); }}
                        placeholder="Search slides by text content..."
                        className="w-full bg-slate-700 border border-slate-600 rounded-lg pl-10 pr-4 py-2 text-sm focus:outline-none focus:border-purple-500 placeholder-slate-400"
                      />
                      {imageSearchQuery && (
                        <button
                          onClick={() => { setImageSearchQuery(''); setSlidePreviewIndex(null); }}
                          className="absolute right-3 top-1/2 -translate-y-1/2 p-1 hover:bg-slate-600 rounded"
                        >
                          <Icon name="x" className="w-3 h-3 text-slate-400" />
                        </button>
                      )}
                    </div>
                  )}

                  {thumbnailsLoading ? (
                    <div className="flex-1 flex items-center justify-center">
                      <div className="text-center">
                        <Icon name="loader-2" className="w-8 h-8 mx-auto animate-spin text-purple-400" />
                        <p className="text-slate-400 mt-2">Generating thumbnails...</p>
                      </div>
                    </div>
                  ) : pdfThumbnails.length === 0 ? (
                    <div className="flex-1 flex items-center justify-center">
                      <div className="text-center">
                        <Icon name="image-off" className="w-12 h-12 mx-auto text-slate-500" />
                        <p className="text-slate-400 mt-2">No slides available</p>
                        <p className="text-sm text-slate-500">Upload a PDF first</p>
                      </div>
                    </div>
                  ) : filteredThumbnails.length === 0 ? (
                    <div className="flex-1 flex items-center justify-center">
                      <div className="text-center">
                        <Icon name="search-x" className="w-12 h-12 mx-auto text-slate-500" />
                        <p className="text-slate-400 mt-2">No matching slides</p>
                        <p className="text-sm text-slate-500">Try a different search term</p>
                      </div>
                    </div>
                  ) : (
                    <div className="flex-1 flex gap-4 min-h-0">
                      {/* Thumbnail strip on left */}
                      <div className="w-32 flex-shrink-0 overflow-y-auto space-y-2 pr-2">
                        {filteredThumbnails.map((thumb, idx) => (
                          <button
                            key={thumb.pageNum}
                            onClick={() => setSlidePreviewIndex(idx)}
                            className={`w-full relative rounded-lg overflow-hidden transition-all ${
                              slidePreviewIndex === idx
                                ? 'ring-2 ring-purple-500 ring-offset-2 ring-offset-slate-800'
                                : 'hover:ring-2 hover:ring-slate-500'
                            }`}
                          >
                            <img
                              src={thumb.dataUrl}
                              alt={`Slide ${thumb.pageNum}`}
                              className="w-full aspect-[4/3] object-contain bg-white"
                            />
                            <div className="absolute bottom-0 left-0 right-0 bg-gradient-to-t from-black/80 to-transparent p-1">
                              <span className="text-xs text-white font-medium">{thumb.pageNum}</span>
                            </div>
                          </button>
                        ))}
                      </div>

                      {/* Large preview on right */}
                      <div className="flex-1 flex flex-col min-h-0">
                        {slidePreviewIndex !== null && filteredThumbnails[slidePreviewIndex] ? (
                          <>
                            {/* Preview image */}
                            <div className="flex-1 flex items-center justify-center bg-slate-900 rounded-lg relative min-h-0">
                              <img
                                src={filteredThumbnails[slidePreviewIndex].dataUrl}
                                alt={`Slide ${filteredThumbnails[slidePreviewIndex].pageNum}`}
                                className="max-w-full max-h-full object-contain"
                              />

                              {/* Navigation arrows */}
                              <button
                                onClick={() => setSlidePreviewIndex(Math.max(0, slidePreviewIndex - 1))}
                                disabled={slidePreviewIndex === 0}
                                className="absolute left-2 top-1/2 -translate-y-1/2 p-2 bg-black/50 hover:bg-black/70 disabled:opacity-30 disabled:cursor-not-allowed rounded-full transition-colors"
                              >
                                <Icon name="chevron-left" className="w-6 h-6" />
                              </button>
                              <button
                                onClick={() => setSlidePreviewIndex(Math.min(filteredThumbnails.length - 1, slidePreviewIndex + 1))}
                                disabled={slidePreviewIndex === filteredThumbnails.length - 1}
                                className="absolute right-2 top-1/2 -translate-y-1/2 p-2 bg-black/50 hover:bg-black/70 disabled:opacity-30 disabled:cursor-not-allowed rounded-full transition-colors"
                              >
                                <Icon name="chevron-right" className="w-6 h-6" />
                              </button>
                            </div>

                            {/* Slide info and select button */}
                            <div className="flex items-center justify-between mt-3 pt-3 border-t border-slate-700">
                              <div>
                                <span className="text-sm font-medium">Slide {filteredThumbnails[slidePreviewIndex].pageNum}</span>
                                <span className="text-xs text-slate-400 ml-2">({slidePreviewIndex + 1} of {filteredThumbnails.length})</span>
                              </div>
                              <button
                                onClick={async () => {
                                  const thumb = filteredThumbnails[slidePreviewIndex];
                                  console.log('Selected slide:', thumb.pageNum);
                                  const { type, sectionIndex, pointIndex } = imagePickerOpen;

                                  const fullResImage = await generateFullResImage(thumb.pageNum);
                                  if (fullResImage) {
                                    fullResImage.displayWidth = Math.min(fullResImage.width, 700);
                                    fullResImage.displayHeight = (fullResImage.height / fullResImage.width) * fullResImage.displayWidth;

                                    setCropModalOpen({
                                      type: type || 'point',
                                      sectionIndex,
                                      pointIndex,
                                      imageData: fullResImage,
                                      pageNum: thumb.pageNum
                                    });
                                    setCropArea({
                                      x: 0,
                                      y: 0,
                                      width: fullResImage.displayWidth,
                                      height: fullResImage.displayHeight
                                    });
                                  }

                                  setImagePickerOpen(null);
                                  setImageSearchQuery('');
                                  setSlidePreviewIndex(null);
                                }}
                                className="px-4 py-2 bg-purple-600 hover:bg-purple-500 rounded-lg text-sm font-medium flex items-center gap-2"
                              >
                                <Icon name="check" className="w-4 h-4" />
                                Select This Slide
                              </button>
                            </div>
                          </>
                        ) : (
                          <div className="flex-1 flex items-center justify-center bg-slate-900/50 rounded-lg">
                            <div className="text-center">
                              <Icon name="image" className="w-16 h-16 mx-auto text-slate-600" />
                              <p className="text-slate-400 mt-3">Click a thumbnail to preview</p>
                              <p className="text-xs text-slate-500 mt-1">Use arrow keys to navigate</p>
                            </div>
                          </div>
                        )}
                      </div>
                    </div>
                  )}
                </>
              )}

              <div className="flex justify-end mt-4 pt-4 border-t border-slate-700">
                <button
                  onClick={() => { setImagePickerOpen(null); setImageSearchQuery(''); setSlidePreviewIndex(null); }}
                  className="px-4 py-2 bg-slate-600 hover:bg-slate-500 rounded-lg text-sm"
                >
                  Cancel
                </button>
              </div>
            </div>
          </div>
          );
        })()}

        {/* Image Occlusion Modal */}
        {occlusionModalOpen && (
          <div className="fixed inset-0 bg-black/80 flex items-center justify-center z-50">
            <div className="bg-slate-800 rounded-xl p-6 max-w-5xl w-full mx-4 max-h-[95vh] flex flex-col">
              {/* Header */}
              <div className="flex items-center justify-between mb-4">
                <div>
                  <h3 className="text-lg font-semibold text-slate-200">
                    {occlusionStep === 'select' && 'Select Image for Occlusion Cards'}
                    {occlusionStep === 'edit' && 'Draw Labels'}
                  </h3>
                  <p className="text-sm text-slate-400 mt-1">
                    {occlusionStep === 'select' && 'Choose an image from your notes to create occlusion cards'}
                    {occlusionStep === 'edit' && 'Draw boxes over labels, then enter the label text'}
                  </p>
                </div>
                <button
                  onClick={() => {
                    setOcclusionModalOpen(false);
                    setOcclusionStep('select');
                    setSelectedOcclusionImage(null);
                    setDetectedLabels([]);
                  }}
                  className="p-2 hover:bg-slate-700 rounded-lg transition-colors"
                >
                  <Icon name="x" className="w-5 h-5" />
                </button>
              </div>

              {/* Step 1: Image Selection */}
              {occlusionStep === 'select' && (
                <div className="flex-1 overflow-y-auto">
                  <div className="grid grid-cols-2 md:grid-cols-3 gap-4">
                    {getAllNotesImages().map((imgData, idx) => (
                      <button
                        key={idx}
                        onClick={() => {
                          setSelectedOcclusionImage(imgData);
                          setDetectedLabels([]);
                          setOcclusionStep('edit');
                        }}
                        className="group relative bg-slate-700 rounded-lg overflow-hidden hover:ring-2 hover:ring-orange-500 transition-all"
                      >
                        <img
                          src={imgData.image.dataUrl}
                          alt={imgData.label}
                          className="w-full h-40 object-contain bg-white"
                        />
                        <div className="absolute bottom-0 left-0 right-0 bg-gradient-to-t from-black/80 to-transparent p-2">
                          <span className="text-xs text-white">Slide {imgData.image.pageNum}</span>
                          <p className="text-xs text-slate-300 truncate">{imgData.label}</p>
                        </div>
                      </button>
                    ))}
                  </div>
                  {getAllNotesImages().length === 0 && (
                    <div className="text-center text-slate-400 py-8">
                      <Icon name="image" className="w-12 h-12 mx-auto mb-2 opacity-50" />
                      <p>No images found in your notes.</p>
                      <p className="text-sm mt-1">Add images to your notes first using the image button next to each bullet point.</p>
                    </div>
                  )}
                </div>
              )}

              {/* Step 2: Draw Labels */}
              {occlusionStep === 'edit' && selectedOcclusionImage && (
                <div className="flex-1 flex gap-4 min-h-0">
                  {/* Image with overlaid boxes */}
                  <div className="flex-1 relative bg-slate-900 rounded-lg overflow-hidden flex items-center justify-center">
                    <div
                      className="relative inline-block"
                      onMouseDown={(e) => {
                        // Only start drawing if clicking directly on the container or image
                        if ((e.target === e.currentTarget || e.target.tagName === 'IMG') && !draggingLabel && !resizingLabel) {
                          const rect = e.currentTarget.getBoundingClientRect();
                          const x = ((e.clientX - rect.left) / rect.width) * 100;
                          const y = ((e.clientY - rect.top) / rect.height) * 100;
                          setDrawingOcclusionBox({ startX: x, startY: y, currentX: x, currentY: y });
                        }
                      }}
                      onMouseMove={(e) => {
                        const rect = e.currentTarget.getBoundingClientRect();
                        const x = Math.max(0, Math.min(100, ((e.clientX - rect.left) / rect.width) * 100));
                        const y = Math.max(0, Math.min(100, ((e.clientY - rect.top) / rect.height) * 100));

                        if (drawingOcclusionBox) {
                          setDrawingOcclusionBox(prev => ({ ...prev, currentX: x, currentY: y }));
                        } else if (draggingLabel) {
                          // Move the label
                          setDetectedLabels(prev => prev.map(l => {
                            if (l.id !== draggingLabel.id) return l;
                            const newX = Math.max(0, Math.min(100 - l.width, x - draggingLabel.offsetX));
                            const newY = Math.max(0, Math.min(100 - l.height, y - draggingLabel.offsetY));
                            return { ...l, x: newX, y: newY };
                          }));
                        } else if (resizingLabel) {
                          // Resize the label based on which handle is being dragged
                          setDetectedLabels(prev => prev.map(l => {
                            if (l.id !== resizingLabel.id) return l;
                            const orig = resizingLabel.origBox;
                            let newX = orig.x, newY = orig.y, newW = orig.width, newH = orig.height;

                            if (resizingLabel.handle.includes('w')) {
                              newX = Math.min(x, orig.x + orig.width - 2);
                              newW = orig.x + orig.width - newX;
                            }
                            if (resizingLabel.handle.includes('e')) {
                              newW = Math.max(2, x - orig.x);
                            }
                            if (resizingLabel.handle.includes('n')) {
                              newY = Math.min(y, orig.y + orig.height - 2);
                              newH = orig.y + orig.height - newY;
                            }
                            if (resizingLabel.handle.includes('s')) {
                              newH = Math.max(2, y - orig.y);
                            }

                            return { ...l, x: Math.max(0, newX), y: Math.max(0, newY), width: Math.min(100, newW), height: Math.min(100, newH) };
                          }));
                        }
                      }}
                      onMouseUp={(e) => {
                        if (drawingOcclusionBox) {
                          const minX = Math.min(drawingOcclusionBox.startX, drawingOcclusionBox.currentX);
                          const minY = Math.min(drawingOcclusionBox.startY, drawingOcclusionBox.currentY);
                          const width = Math.abs(drawingOcclusionBox.currentX - drawingOcclusionBox.startX);
                          const height = Math.abs(drawingOcclusionBox.currentY - drawingOcclusionBox.startY);

                          if (width > 2 && height > 2) {
                            const newId = `label-manual-${Date.now()}`;
                            setDetectedLabels(prev => [...prev, {
                              id: newId,
                              text: '',
                              x: minX,
                              y: minY,
                              width: width,
                              height: height,
                              enabled: true
                            }]);
                            // Auto-focus the new label for text entry
                            setTimeout(() => setEditingLabelId(newId), 50);
                          }
                          setDrawingOcclusionBox(null);
                        }
                        setDraggingLabel(null);
                        setResizingLabel(null);
                      }}
                      onMouseLeave={() => {
                        setDrawingOcclusionBox(null);
                        setDraggingLabel(null);
                        setResizingLabel(null);
                      }}
                    >
                      <img
                        src={selectedOcclusionImage.image.dataUrl}
                        alt="Selected image"
                        className="max-w-full max-h-[60vh] select-none"
                        draggable={false}
                      />
                      {/* Render label boxes */}
                      {detectedLabels.map((label) => (
                        <div
                          key={label.id}
                          className={`absolute border-2 ${label.enabled ? 'border-orange-500 bg-orange-500/20' : 'border-slate-500 bg-slate-500/10'} transition-colors`}
                          style={{
                            left: `${label.x}%`,
                            top: `${label.y}%`,
                            width: `${label.width}%`,
                            height: `${label.height}%`,
                            cursor: draggingLabel?.id === label.id ? 'grabbing' : 'move'
                          }}
                          onMouseDown={(e) => {
                            e.stopPropagation();
                            const rect = e.currentTarget.parentElement.getBoundingClientRect();
                            const mouseX = ((e.clientX - rect.left) / rect.width) * 100;
                            const mouseY = ((e.clientY - rect.top) / rect.height) * 100;
                            setDraggingLabel({
                              id: label.id,
                              offsetX: mouseX - label.x,
                              offsetY: mouseY - label.y
                            });
                          }}
                          onDoubleClick={(e) => {
                            e.stopPropagation();
                            setDetectedLabels(prev => prev.map(l =>
                              l.id === label.id ? { ...l, enabled: !l.enabled } : l
                            ));
                          }}
                          title="Drag to move • Double-click to toggle"
                        >
                          {/* Label text */}
                          <span className={`absolute -top-5 left-0 text-xs px-1 rounded whitespace-nowrap ${label.enabled ? 'bg-orange-500 text-white' : 'bg-slate-500 text-slate-200'}`}>
                            {label.text.substring(0, 20)}{label.text.length > 20 ? '...' : ''}
                          </span>
                          {/* Resize handles */}
                          {['nw', 'ne', 'sw', 'se'].map(handle => (
                            <div
                              key={handle}
                              className={`absolute w-3 h-3 bg-orange-500 border border-white rounded-sm ${
                                handle === 'nw' ? '-top-1.5 -left-1.5 cursor-nwse-resize' :
                                handle === 'ne' ? '-top-1.5 -right-1.5 cursor-nesw-resize' :
                                handle === 'sw' ? '-bottom-1.5 -left-1.5 cursor-nesw-resize' :
                                '-bottom-1.5 -right-1.5 cursor-nwse-resize'
                              }`}
                              onMouseDown={(e) => {
                                e.stopPropagation();
                                setResizingLabel({
                                  id: label.id,
                                  handle: handle,
                                  origBox: { x: label.x, y: label.y, width: label.width, height: label.height }
                                });
                              }}
                            />
                          ))}
                        </div>
                      ))}
                      {/* Drawing box preview */}
                      {drawingOcclusionBox && (
                        <div
                          className="absolute border-2 border-dashed border-green-500 bg-green-500/20 pointer-events-none"
                          style={{
                            left: `${Math.min(drawingOcclusionBox.startX, drawingOcclusionBox.currentX)}%`,
                            top: `${Math.min(drawingOcclusionBox.startY, drawingOcclusionBox.currentY)}%`,
                            width: `${Math.abs(drawingOcclusionBox.currentX - drawingOcclusionBox.startX)}%`,
                            height: `${Math.abs(drawingOcclusionBox.currentY - drawingOcclusionBox.startY)}%`
                          }}
                        />
                      )}
                    </div>
                  </div>

                  {/* Labels list */}
                  <div className="w-72 bg-slate-700/50 rounded-lg p-3 overflow-y-auto">
                    <div className="flex items-center justify-between mb-3">
                      <h4 className="text-sm font-semibold text-slate-200">Labels ({detectedLabels.filter(l => l.enabled).length}/{detectedLabels.length})</h4>
                      <button
                        onClick={() => setDetectedLabels(prev => prev.map(l => ({ ...l, enabled: true })))}
                        className="text-xs text-orange-400 hover:text-orange-300"
                      >
                        Enable All
                      </button>
                    </div>
                    <div className="space-y-2">
                      {detectedLabels.map((label) => (
                        <div
                          key={label.id}
                          className={`p-2 rounded-lg ${label.enabled ? 'bg-slate-600' : 'bg-slate-800 opacity-60'}`}
                        >
                          <div className="flex items-center gap-2">
                            <button
                              onClick={() => setDetectedLabels(prev => prev.map(l =>
                                l.id === label.id ? { ...l, enabled: !l.enabled } : l
                              ))}
                              className={`w-5 h-5 rounded flex items-center justify-center ${label.enabled ? 'bg-orange-500' : 'bg-slate-700'}`}
                            >
                              {label.enabled && <Icon name="check" className="w-3 h-3 text-white" />}
                            </button>
                            {editingLabelId === label.id ? (
                              <input
                                type="text"
                                value={label.text}
                                onChange={(e) => setDetectedLabels(prev => prev.map(l =>
                                  l.id === label.id ? { ...l, text: e.target.value } : l
                                ))}
                                onBlur={() => setEditingLabelId(null)}
                                onKeyDown={(e) => e.key === 'Enter' && setEditingLabelId(null)}
                                className="flex-1 bg-slate-700 border border-slate-500 rounded px-2 py-1 text-xs focus:outline-none focus:border-orange-500"
                                autoFocus
                              />
                            ) : (
                              <span
                                className="flex-1 text-xs text-slate-200 cursor-pointer hover:text-orange-400"
                                onClick={() => setEditingLabelId(label.id)}
                                title="Click to edit"
                              >
                                {label.text}
                              </span>
                            )}
                            <button
                              onClick={() => setDetectedLabels(prev => prev.filter(l => l.id !== label.id))}
                              className="p-1 hover:bg-red-500/50 rounded"
                              title="Delete label"
                            >
                              <Icon name="trash-2" className="w-3 h-3 text-slate-400" />
                            </button>
                          </div>
                        </div>
                      ))}
                      {detectedLabels.length === 0 && (
                        <p className="text-xs text-slate-400 text-center py-4">
                          No labels detected. Draw boxes on the image to add labels manually.
                        </p>
                      )}
                    </div>
                    <p className="text-xs text-slate-400 mt-3">
                      Tip: Draw on image to add labels. Click boxes to toggle. Click text to edit.
                    </p>
                  </div>
                </div>
              )}

              {/* Footer Actions */}
              <div className="flex items-center justify-between mt-4 pt-4 border-t border-slate-700">
                <button
                  onClick={() => {
                    if (occlusionStep === 'edit') {
                      setOcclusionStep('select');
                      setSelectedOcclusionImage(null);
                      setDetectedLabels([]);
                    } else {
                      setOcclusionModalOpen(false);
                    }
                  }}
                  className="px-4 py-2 bg-slate-600 hover:bg-slate-500 rounded-lg text-sm"
                >
                  {occlusionStep === 'edit' ? 'Back' : 'Cancel'}
                </button>
                {occlusionStep === 'edit' && (
                  <button
                    onClick={generateOcclusionCards}
                    disabled={occlusionProcessing || detectedLabels.filter(l => l.enabled).length === 0}
                    className="px-4 py-2 bg-orange-600 hover:bg-orange-500 disabled:bg-slate-600 disabled:opacity-50 rounded-lg text-sm flex items-center gap-2"
                  >
                    {occlusionProcessing ? (
                      <>
                        <div className="w-4 h-4 border-2 border-white border-t-transparent rounded-full animate-spin"></div>
                        Generating...
                      </>
                    ) : (
                      <>
                        <Icon name="check" className="w-4 h-4" />
                        Generate {detectedLabels.filter(l => l.enabled).length} Cards
                      </>
                    )}
                  </button>
                )}
              </div>
            </div>
          </div>
        )}

        {/* Occlusion Card Edit Modal */}
        {editingOcclusionCard && (
          <div className="fixed inset-0 bg-black/80 flex items-center justify-center z-50">
            <div className="bg-slate-800 rounded-xl p-6 max-w-4xl w-full mx-4 max-h-[95vh] flex flex-col">
              <div className="flex items-center justify-between mb-4">
                <div>
                  <h3 className="text-lg font-semibold text-slate-200">Edit Occlusion Card</h3>
                  <p className="text-sm text-slate-400 mt-1">Adjust the label position, text, and explanation</p>
                </div>
                <button
                  onClick={() => {
                    setEditingOcclusionCard(null);
                    setEditOcclusionDragging(null);
                    setEditOcclusionResizing(null);
                  }}
                  className="p-2 hover:bg-slate-700 rounded-lg transition-colors"
                >
                  <Icon name="x" className="w-5 h-5" />
                </button>
              </div>

              <div className="flex-1 flex gap-4 min-h-0 overflow-hidden">
                {/* Image with label box */}
                <div className="flex-1 relative bg-slate-900 rounded-lg overflow-hidden flex items-center justify-center">
                  <div
                    className="relative inline-block"
                    onMouseMove={(e) => {
                      const rect = e.currentTarget.getBoundingClientRect();
                      const x = Math.max(0, Math.min(100, ((e.clientX - rect.left) / rect.width) * 100));
                      const y = Math.max(0, Math.min(100, ((e.clientY - rect.top) / rect.height) * 100));

                      if (editOcclusionDragging) {
                        setEditingOcclusionCard(prev => ({
                          ...prev,
                          label: {
                            ...prev.label,
                            x: Math.max(0, Math.min(100 - prev.label.width, x - editOcclusionDragging.offsetX)),
                            y: Math.max(0, Math.min(100 - prev.label.height, y - editOcclusionDragging.offsetY))
                          }
                        }));
                      } else if (editOcclusionResizing) {
                        const orig = editOcclusionResizing.origBox;
                        let newX = orig.x, newY = orig.y, newW = orig.width, newH = orig.height;

                        if (editOcclusionResizing.handle.includes('w')) {
                          newX = Math.min(x, orig.x + orig.width - 2);
                          newW = orig.x + orig.width - newX;
                        }
                        if (editOcclusionResizing.handle.includes('e')) {
                          newW = Math.max(2, x - orig.x);
                        }
                        if (editOcclusionResizing.handle.includes('n')) {
                          newY = Math.min(y, orig.y + orig.height - 2);
                          newH = orig.y + orig.height - newY;
                        }
                        if (editOcclusionResizing.handle.includes('s')) {
                          newH = Math.max(2, y - orig.y);
                        }

                        setEditingOcclusionCard(prev => ({
                          ...prev,
                          label: {
                            ...prev.label,
                            x: Math.max(0, newX),
                            y: Math.max(0, newY),
                            width: Math.min(100, newW),
                            height: Math.min(100, newH)
                          }
                        }));
                      }
                    }}
                    onMouseUp={() => {
                      setEditOcclusionDragging(null);
                      setEditOcclusionResizing(null);
                    }}
                    onMouseLeave={() => {
                      setEditOcclusionDragging(null);
                      setEditOcclusionResizing(null);
                    }}
                  >
                    <img
                      src={editingOcclusionCard.originalImage}
                      alt="Original image"
                      className="max-w-full max-h-[50vh] select-none"
                      draggable={false}
                    />
                    {/* Label box */}
                    <div
                      className="absolute border-2 border-orange-500 bg-orange-500/30"
                      style={{
                        left: `${editingOcclusionCard.label.x}%`,
                        top: `${editingOcclusionCard.label.y}%`,
                        width: `${editingOcclusionCard.label.width}%`,
                        height: `${editingOcclusionCard.label.height}%`,
                        cursor: editOcclusionDragging ? 'grabbing' : 'move'
                      }}
                      onMouseDown={(e) => {
                        e.stopPropagation();
                        const rect = e.currentTarget.parentElement.getBoundingClientRect();
                        const mouseX = ((e.clientX - rect.left) / rect.width) * 100;
                        const mouseY = ((e.clientY - rect.top) / rect.height) * 100;
                        setEditOcclusionDragging({
                          offsetX: mouseX - editingOcclusionCard.label.x,
                          offsetY: mouseY - editingOcclusionCard.label.y
                        });
                      }}
                    >
                      {/* Label text badge */}
                      <span className="absolute -top-5 left-0 text-xs px-1 rounded bg-orange-500 text-white whitespace-nowrap">
                        {editingOcclusionCard.label.text.substring(0, 20)}{editingOcclusionCard.label.text.length > 20 ? '...' : ''}
                      </span>
                      {/* Resize handles */}
                      {['nw', 'ne', 'sw', 'se'].map(handle => (
                        <div
                          key={handle}
                          className={`absolute w-3 h-3 bg-orange-500 border border-white rounded-sm ${
                            handle === 'nw' ? '-top-1.5 -left-1.5 cursor-nwse-resize' :
                            handle === 'ne' ? '-top-1.5 -right-1.5 cursor-nesw-resize' :
                            handle === 'sw' ? '-bottom-1.5 -left-1.5 cursor-nesw-resize' :
                            '-bottom-1.5 -right-1.5 cursor-nwse-resize'
                          }`}
                          onMouseDown={(e) => {
                            e.stopPropagation();
                            setEditOcclusionResizing({
                              handle: handle,
                              origBox: { ...editingOcclusionCard.label }
                            });
                          }}
                        />
                      ))}
                    </div>
                  </div>
                </div>

                {/* Edit fields */}
                <div className="w-72 flex flex-col gap-4 overflow-y-auto">
                  <div>
                    <label className="block text-sm font-medium text-slate-300 mb-2">Label Text (Answer)</label>
                    <input
                      type="text"
                      value={editingOcclusionCard.label.text}
                      onChange={(e) => setEditingOcclusionCard(prev => ({
                        ...prev,
                        label: { ...prev.label, text: e.target.value }
                      }))}
                      className="w-full bg-slate-700 border border-slate-600 rounded-lg px-3 py-2 text-sm focus:outline-none focus:border-orange-500"
                      placeholder="e.g. Mitral Valve"
                    />
                  </div>

                  <div>
                    <label className="block text-sm font-medium text-slate-300 mb-2">Question Text</label>
                    <input
                      type="text"
                      value={editingOcclusionCard.questionText}
                      onChange={(e) => setEditingOcclusionCard(prev => ({
                        ...prev,
                        questionText: e.target.value
                      }))}
                      className="w-full bg-slate-700 border border-slate-600 rounded-lg px-3 py-2 text-sm focus:outline-none focus:border-orange-500"
                      placeholder="e.g. What is the masked structure?"
                    />
                  </div>

                  <div>
                    <label className="block text-sm font-medium text-slate-300 mb-2">Explanation</label>
                    <textarea
                      value={editingOcclusionCard.explanation}
                      onChange={(e) => setEditingOcclusionCard(prev => ({
                        ...prev,
                        explanation: e.target.value
                      }))}
                      rows={4}
                      className="w-full bg-slate-700 border border-slate-600 rounded-lg px-3 py-2 text-sm focus:outline-none focus:border-orange-500 resize-none"
                      placeholder="Brief explanation of the structure..."
                    />
                  </div>

                  <p className="text-xs text-slate-400">
                    Drag the box to reposition. Use corner handles to resize.
                  </p>
                </div>
              </div>

              <div className="flex items-center justify-end gap-3 mt-4 pt-4 border-t border-slate-700">
                <button
                  onClick={() => {
                    setEditingOcclusionCard(null);
                    setEditOcclusionDragging(null);
                    setEditOcclusionResizing(null);
                  }}
                  className="px-4 py-2 bg-slate-600 hover:bg-slate-500 rounded-lg text-sm"
                >
                  Cancel
                </button>
                <button
                  onClick={saveOcclusionCardEdit}
                  className="px-4 py-2 bg-orange-600 hover:bg-orange-500 rounded-lg text-sm flex items-center gap-2"
                >
                  <Icon name="check" className="w-4 h-4" />
                  Save Changes
                </button>
              </div>
            </div>
          </div>
        )}

        {/* Interpretation Card Modal */}
        {interpretationModalOpen && (
          <div className="fixed inset-0 bg-black/80 flex items-center justify-center z-50">
            <div className="bg-slate-800 rounded-xl p-6 max-w-4xl w-full mx-4 max-h-[95vh] flex flex-col">
              {/* Header */}
              <div className="flex items-center justify-between mb-4">
                <div>
                  <h3 className="text-lg font-semibold text-slate-200">
                    {interpretationStep === 'select' && 'Select Image for Interpretation Card'}
                    {interpretationStep === 'generating' && 'Generating Card...'}
                    {interpretationStep === 'confirm' && 'Review & Edit Card'}
                  </h3>
                  <p className="text-sm text-slate-400 mt-1">
                    {interpretationStep === 'select' && 'Choose an image to create an interpretation question'}
                    {interpretationStep === 'generating' && 'AI is analyzing the image and creating a question...'}
                    {interpretationStep === 'confirm' && 'Edit the question and answer before adding to your deck'}
                  </p>
                </div>
                <button
                  onClick={() => {
                    setInterpretationModalOpen(false);
                    setInterpretationStep('select');
                    setSelectedInterpretationImage(null);
                    setInterpretationCard(null);
                  }}
                  className="p-2 hover:bg-slate-700 rounded-lg transition-colors"
                >
                  <Icon name="x" className="w-5 h-5" />
                </button>
              </div>

              {/* Step 1: Image Selection */}
              {interpretationStep === 'select' && (
                <div className="flex-1 overflow-y-auto">
                  <div className="grid grid-cols-2 md:grid-cols-3 gap-4">
                    {getAllNotesImages().map((imgData, idx) => (
                      <button
                        key={idx}
                        onClick={() => {
                          setSelectedInterpretationImage(imgData);
                          generateInterpretationCard();
                        }}
                        className="group relative bg-slate-700 rounded-lg overflow-hidden hover:ring-2 hover:ring-teal-500 transition-all"
                      >
                        <img
                          src={imgData.image.dataUrl}
                          alt={imgData.label}
                          className="w-full h-40 object-contain bg-white"
                        />
                        <div className="absolute bottom-0 left-0 right-0 bg-gradient-to-t from-black/80 to-transparent p-2">
                          <span className="text-xs text-white">Slide {imgData.image.pageNum}</span>
                          <p className="text-xs text-slate-300 truncate">{imgData.label}</p>
                        </div>
                      </button>
                    ))}
                  </div>
                  {getAllNotesImages().length === 0 && (
                    <div className="text-center text-slate-400 py-8">
                      <Icon name="image" className="w-12 h-12 mx-auto mb-2 opacity-50" />
                      <p>No images found in your notes.</p>
                      <p className="text-sm mt-1">Add images to your notes first using the image button next to each bullet point.</p>
                    </div>
                  )}
                </div>
              )}

              {/* Step 2: Generating */}
              {interpretationStep === 'generating' && (
                <div className="flex-1 flex items-center justify-center">
                  <div className="text-center">
                    <div className="w-12 h-12 border-4 border-teal-500 border-t-transparent rounded-full animate-spin mx-auto mb-4"></div>
                    <p className="text-slate-300">Analyzing image and generating question...</p>
                    {selectedInterpretationImage && (
                      <img
                        src={selectedInterpretationImage.image.dataUrl}
                        alt="Selected"
                        className="max-w-xs max-h-40 mx-auto mt-4 rounded-lg border border-slate-600"
                      />
                    )}
                  </div>
                </div>
              )}

              {/* Step 3: Confirm/Edit */}
              {interpretationStep === 'confirm' && interpretationCard && (
                <div className="flex-1 flex gap-4 min-h-0 overflow-hidden">
                  {/* Image preview */}
                  <div className="flex-1 bg-slate-900 rounded-lg overflow-hidden flex items-center justify-center p-4">
                    <img
                      src={interpretationCard.imageDataUrl}
                      alt="Card image"
                      className="max-w-full max-h-[50vh] object-contain"
                    />
                  </div>

                  {/* Edit fields */}
                  <div className="w-80 flex flex-col gap-4">
                    <div>
                      <label className="block text-sm font-medium text-slate-300 mb-2">Question</label>
                      <textarea
                        value={interpretationCard.question}
                        onChange={(e) => setInterpretationCard(prev => ({
                          ...prev,
                          question: e.target.value
                        }))}
                        rows={3}
                        className="w-full bg-slate-700 border border-slate-600 rounded-lg px-3 py-2 text-sm focus:outline-none focus:border-teal-500 resize-none"
                        placeholder="e.g. What abnormality is shown?"
                      />
                    </div>

                    <div>
                      <label className="block text-sm font-medium text-slate-300 mb-2">Answer</label>
                      <textarea
                        value={interpretationCard.answer}
                        onChange={(e) => setInterpretationCard(prev => ({
                          ...prev,
                          answer: e.target.value
                        }))}
                        rows={6}
                        className="w-full bg-slate-700 border border-slate-600 rounded-lg px-3 py-2 text-sm focus:outline-none focus:border-teal-500 resize-none"
                        placeholder="The answer with explanation..."
                      />
                    </div>

                    <p className="text-xs text-slate-400">
                      Review and edit the AI-generated question and answer before adding to your deck.
                    </p>
                  </div>
                </div>
              )}

              {/* Footer Actions */}
              <div className="flex items-center justify-between mt-4 pt-4 border-t border-slate-700">
                <button
                  onClick={() => {
                    if (interpretationStep === 'confirm') {
                      setInterpretationStep('select');
                      setSelectedInterpretationImage(null);
                      setInterpretationCard(null);
                    } else {
                      setInterpretationModalOpen(false);
                    }
                  }}
                  disabled={interpretationProcessing}
                  className="px-4 py-2 bg-slate-600 hover:bg-slate-500 disabled:opacity-50 rounded-lg text-sm"
                >
                  {interpretationStep === 'confirm' ? 'Back' : 'Cancel'}
                </button>
                {interpretationStep === 'confirm' && (
                  <button
                    onClick={addInterpretationCard}
                    className="px-4 py-2 bg-teal-600 hover:bg-teal-500 rounded-lg text-sm flex items-center gap-2"
                  >
                    <Icon name="plus" className="w-4 h-4" />
                    Add Card
                  </button>
                )}
              </div>
            </div>
          </div>
        )}

        {/* Interpretation Card Edit Modal */}
        {editingInterpretationCard && (
          <div className="fixed inset-0 bg-black/80 flex items-center justify-center z-50">
            <div className="bg-slate-800 rounded-xl p-6 max-w-4xl w-full mx-4 max-h-[95vh] flex flex-col">
              <div className="flex items-center justify-between mb-4">
                <div>
                  <h3 className="text-lg font-semibold text-slate-200">Edit Interpretation Card</h3>
                  <p className="text-sm text-slate-400 mt-1">Modify the question and answer</p>
                </div>
                <button
                  onClick={() => setEditingInterpretationCard(null)}
                  className="p-2 hover:bg-slate-700 rounded-lg transition-colors"
                >
                  <Icon name="x" className="w-5 h-5" />
                </button>
              </div>

              <div className="flex-1 flex gap-4 min-h-0 overflow-hidden">
                {/* Image preview */}
                <div className="flex-1 bg-slate-900 rounded-lg overflow-hidden flex items-center justify-center p-4">
                  <img
                    src={editingInterpretationCard.imageDataUrl}
                    alt="Card image"
                    className="max-w-full max-h-[50vh] object-contain"
                  />
                </div>

                {/* Edit fields */}
                <div className="w-80 flex flex-col gap-4">
                  <div>
                    <label className="block text-sm font-medium text-slate-300 mb-2">Question</label>
                    <textarea
                      value={editingInterpretationCard.question}
                      onChange={(e) => setEditingInterpretationCard(prev => ({
                        ...prev,
                        question: e.target.value
                      }))}
                      rows={3}
                      className="w-full bg-slate-700 border border-slate-600 rounded-lg px-3 py-2 text-sm focus:outline-none focus:border-teal-500 resize-none"
                      placeholder="e.g. What abnormality is shown?"
                    />
                  </div>

                  <div>
                    <label className="block text-sm font-medium text-slate-300 mb-2">Answer</label>
                    <textarea
                      value={editingInterpretationCard.answer}
                      onChange={(e) => setEditingInterpretationCard(prev => ({
                        ...prev,
                        answer: e.target.value
                      }))}
                      rows={6}
                      className="w-full bg-slate-700 border border-slate-600 rounded-lg px-3 py-2 text-sm focus:outline-none focus:border-teal-500 resize-none"
                      placeholder="The answer with explanation..."
                    />
                  </div>
                </div>
              </div>

              <div className="flex items-center justify-end gap-3 mt-4 pt-4 border-t border-slate-700">
                <button
                  onClick={() => setEditingInterpretationCard(null)}
                  className="px-4 py-2 bg-slate-600 hover:bg-slate-500 rounded-lg text-sm"
                >
                  Cancel
                </button>
                <button
                  onClick={() => {
                    const { index, question, answer, imageDataUrl } = editingInterpretationCard;
                    const updated = [...cards];
                    updated[index] = {
                      ...updated[index],
                      front: `<img src="${imageDataUrl}" style="max-width:400px;"><br><br>${question}`,
                      back: answer,
                      interpretationData: { imageDataUrl, question, answer }
                    };
                    setCards(updated);
                    setEditingInterpretationCard(null);
                  }}
                  className="px-4 py-2 bg-teal-600 hover:bg-teal-500 rounded-lg text-sm flex items-center gap-2"
                >
                  <Icon name="check" className="w-4 h-4" />
                  Save Changes
                </button>
              </div>
            </div>
          </div>
        )}

        {/* CSV Import Modal */}
        {showCsvImportModal && (
          <div className="fixed inset-0 bg-black/50 flex items-center justify-center z-50">
            <div className="bg-slate-800 rounded-xl p-6 max-w-md w-full mx-4 space-y-4">
              <div className="text-center space-y-2">
                <Icon name="upload" className="w-12 h-12 mx-auto text-purple-400" />
                <h3 className="text-lg font-semibold text-slate-200">Import Flashcards</h3>
                <p className="text-sm text-slate-400">Set the module and lecture for imported cards</p>
              </div>

              <div className="space-y-3">
                <div>
                  <label className="block text-sm font-medium text-slate-300 mb-2">Select Module</label>
                  <select
                    value={csvImportModule}
                    onChange={(e) => setCsvImportModule(e.target.value)}
                    className="w-full bg-slate-700 border border-slate-600 rounded-lg px-3 py-2 text-sm focus:outline-none focus:border-purple-500"
                  >
                    <option value="">-- Select Module --</option>
                    {modules.map(m => (
                      <option key={m.abbrev} value={m.abbrev}>{m.name} ({m.abbrev})</option>
                    ))}
                  </select>
                </div>

                <div>
                  <label className="block text-sm font-medium text-slate-300 mb-2">Lecture Title</label>
                  <input
                    type="text"
                    value={csvImportLectureTitle}
                    onChange={(e) => setCsvImportLectureTitle(e.target.value)}
                    placeholder="e.g. Complications Of Labour"
                    className="w-full bg-slate-700 border border-slate-600 rounded-lg px-3 py-2 text-sm focus:outline-none focus:border-purple-500"
                  />
                </div>

                <div className="border-t border-slate-600 pt-3 mt-3">
                  <label className="block text-sm font-medium text-slate-300 mb-2">Or enter custom tag</label>
                  <input
                    type="text"
                    value={csvImportCustomTag}
                    onChange={(e) => setCsvImportCustomTag(e.target.value)}
                    placeholder="e.g. Day2 HD2_ComplicationsOfLabour"
                    className="w-full bg-slate-700 border border-slate-600 rounded-lg px-3 py-2 text-sm focus:outline-none focus:border-purple-500"
                  />
                  <p className="text-xs text-slate-500 mt-1">Custom tag overrides module/lecture selection</p>
                </div>

                {(csvImportCustomTag || (csvImportModule && csvImportLectureTitle)) && (
                  <p className="text-xs text-slate-400">
                    Tag preview: {csvImportCustomTag.trim() || `Day2 ${csvImportModule}_${csvImportLectureTitle.split(/[\s_\-\.]+/).filter(w => w).map(w => w.charAt(0).toUpperCase() + w.slice(1)).join('')}`}
                  </p>
                )}
              </div>

              <div className="flex gap-3 pt-2">
                <button
                  onClick={() => { setShowCsvImportModal(false); setPendingCsvFile(null); }}
                  className="flex-1 px-4 py-2 bg-slate-600 hover:bg-slate-500 rounded-lg text-sm"
                >
                  Cancel
                </button>
                <button
                  onClick={processCsvImport}
                  className="flex-1 px-4 py-2 bg-purple-600 hover:bg-purple-500 rounded-lg text-sm flex items-center justify-center gap-2"
                >
                  <Icon name="upload" className="w-4 h-4" />Import
                </button>
              </div>
            </div>
          </div>
        )}
      </>
      );
    }

    ReactDOM.createRoot(document.getElementById('root')).render(<ErrorBoundary><App /></ErrorBoundary>);
  </script>
</body>
</html>
